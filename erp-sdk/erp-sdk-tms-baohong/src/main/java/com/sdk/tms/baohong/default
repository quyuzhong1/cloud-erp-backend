    font-size: 14px;
    line-height: 1.6;
    background: #0150b2 url(/images/hgt-background.png) center top no-repeat;
    padding-bottom: 86px;
}

* {
    outline: none;
}

.header {
    width: 1200px;
    height: 60px;
    margin: 50px auto 100px auto;
    background: url(/images/hgt-logo.png) left center no-repeat;
}

.container {
    position: relative;
    width: 1200px;
    height: 450px;
    margin: 0 auto;
}

.left-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 710px;
    height: 400px;
    background: url(/images/hgt-slogan.png) left center no-repeat;
}

.right-container {
    position: absolute;
    top: 0;
    right: 0;
    padding: 40px 40px;
    background: #ffffff;
    border-radius: 4px;
}

.input-title {
    width: 100%;
    color: #333333;
    text-align: left;
    padding-bottom: 5px;
}

.input-container {
    width: 100%;
    position: relative;
}

.input-container input {
    width: 280px;
    height: 20px;
    line-height: 20px;
    font-family: "Microsoft YaHei", "微软雅黑", tahoma, sans-serif;
    font-size: 14px;
    border: 1px solid #cccccc;
    border-radius: 2px;
    padding: 10px 10px 10px 40px;
}

.input-container .icon {
    border: 0;
    position: absolute;
    top: 10px;
