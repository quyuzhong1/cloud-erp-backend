<?xml version="1.0" encoding="UTF-8"?>
<!-- 此处的debug指是否打印logback内部日志信息 -->
<configuration debug="false" scan="true" scanPeriod="60 seconds">
	<contextName>${APP_NAME}</contextName>
	<!-- 获取yml中的 应用名称 -->
	<springProperty name="APP_NAME" scope="context" source="spring.application.name"/>
	<!-- 获取服务器ip -->
	<springProperty name="ServerIP" scope="context" source="spring.cloud.client.ip-address" defaultValue="0.0.0.0"/>
	<!-- 获取端口号 -->
	<springProperty name="ServerPort" scope="context" source="server.port" defaultValue="0000"/>

	<!-- 获取yml中的 应用名称 -->
	<!--	<springProperty scope="context" name="APP_NAME" source="spring.application.name"/>-->
	<!--日志文件的保存路径 -->
	<property name="LOG_HOME" value="/logs/${APP_NAME}"/>
	<!-- 彩色日志 -->
	<!-- 彩色日志依赖的渲染类 -->
	<conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
	<conversionRule conversionWord="wex"
					converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
	<conversionRule conversionWord="wEx"
					converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

	<property name="ENCODER_PATTERN_COLOR"
			  value="[${APP_NAME}:${ServerIP}:${ServerPort}] [%clr(%X{traceId}){yellow},%clr(%X{spanId}){yellow}] %clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%level){blue} %clr(${PID}){magenta} %clr([%thread]){orange} %clr(%logger){cyan} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
	<property name="ENCODER_PATTERN"
			  value="[${APP_NAME}:${ServerIP}:${ServerPort}] [%X{traceId},%X{spanId}] %d{yyyy-MM-dd HH:mm:ss.SSS} %level ${PID} [%thread] %logger %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
	<!-- 超过最大天数会清理日志 -->
	<property name="maxHistory" value="10"/>
	<!-- 文件达到 最大xxMB时会被切割 -->
	<property name="maxFileSize" value="500MB"/>
	<!-- 超过总容量 会自动清理日志 -->
	<property name="totalSizeCap" value="20GB"/>
	<!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
	<property name="queueSize" value="512"/>

	<!-- 控制台日志：输出全部日志到控制台 -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<withJansi>true</withJansi>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${ENCODER_PATTERN_COLOR}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>
	<appender name="FILE_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>DEBUG</level>
		</filter>
		<file>${LOG_HOME}/debug.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/debug-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${maxFileSize}</maxFileSize>
			<maxHistory>${maxHistory}</maxHistory>
			<totalSizeCap>${totalSizeCap}</totalSizeCap>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${ENCODER_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>
	<appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>INFO</level>
		</filter>
		<file>${LOG_HOME}/info.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${maxFileSize}</maxFileSize>
			<maxHistory>${maxHistory}</maxHistory>
			<totalSizeCap>${totalSizeCap}</totalSizeCap>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${ENCODER_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>
	<appender name="FILE_WARN" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>WARN</level>
		</filter>
		<file>${LOG_HOME}/warn.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/warn-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${maxFileSize}</maxFileSize>
			<maxHistory>${maxHistory}</maxHistory>
			<totalSizeCap>${totalSizeCap}</totalSizeCap>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${ENCODER_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>
	<appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
		<file>${LOG_HOME}/error.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxFileSize>${maxFileSize}</maxFileSize>
			<maxHistory>${maxHistory}</maxHistory>
			<totalSizeCap>${totalSizeCap}</totalSizeCap>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${ENCODER_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- 定义异步输出日志 -->
	<appender name="ASYNC_LOG_DEBUG" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="FILE_DEBUG"/>
		<!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
		<discardingThreshold>0</discardingThreshold>
		<!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
		<queueSize>${queueSize}</queueSize>
	</appender>
	<appender name="ASYNC_LOG_INFO" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="FILE_INFO"/>
		<!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
		<discardingThreshold>0</discardingThreshold>
		<!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
		<queueSize>${queueSize}</queueSize>
	</appender>
	<appender name="ASYNC_LOG_WARN" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="FILE_WARN"/>
		<!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
		<discardingThreshold>0</discardingThreshold>
		<!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
		<queueSize>${queueSize}</queueSize>
	</appender>
	<appender name="ASYNC_LOG_ERROR" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="FILE_ERROR"/>
		<!-- 不丢失日志.默认的,如果队列的80%已满,则会丢弃TRACT、DEBUG、INFO级别的日志 -->
		<discardingThreshold>0</discardingThreshold>
		<!-- 更改默认的队列的深度,该值会影响性能.默认值为256 -->
		<queueSize>${queueSize}</queueSize>
	</appender>

	<!--TRACE, DEBUG, INFO, WARN, ERROR, ALL and OFF -->
	<!-- spring配置文件值：spring.profiles.active=dev -->

	<springProfile name="dev">
		<root level="ERROR">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_LOG_DEBUG"/>
		</root>
	</springProfile>
	<springProfile name="test">
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_LOG_DEBUG" />
		</root>
	</springProfile>
	<springProfile name="uat">
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_LOG_INFO" />
		</root>
	</springProfile>
	<springProfile name="prod">
		<root level="WARN">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="ASYNC_LOG_WARN" />
		</root>
	</springProfile>

	<!-- 显式禁止第三方库的日志级别 -->
	<logger name="com.erp.server.wms.config.SpringAsyncConfig" level="INFO"/>
	<logger name="com.baomidou" level="INFO"/>
	<logger name="com.netflix" level="INFO"/>
	<logger name="com.zaxxer.hikari" level="INFO"/>
	<logger name="org.springframework" level="INFO"/>
	<logger name="org.hibernate" level="INFO"/>
	<logger name="org.apache" level="INFO"/>
	<logger name="org.redisson" level="INFO"/>
	<logger name="io.netty" level="INFO"/>
	<logger name="io.seata" level="INFO"/>
	<logger name="io.lettuce" level="INFO"/>
</configuration>
