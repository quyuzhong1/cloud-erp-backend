<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.DictRuleConditionMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.DictRuleConditionEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="key" property="key" />
       <result column="value" property="value" />
       <result column="remark" property="remark" />
       <result column="type" property="type" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        key, value, remark, type
    </sql>
    <select id="listByType" resultType="com.common.business.dto.base.BaseDropDownDTO$CommonDTO">
        SELECT
            key AS code,
            value
        FROM dict_rule_condition
        WHERE is_deleted=FALSE
        AND type=#{type}
    </select>
    <select id="listRuleField" resultType="com.common.business.dto.base.BaseDropDownDTO$CommonDTO">
        SELECT
            condition_field AS code,
            condition_field_name AS value
        FROM cfg_condition
        WHERE is_deleted=FALSE
    </select>


</mapper>
