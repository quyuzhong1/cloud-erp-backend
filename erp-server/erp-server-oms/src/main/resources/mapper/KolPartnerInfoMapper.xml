<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.KolPartnerInfoMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.KolPartnerInfoEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />
       <result column="code" property="code" />
       <result column="nickname" property="nickname" />
       <result column="type" property="type" />
       <result column="cooperation_type" property="cooperationType" />
       <result column="cooperation_date" property="cooperationDate" />
       <result column="country_id" property="countryId" />
       <result column="country_name" property="countryName" />
       <result column="language" property="language" />
       <result column="email" property="email" />
       <result column="phone" property="phone" />
       <result column="charge_id" property="chargeId" />
       <result column="charge_name" property="chargeName" />
       <result column="dept_id" property="deptId" />
       <result column="dept_name" property="deptName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        disabled, remark, code, nickname, type, cooperation_type, cooperation_date, country_id, country_name, language, email, phone, charge_id, charge_name, dept_id, dept_name
    </sql>

    <select id="paging" resultType="com.erp.model.oms.dto.KolPartnerInfoDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from kol_partner_info where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.oms.dto.KolPartnerInfoDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.oms.dto.KolPartnerInfoDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  kol_partner_info
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
