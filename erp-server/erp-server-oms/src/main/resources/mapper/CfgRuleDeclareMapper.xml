<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.CfgRuleDeclareMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.CfgRuleDeclareEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />
       <result column="declare_cn" property="declareCn" />
       <result column="declare_en" property="declareEn" />
       <result column="to_customs_code" property="toCustomsCode" />
       <result column="priority" property="priority" />
       <result column="to_declare_price" property="toDeclarePrice" />
       <result column="to_currency" property="toCurrency" />
       <result column="to_currency_symbol" property="toCurrencySymbol" />
       <result column="to_declare_price_type" property="toDeclarePriceType" />
       <result column="rate" property="rate" />
       <result column="max_declare_price" property="maxDeclarePrice" />
       <result column="min_declare_price" property="minDeclarePrice" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, disabled, remark, declare_cn, declare_en, to_customs_code, priority, to_declare_price, to_currency, to_currency_symbol, to_declare_price_type, rate, max_declare_price, min_declare_price
    </sql>

    <select id="paging" resultType="com.erp.model.oms.dto.CfgRuleDeclareDTO$PagingViewDTO">
        SELECT
        id,
        name,
        priority,
        disabled,
        remark,
        create_user_name as createUserName,
        create_time as createTime,
        update_user_name as updateUserName,
        update_time as updateTime
        FROM cfg_rule_declare cd
        WHERE ${params.sqlMap.default}
        and cd.is_deleted=FALSE
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        cd.id desc
    </select>


</mapper>
