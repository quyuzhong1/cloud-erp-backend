<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.SoB2cErrorMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.SoB2cErrorEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="main_id" property="mainId" />
       <result column="type" property="type" />
       <result column="param_json" property="paramJson" />
       <result column="message" property="message" />
       <result column="return_json" property="returnJson"  />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        main_id, type, param_json, message, return_json
    </sql>
    <delete id="deleteB2cError">
        DELETE FROM so_b2c_error WHERE main_id=#{params.mainId}
            <if test="params.type != null and params.type != ''">
                and type = #{params.type}
            </if>
            and detail_id = ''
    </delete>
    <delete id="deleteByCodeAndType">
        DELETE FROM so_b2c_error
        WHERE main_id=(select id from so_b2c where code = #{code} and is_deleted=false limit 1)
                                       and  type = #{type}

    </delete>
    <delete id="batchDeleteB2cError">
        DELETE FROM so_b2c_error WHERE type = #{params.type}
        and main_id in
        <foreach collection="params.mainIds" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>

    <delete id="deleteB2cErrorByDetailId">
        DELETE FROM so_b2c_error WHERE main_id=#{params.mainId} and  type = #{params.type}
        and detail_id in
        <foreach collection="params.detailIdList" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>

    <!-- 根据主表ids删除 -->
    <delete id="deleteByMainIds">
        DELETE FROM so_b2c_error WHERE
        main_id in
        <foreach collection="mainIds" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>
</mapper>
