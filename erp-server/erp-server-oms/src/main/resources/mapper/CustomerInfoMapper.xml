<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.CustomerInfoMapper">


    <select id="paging" resultType="com.erp.model.oms.dto.CustomerDTO$PagingViewDTO">
        SELECT
        id,code,approve_status,
        seller_name,
        approve_user_name,
        name,short_name,disabled,
        use_org_name,group_id,group_name,
        create_user_name,create_time
        FROM customer_info ci
        WHERE ci.is_deleted=FALSE
        <if test="params.code !=null and params.code!=''">
            AND ci.code ILIKE concat('%', #{params.code} ,'%')
        </if>
        <if test="params.name !=null and params.name!=''">
            AND ci.name ILIKE concat('%', #{params.name} ,'%')
        </if>
        <if test="params.shortName !=null and params.shortName!=''">
            AND ci.short_name ILIKE concat('%', #{params.shortName} ,'%')
        </if>
        <if test="params.approveStatusList !=null and params.approveStatusList.size>0">
            AND ci.approve_status IN
            <foreach collection="params.approveStatusList" item="approveStatus" open="(" separator="," close=")">
                #{approveStatus}
            </foreach>
        </if>
        <if test="params.sellerIdList !=null and params.sellerIdList.size>0">
            AND ci.seller_id IN
            <foreach collection="params.sellerIdList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="params.customerIdList !=null and params.customerIdList.size>0">
            AND ci.id IN
            <foreach collection="params.customerIdList" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>

        <if test="params.useOrgIdList !=null and params.useOrgIdList.size>0">
            AND ci.use_org_id IN
            <foreach collection="params.useOrgIdList" item="useOrgId" open="(" separator="," close=")">
                #{useOrgId}
            </foreach>
        </if>
        <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
            AND ci.create_user_id IN
            <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                #{createUserId}
            </foreach>
        </if>
        <if test="params.createTimeList !=null and params.createTimeList.size>0">
            AND ci.create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > ci.create_time
        </if>
        <if test="approveList !=null and approveList.size>0">
            AND ci.approve_status IN
            <foreach collection="approveList" item="approve" open="(" separator="," close=")">
                #{approve}
            </foreach>
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY ci.create_time DESC
    </select>

    <select id="listExport" resultType="com.erp.model.oms.dto.CustomerDTO$PagingViewDTO">
        SELECT
        id,code,approve_status,
        seller_name,
        approve_user_name,
        name,short_name,disabled,
        use_org_name,group_id,group_name,
        create_user_name,create_time
        FROM customer_info ci
        WHERE ci.is_deleted=FALSE
        <choose>
            <when test="params.ids!=null and params.ids.size>0 ">
                AND id IN
                <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                <if test="params.code !=null and params.code!=''">
                    AND ci.code ILIKE concat('%', #{params.code} ,'%')
                </if>
                <if test="params.name !=null and params.name!=''">
                    AND ci.name ILIKE concat('%', #{params.name} ,'%')
                </if>
                <if test="params.shortName !=null and params.shortName!=''">
                    AND ci.short_name ILIKE concat('%', #{params.shortName} ,'%')
                </if>
                <if test="params.customerIdList !=null and params.customerIdList.size>0">
                    AND ci.id IN
                    <foreach collection="params.customerIdList" item="id" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </if>
                <if test="params.sellerIdList !=null and params.sellerIdList.size>0">
                    AND ci.seller_id IN
                    <foreach collection="params.sellerIdList" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="params.approveStatusList !=null and params.approveStatusList.size>0">
                    AND ci.approve_status IN
                    <foreach collection="params.approveStatusList" item="approveStatus" open="(" separator=","
                             close=")">
                        #{approveStatus}
                    </foreach>
                </if>
                <if test="params.useOrgIdList !=null and params.useOrgIdList.size>0">
                    AND ci.use_org_id IN
                    <foreach collection="params.useOrgIdList" item="useOrgId" open="(" separator="," close=")">
                        #{useOrgId}
                    </foreach>
                </if>
                <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
                    AND ci.create_user_id IN
                    <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                        #{createUserId}
                    </foreach>
                </if>
                <if test="params.createTimeList !=null and params.createTimeList.size>0">
                    AND ci.create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP +
                    INTERVAL '1
                    DAY' ) > ci.create_time
                </if>
                <if test="approveList !=null and approveList.size>0">
                    AND ci.approve_status IN
                    <foreach collection="approveList" item="approve" open="(" separator="," close=")">
                        #{approve}
                    </foreach>
                </if>
            </otherwise>
        </choose>

        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY ci.create_time DESC
    </select>
    <select id="listApproveCount" resultType="com.erp.model.oms.dto.CustomerDTO$ApproveCountDTO">
         SELECT
            approve_status,
	        count(*)
	     FROM   customer_info ci
	     WHERE is_deleted=FALSE
	     <if test="permissionSql!=null and permissionSql!=''">
             ${permissionSql}
         </if>
         GROUP BY approve_status
    </select>

    <select id="listCustomerByGroup" resultType="com.erp.model.oms.vo.CustomerInfoVO">
        select id,"name", code,group_id,group_name
        from customer_info ci
        where ci.is_deleted = FALSE and group_id != '' ORDER BY group_name
    </select>

    <select id="listCustomerByProperty" resultType="com.erp.model.oms.vo.CustomerInfoVO">
        select id,"name", code,customer_property
        from customer_info ci
        where ci.is_deleted = FALSE and customer_property != ''
    </select>


</mapper>
