<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.RuleOrderApprovalMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.RuleOrderApprovalEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="priority" property="priority" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />
       <result column="category_detail_id" property="categoryDetailId" />
       <result column="operation_type" property="operationType" />
       <result column="flow_status" property="flowStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, priority, disabled, remark, category_detail_id, operation_type, flow_status
    </sql>
    <select id="paging" resultType="com.erp.model.oms.dto.RuleOrderApprovalDTO$PagingViewDTO">
        SELECT
        id,
        name,
        priority,
        disabled,
        remark,
        category_detail_id,
        operation_type,
        flow_status,
        create_user_name,
        create_time,
        update_user_name,
        update_time
        FROM rule_order_approval roa
        WHERE roa.is_deleted=FALSE
        <if test="params.name !=null and params.name!=''">
           AND name ILIKE concat('%', #{params.name} ,'%')
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY roa.update_time DESC
    </select>


</mapper>
