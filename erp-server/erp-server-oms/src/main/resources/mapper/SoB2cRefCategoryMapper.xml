<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.SoB2cRefCategoryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.SoB2cRefCategoryEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="so_b2c_id" property="soB2cId" />
       <result column="category_id" property="categoryId" />
       <result column="category_name" property="categoryName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        so_b2c_id, category_id, category_name
    </sql>
    <select id="listCategoryNamesBySoIds" resultType="com.erp.model.oms.dto.SoB2cRefCategoryDTO$CategoryNamesDTO">
        SELECT
            so_b2c_id as soB2cId,
            array_to_string( ARRAY_AGG ( category_name ), ',' ) AS categoryNames
        FROM
            so_b2c_ref_category
        WHERE
            is_deleted = FALSE
        <if test="soIds != null and soIds.size > 0">
            and so_b2c_id in
            <foreach collection="soIds" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        GROUP BY
            so_b2c_id
    </select>


</mapper>
