<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.BankAccountMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.BankAccountEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="bank_account_no" property="bankAccountNo" />
       <result column="account_name" property="accountName" />
       <result column="bank_type" property="bankType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        bank_account_no, account_name, bank_type
    </sql>
    <!--分页获取数据-->
    <select id="paging" resultType="com.erp.model.oms.dto.BankAccountDTO$PagingViewDTO">
          SELECT
             id,
             bank_account_no AS bankAccountNo,
             account_name AS accountName,
             org_id AS orgId,
             org_name AS orgName,
             disabled
          FROM bank_account
          WHERE is_deleted = false
          ORDER BY
            <if test="params.sortList != null and params.sortList.size > 0">
                <foreach collection="params.sortList" item="item" separator="," close=",">
                    ${item.field} ${item.sort}
                </foreach>
            </if>
          id DESC
    </select>


</mapper>
