<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.ShopInfoMapper">



    <!--店铺分页查询-->
    <select id="paging" resultType="com.erp.model.oms.dto.ShopDTO$PagingViewDTO">
        SELECT
            account
        FROM shop_info si
        WHERE si.is_deleted=FALSE
        <if test="params.name!=null and params.name!='' ">
           AND si.name ILIKE concat('%',#{params.name},'%')
        </if>
        <if test="params.dictPlatform!=null and params.dictPlatform!='' ">
            AND si.dict_platform =#{params.dictPlatform}
        </if>
        <if test="params.account!=null and params.account!='' ">
            AND si.account ILIKE concat('%',#{params.account},'%')
        </if>
        <if test="params.dictCountryId!=null and params.dictCountryId!='' ">
            AND si.dict_country_id = #{params.dictCountryId}
        </if>
        <if test="params.disabledList!=null and params.disabledList.size>0 ">
            AND si.disabled IN
            <foreach collection="params.disabledList" item="disabled" open="(" separator="," close=")">
                 #{disabled}
            </foreach>
        </if>
        <if test="params.authStatusList!=null and params.authStatusList.size>0 ">
            AND si.auth_status IN
            <foreach collection="params.authStatusList" item="authStatus" open="(" separator="," close=")">
                #{authStatus}
            </foreach>
        </if>
        <if test="params.createUserIdList!=null and params.createUserIdList.size>0 ">
            AND si.create_user_id IN
            <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                #{createUserId}
            </foreach>
        </if>
        <if test="params.updateUserIdList!=null and params.updateUserIdList.size>0 ">
            AND si.update_user_id IN
            <foreach collection="params.updateUserIdList" item="updateUserId" open="(" separator="," close=")">
                #{createUserId}
            </foreach>
        </if>
        <if test="params.createTimeList !=null and params.createTimeList.size>0">
            AND si.create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > si.create_time
        </if>
        <if test="params.updateTimeList !=null and params.updateTimeList.size>0">
            AND si.update_time >= #{params.updateTimeList[0]} and (#{params.updateTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > si.update_time
        </if>
        <if test="params.authTimeList !=null and params.authTimeList.size>0">
            AND si.auth_time >= #{params.authTimeList[0]} and (#{params.authTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > si.auth_time
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        GROUP BY account

    </select>

</mapper>
