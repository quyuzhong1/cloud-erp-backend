<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.CfgRuleInvoiceProductAmountMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.CfgRuleInvoiceProductAmountEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />
       <result column="priority" property="priority" />
       <result column="cfg_id" property="cfgId" />
       <result column="dict_invoice_rule" property="dictInvoiceRule" />
       <result column="ratio" property="ratio" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, disabled, remark, priority, cfg_id, dict_invoice_rule, ratio
    </sql>
    <select id="listByCfgId" resultType="com.erp.model.oms.dto.CfgRuleInvoiceProductAmountDTO$ViewDTO">
        select <include refid="Base_Column_List"/>
        from cfg_rule_invoice_product_amount
        where cfg_id = #{cfgId} and is_deleted = false
        order by priority asc
    </select>


</mapper>
