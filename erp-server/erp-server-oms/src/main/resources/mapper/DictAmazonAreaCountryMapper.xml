<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.DictAmazonAreaCountryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.DictAmazonAreaCountryEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="region_code" property="regionCode" />
       <result column="region_name" property="regionName" />
       <result column="country_code" property="countryCode" />
       <result column="country_name" property="countryName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        region_code, region_name, country_code, country_name
    </sql>
    <select id="areaList" resultType="com.common.business.dto.base.BaseDropDownDTO$CommonDTO">
        SELECT
            region_code AS code,
            region_name AS value
        FROM
            dict_amazon_area_country
        GROUP BY
            region_code,
            region_name
    </select>
    <select id="listCountryByArea" resultType="com.common.business.dto.base.BaseDropDownDTO$CommonDTO">
        SELECT
            country_code AS code,
            country_name AS value
        FROM
            dict_amazon_area_country
        WHERE is_deleted=FALSE
        <if test="areaList!=null and areaList.size>0">
            AND
            region_code IN
           <foreach collection="areaList" item="area" open="(" separator="," close=")">
                #{area}
           </foreach>
        </if>
    </select>


</mapper>
