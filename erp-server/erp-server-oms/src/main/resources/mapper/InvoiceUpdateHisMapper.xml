<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.InvoiceUpdateHisMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.InvoiceUpdateHisEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="invoice_info_id" property="invoiceInfoId" />
       <result column="content" property="content" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        invoice_info_id, content
    </sql>

    <!-- 根据发票id查询数量  -->
    <select id="countByInvoiceInfoId" resultType="java.lang.Integer">
        select
            count(0)
        from invoice_update_his iuh
        where iuh.is_deleted = false and iuh.invoice_info_id = #{invoiceInfoId}
    </select>

    <!-- 列表查询 -->
    <select id="list" resultType="com.erp.model.oms.dto.InvoiceUpdateHisDTO$ListDTO">
        select
            ROW_NUMBER() OVER (ORDER BY id) as no,
            <include refid="Base_Column_List" />
        from invoice_update_his iuh
        where iuh.is_deleted = false and iuh.invoice_info_id = #{params.id}
    </select>


</mapper>
