<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.RuleLogisticsMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.RuleLogisticsEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="priority" property="priority" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />

       <result column="mode" property="mode" />
       <result column="auto_get_track_no" property="autoGetTrackNo" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, priority, disabled, remark, type, logistics_supplier, mode, auto_get_track_no
    </sql>
    <select id="paging" resultType="com.erp.model.oms.dto.RuleLogisticsDTO$PagingViewDTO">
        SELECT
        id,
        name,
        priority,
        disabled,
        remark,
        supplier,
        mode_type,
        mode,
        auto_get_track_no,
        create_user_name,
        create_time,
        update_user_name,
        update_time
        FROM rule_logistics rl
        WHERE rl.is_deleted=FALSE
        <if test="params.name !=null and params.name!=''">
            AND name ILIKE concat('%', #{params.name} ,'%')
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY rl.update_time DESC
    </select>


</mapper>
