<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.OrderCategoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.OrderCategoryEntity">
        <result column="id" property="id"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="group_name" property="groupName"/>
        <result column="remark" property="remark"/>
        <result column="disabled" property="disabled"/>
    </resultMap>

    <select id="paging" resultType="com.erp.model.oms.dto.OrderCategoryDTO$PagingViewDTO">
        SELECT
        id,
        create_user_name,
        create_time,
        update_user_name,
        update_time,
        group_name,
        remark,
        disabled
        FROM order_category oc
        WHERE  ${params.sqlMap.default}
        and oc.is_deleted=FALSE
    </select>
    <select id="listDetail" resultType="com.erp.model.oms.dto.OrderCategoryDTO$ListDTO">
        SELECT
            oc.id,
            oc.group_name,
            oc.disabled,
            ocd.id AS  detailId,
            ocd.name AS detailName
        FROM  order_category oc
        LEFT JOIN order_category_detail ocd
        ON oc.id=ocd.main_id and ocd.is_deleted=false
        WHERE oc.is_deleted=false

    </select>

</mapper>
