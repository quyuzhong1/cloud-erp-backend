<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.SkuMappingRuleMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.SkuMappingRuleEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="priority" property="priority" />
       <result column="rule_type" property="ruleType" />
       <result column="rule_regex" property="ruleRegex" />
       <result column="extend_rule_type" property="extendRuleType" />
       <result column="extend_rule_regex" property="extendRuleRegex" />
       <result column="disabled" property="disabled" />
       <result column="rule_content" property="ruleContent" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler" />
       <result column="extend_rule_content" property="extendRuleContent" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        priority, rule_type, rule_regex, extend_rule_type, extend_rule_regex, disabled, rule_content, extend_rule_content
    </sql>
    <select id="paging" resultType="com.erp.model.oms.dto.SkuMappingRuleDTO$ListDTO">
        select
            id as id,
            priority as priority,
            rule_name as ruleName,
            rule_type as ruleType,
            disabled as disabled,
            update_user_name as updateUserName,
            update_time as updateTime
            from sku_mapping_rule
        where
            ${params.sqlMap.default}
        and is_deleted = false
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        priority ASC ,update_time DESC
    </select>


</mapper>
