<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.DictBasicMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.DictBasicEntity">
        <result column="id" property="id" />
        <result column="create_user_id" property="createUserId" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_time" property="createTime" />
        <result column="update_user_id" property="updateUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_time" property="updateTime" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="remark" property="remark" />
        <result column="value" property="value" />
        <result column="type" property="type" />
        <result column="name" property="name" />
        <result column="status" property="status" />
        <result column="sort" property="sort" />
    </resultMap>

    <select id="paging" resultType="com.erp.model.oms.dto.DictBasicDTO$ViewDTO">
        SELECT
            db.id,
            db.create_user_id as createUserId,
            db.create_user_name as createUserName,
            db.create_time as createTime,
            db.update_user_id as updateUserId,
            db.update_user_name as updateUserName,
            db.update_time as updateTime,
            db.version,
            db.is_deleted as isDeleted,
            db.remark,
            db.value,
            db.type,
            db.name,
            db.status,
            db.sort,
            db.type_name as typeName,
            db.sub_type as subType
        FROM dict_basic db
        WHERE  ${params.sqlMap.default}
          and db.is_deleted=FALSE
    </select>

</mapper>
