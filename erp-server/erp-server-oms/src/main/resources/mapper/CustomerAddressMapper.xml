<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.CustomerAddressMapper">


    <select id="listByCustomerName" resultType="com.erp.model.oms.entity.CustomerAddressEntity">
        SELECT ca.*
        FROM
        customer_address ca
        LEFT JOIN customer_info ci
        ON ca.main_id = ci.id AND ci.is_deleted = false
        WHERE ci.name
        LIKE CONCAT('%', #{customerName}::text, '%')
        ORDER BY ca.is_default DESC
    </select>

    <select id="listAllByMainIds" resultType="com.erp.model.oms.entity.CustomerAddressEntity">
        SELECT ca.*
        FROM
            customer_address ca
        WHERE ca.main_id IN
        <foreach item="item" index="index" collection="mainIds" open="(" close=")" separator=",">
               #{item}
        </foreach>
    </select>
</mapper>
