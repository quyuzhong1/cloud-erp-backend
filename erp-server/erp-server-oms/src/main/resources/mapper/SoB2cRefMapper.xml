<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.oms.mapper.SoB2cRefMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.oms.entity.SoB2cRefEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="type" property="type" />
       <result column="source_id" property="sourceId" />
       <result column="target_id" property="targetId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        type, source_id, target_id
    </sql>

    <select id="listSourceByTargetIds" resultType="com.erp.model.oms.entity.SoB2cRefEntity">
        select
            <include refid="Base_Column_List" />
        from so_b2c_ref
        where is_deleted = false and  source_id in (
            select source_id from so_b2c_ref
            <where>
                is_deleted = false
                <if test="targetIdList != null and targetIdList.size > 0">
                    and target_id in
                    <foreach collection="targetIdList" item="item" separator="," open="(" close=")">
                        #{item}
                    </foreach>
                </if>
                <if test="code != null and code != ''">
                    and type = #{code}
                </if>
            </where>
            )
    </select>
    <select id="getAllSplitIds" resultType="java.lang.String">

        SELECT distinct target_id from so_b2c_ref where source_id IN (
            SELECT source_id from so_b2c_ref where target_id = #{soId} and is_deleted =false
        ) and type = 'split' and is_deleted =false
    </select>
    <select id="listBySourceIdOrTargetId" resultType="com.erp.model.oms.entity.SoB2cRefEntity">
        SELECT id,type,source_id,target_id,source_detail_id,target_detail_id
        FROM so_b2c_ref
        WHERE is_deleted =false
        and (
            source_id = ANY(ARRAY[#{sourceIds}]) OR target_id = ANY(ARRAY[#{targetIds}])
            )
    </select>


</mapper>
