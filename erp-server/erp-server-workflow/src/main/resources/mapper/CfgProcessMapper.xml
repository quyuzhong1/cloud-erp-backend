<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.workflow.mapper.CfgProcessMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.workflow.entity.CfgProcessEntity">
        <result column="id" property="id"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="bussiness_key" property="bussinessKey"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, name, bussiness_key
    </sql>

    <resultMap id="processResultMap" type="com.erp.model.workflow.dto.CfgProcessDTO$ProcessDTO">
        <id property="id" column="process_id"/>
        <result property="code" column="process_code"/>
        <result property="name" column="process_name"/>
        <result property="bussinessKey" column="process_bussiness_key"/>

        <collection property="ruleList" ofType="com.erp.model.workflow.dto.CfgProcessDTO$ProcessRuleDTO"
                    resultMap="processRuleResultMap"/>
    </resultMap>

    <resultMap id="processRuleResultMap" type="com.erp.model.workflow.dto.CfgProcessDTO$ProcessRuleDTO">
        <id property="id" column="rule_id"/>
        <result property="type" column="rule_type"/>
        <result property="processDefinitionName" column="process_definition_name"/>
        <result property="processDefinitionVersion" column="process_definition_version"/>
        <result property="createTime" column="rule_create_time"/>
        <result property="createUserName" column="rule_create_user_name"/>
        <result property="updateTime" column="rule_update_time"/>
        <result property="updateUserName" column="rule_update_user_name"/>
        <result property="disabled" column="disabled"/>
        <result property="isDefault" column="is_default"/>

        <collection property="expList" ofType="com.erp.model.workflow.dto.CfgProcessDTO$ProcessExpDTO"
                    resultMap="processExpResultMap"/>
    </resultMap>

    <resultMap id="processExpResultMap" type="com.erp.model.workflow.dto.CfgProcessDTO$ProcessExpDTO">
        <id property="index" column="exp_index"/>
        <result property="expDesc" column="exp_desc"/>
    </resultMap>

    <select id="getProcessWithRulesAndExps" resultMap="processResultMap">
        SELECT
        -- Process
        p.id AS process_id,
        p.code AS process_code,
        p.name AS process_name,
        p.bussiness_key AS process_bussiness_key,

        -- Rule
        r.id AS rule_id,
        r.type AS rule_type,
        r.process_definition_version AS process_definition_version,
        r.disabled AS disabled,
        r.is_default AS is_default,
        r.create_time AS rule_create_time,
        r.create_user_name AS rule_create_user_name,
        r.update_time AS rule_update_time,
        r.update_user_name AS rule_update_user_name,

        CASE
        WHEN r.type = 'fsProcess' THEN tpd.name
        WHEN r.type = 'erpProcess' THEN pd.process_name
        ELSE NULL
        END AS process_definition_name,

        -- Expression
        e.index AS exp_index,
        CONCAT(
        COALESCE(e.left_bracket, ''),
        COALESCE(e.field, ''),
        COALESCE(drc.value, ''),
        COALESCE(e.value, ''),
        COALESCE(e.right_bracket, ''),
        COALESCE(e.logic, ''),
        COALESCE(e.name, '')
        ) AS exp_desc

        FROM public.cfg_process p
        LEFT JOIN public.cfg_process_rule r ON p.id = r.cfg_process_id AND r.is_deleted = false
        LEFT JOIN public.third_process_definition tpd ON r.type = 'fsProcess' AND r.process_definition_id = tpd.id AND
        tpd.is_deleted = false
        LEFT JOIN public.process_definition pd ON r.type = 'erpProcess' AND r.process_definition_id = pd.id AND
        pd.is_deleted = false
        LEFT JOIN public.cfg_process_exp e ON r.id = e.rule_id AND e.is_deleted = false
        LEFT JOIN public.dict_rule_condition drc ON e.compare = drc.key AND drc.is_deleted = false

        WHERE
        ${params.sqlMap.default}
        AND p.is_deleted = false

        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>

        ORDER BY r.create_time,p.code desc
    </select>

    <resultMap id="viewDTOResultMap" type="com.erp.model.workflow.dto.CfgProcessDTO$ViewDTO">
        <id property="id" column="process_id"/>
        <result property="code" column="process_code"/>
        <result property="name" column="process_name"/>
        <result property="bussinessKey" column="process_bussiness_key"/>

        <collection property="processRuleDTOList" ofType="com.erp.model.workflow.dto.CfgProcessRuleDTO$ViewDTO"
                    resultMap="ruleViewDTOResultMap"/>
    </resultMap>

    <resultMap id="ruleViewDTOResultMap" type="com.erp.model.workflow.dto.CfgProcessRuleDTO$ViewDTO">
        <id property="id" column="rule_id"/>
        <result property="type" column="rule_type"/>
        <result property="cfgProcessId" column="cfg_process_id"/>
        <result property="processDefinitionId" column="process_definition_id"/>
        <result property="processDefinitionVersion" column="process_definition_version"/>
        <result property="isDefault" column="is_default"/>
        <result property="disabled" column="disabled"/>
        <result property="ruleDesc" column="expDesc"/>

        <collection property="processExpDTOList" ofType="com.erp.model.workflow.dto.CfgProcessExpDTO$ViewDTO"
                    resultMap="expViewDTOResultMap"/>
        <collection property="processFieldMapDTOList" ofType="com.erp.model.workflow.dto.CfgProcessFieldMapDTO$ViewDTO"
                    resultMap="fieldViewDTOResultMap"/>
        <!-- 如果 fieldList 也有复杂结构，可再添加 collection 映射 -->
    </resultMap>

    <resultMap id="expViewDTOResultMap" type="com.erp.model.workflow.dto.CfgProcessExpDTO$ViewDTO">
        <id property="id" column="exp_id"/>
        <result property="ruleId" column="rule_id"/>
        <result property="leftBracket" column="left_bracket"/>
        <result property="field" column="field"/>
        <result property="compare" column="compare"/>
        <result property="value" column="value"/>
        <result property="rightBracket" column="right_bracket"/>
        <result property="logic" column="logic"/>
        <result property="index" column="exp_index"/>
        <result property="name" column="exp_name"/>
    </resultMap>
    <resultMap id="fieldViewDTOResultMap" type="com.erp.model.workflow.dto.CfgProcessFieldMapDTO$ViewDTO">
        <id property="id" column="field_map_id"/>
        <result property="thirdField" column="third_field"/>
        <result property="thirdFieldType" column="third_field_type"/>
        <result property="thirdFieldRequired" column="third_field_required"/>
        <result property="sysField" column="sys_field"/>
        <result property="sysFieldType" column="sys_field_type"/>
        <result property="sysFieldRequired" column="sys_field_required"/>
        <result property="cfgId" column="cfg_id"/>
        <result property="defaultValue" column="default_value"/>
        <result property="isUnique" column="is_unique"/>
        <result property="cfgType" column="cfg_type"/>
        <result property="processDefintionId" column="process_definition_id"/>
        <result property="thirdFieldId" column="third_field_id"/>
        <result property="isDetailField" column="is_detail_field"/>
        <result property="thirdFieldFieldListFid" column="third_field_field_list_fid"/>

        <!-- 映射嵌套的 valueList -->
        <collection property="processValueMapDTOList" ofType="com.erp.model.workflow.dto.CfgProcessValueMapDTO$ViewDTO"
                    resultMap="valueViewDTOResultMap"/>
    </resultMap>
    <resultMap id="valueViewDTOResultMap" type="com.erp.model.workflow.dto.CfgProcessValueMapDTO$ViewDTO">
        <id property="id" column="value_map_id"/>
        <result property="fieldMapId" column="field_map_id"/>
        <result property="thirdValue" column="third_value"/>
        <result property="sysValue" column="sys_value"/>
    </resultMap>

    <select id="getViewDTOById" resultMap="viewDTOResultMap">
        SELECT p.id                                                                         AS process_id,
               p.code                                                                       AS process_code,
               p.name                                                                       AS process_name,
               p.bussiness_key                                                              AS process_bussiness_key,

               r.id                                                                         AS rule_id,
               r.type                                                                       AS rule_type,
               r.cfg_process_id                                                             AS cfg_process_id,
               r.process_definition_id                                                      AS process_definition_id,
               r.process_definition_version                                                 AS process_definition_version,
               r.is_default                                                                 AS is_default,
               r.disabled                                                                   AS disabled,
               CONCAT(e.left_bracket, e.field, e.value, e.right_bracket, e.logic, e.name) AS expDesc,

               -- Rule Expression Fields
               e.id                                                                         AS exp_id,
               e.rule_id                                                                    AS rule_id_for_exp,
               e.left_bracket                                                               AS left_bracket,
               e.field                                                                      AS field,
               e.compare                                                                    AS compare,
               e.value                                                                      AS value,
               e.right_bracket                                                              AS right_bracket,
               e.logic                                                                      AS logic,
               e.index                                                                      AS exp_index,
               e.name                                                                       AS exp_name,

               -- Field Map Fields
               fm.id                                                                        AS field_map_id,
               fm.third_field                                                               AS third_field,
               fm.third_field_type                                                          AS third_field_type,
               fm.third_field_required                                                      AS third_field_required,
               fm.sys_field                                                                 AS sys_field,
               fm.sys_field_type                                                            AS sys_field_type,
               fm.sys_field_required                                                        AS sys_field_required,
               fm.cfg_id                                                                    AS cfg_id,
               fm.default_value                                                             AS default_value,
               fm.is_unique                                                                 AS is_unique,
               fm.cfg_type                                                                  AS cfg_type,
               fm.process_definition_id                                                     AS process_definition_id,
               fm.third_field_id                                                            AS third_field_id,
               fm.is_detail_field                                                           AS is_detail_field,
               fm.third_field_field_list_fid                                                AS third_field_field_list_fid,

               -- Value Map Fields
               vm.id                                                                        AS value_map_id,
               vm.field_map_id                                                              AS value_field_map_id,
               vm.third_value                                                               AS third_value,
               vm.sys_value                                                                 AS sys_value

        FROM public.cfg_process p
                 LEFT JOIN public.cfg_process_rule r ON p.id = r.cfg_process_id AND r.is_deleted = false
                 LEFT JOIN public.cfg_process_exp e ON r.id = e.rule_id AND e.is_deleted = false
                 LEFT JOIN public.cfg_process_field_map fm ON r.id = fm.cfg_process_rule_id AND fm.is_deleted = false
                 LEFT JOIN public.cfg_process_value_map vm ON fm.id = vm.field_map_id AND vm.is_deleted = false

        WHERE p.id = #{id}
          AND p.is_deleted = false
        ORDER BY r.create_time DESC, e.index ASC, fm.id ASC, vm.id ASC
    </select>


    <select id="tabList" resultType="com.erp.model.workflow.dto.CfgProcessDTO$TabListDTO">
        SELECT
        cpr.disabled AS tabFlag,
        count(1) AS count
        FROM cfg_process as cp
        left join cfg_process_rule cpr on cp.id = cpr.cfg_process_id
        WHERE cp.is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY cpr.disabled
    </select>
    <select id="getApprovalCode" resultType="java.lang.String">
        SELECT
        cpr.code
        FROM cfg_process as cp
        left join cfg_process_rule cpr on cp.id = cpr.cfg_process_id
        WHERE cp.is_deleted=FALSE
        AND cpr.disabled = FALSE
        AND cpr.type = 'erpProcess'
    </select>
</mapper>
