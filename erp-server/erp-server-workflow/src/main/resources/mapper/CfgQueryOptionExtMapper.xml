<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.workflow.mapper.CfgQueryOptionExtMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.workflow.entity.CfgQueryOptionExtEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="cfg_query_option_id" property="cfgQueryOptionId" />
       <result column="type" property="type" />
       <result column="class_path" property="classPath" />
       <result column="data_json" property="dataJson" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        cfg_query_option_id, type, class_path, data_json
    </sql>
    <insert id="insertSave">
        insert into cfg_query_option_ext(id, create_user_id, create_user_name, create_time, update_user_id, update_user_name, update_time, version, is_deleted, cfg_query_option_id, type, class_path, data_json) values (#{id}, #{createUserId}, #{createUserName}, #{createTime}, #{updateUserId}, #{updateUserName}, #{updateTime}, #{version}, #{isDeleted}, #{cfgQueryOptionId}, #{type}, #{classPath},   CAST(
                #{dataJson, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler}
            AS jsonb
                                                                                                                                                                                                                                                                                                                                                                                                               ))
    </insert>


</mapper>
