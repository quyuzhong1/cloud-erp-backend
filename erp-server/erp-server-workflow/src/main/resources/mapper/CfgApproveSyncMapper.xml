<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.workflow.mapper.CfgApproveSyncMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.workflow.entity.CfgApproveSyncEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="business_type" property="businessType" />
       <result column="webhook_url" property="webhookUrl" />
       <result column="approve_group" property="approveGroup" />
       <result column="enable_status" property="enableStatus" />
       <result column="remark" property="remark" />
       <result column="title" property="title" />
       <result column="viewer_type" property="viewerType" />
       <result column="viewer" property="viewer" />
       <result column="sync_platform" property="syncPlatform" />
       <result column="approval_code" property="approvalCode" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, business_type, webhook_url, approve_group, enable_status, remark, title, viewer_type, viewer, sync_platform, approval_code
    </sql>

    <sql id="paging_sql">
        SELECT
            cas.ID AS ID,
            cas.create_user_id AS createUserId,
            cas.create_user_name AS createUserName,
            cas.create_time AS createTime,
            cas.update_user_id AS updateUserId,
            cas.update_user_name AS updateUserName,
            cas.update_time AS updateTime,
            cas.VERSION AS VERSION,
            cas.is_deleted AS isDeleted,
            cas.code AS code,
            cas.business_type AS businessType,
            cas.webhook_url AS webhookUrl,
            cas.approve_group AS approveGroup,
            cas.enable_status AS enableStatus,
            cas.remark AS remark,
            cas.title AS title,
            cas.viewer_type AS viewerType,
            cas.viewer AS viewer,
            cas.sync_platform AS syncPlatform,
            cas.approval_code AS approvalCode
        FROM
            cfg_approve_sync AS cas
        WHERE
            ${params.sqlMap.default}
            AND cas.is_deleted = FALSE
        <if test="params.ids != null and params.ids.size > 0">
            and cas.id in
            <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        cas.create_time DESC
    </sql>

    <select id="tabList" resultType="com.erp.model.workflow.dto.CfgApproveSyncDTO$TabListDTO">
        SELECT
        cas.enable_status AS tabFlag,
        count(1)  AS count
        FROM  cfg_approve_sync as cas
        WHERE cas.is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY cas.enable_status
    </select>

    <select id="paging" resultType="com.erp.model.workflow.dto.CfgApproveSyncDTO$ListDTO">
        <include refid="paging_sql"></include>
    </select>

</mapper>
