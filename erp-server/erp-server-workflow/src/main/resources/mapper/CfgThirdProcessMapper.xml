<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.workflow.mapper.CfgThirdProcessMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.workflow.entity.CfgThirdProcessEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="name" property="name" />
       <result column="bussiness_key" property="bussinessKey" />
       <result column="operate_type" property="operateType" />
       <result column="source_platform" property="sourcePlatform" />
       <result column="enable_status" property="enableStatus" />
       <result column="enable_time" property="enableTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, name, bussiness_key, operate_type, source_platform, enable_status, enable_time
    </sql>
    <select id="tabList" resultType="com.erp.model.workflow.dto.CfgThirdProcessDTO$TabListDTO">
        SELECT
        cas.enable_status AS tabFlag,
        count(1)  AS count
        FROM  cfg_third_process as ctp
        WHERE ctp.is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY ctp.enable_status
    </select>

    <select id="paging" resultType="com.erp.model.workflow.dto.CfgThirdProcessDTO$ListDTO">
        select
        <include refid="Base_Column_List"></include>
            wm.module_classify  AS bussinessKeyName
        from cfg_third_process as ctp
        LEFT JOIN public.work_menu wm ON wm.module_code = p.bussiness_key AND wm.is_deleted = false
        where
        ${params.sqlMap.default}
        and is_deleted = false
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        order by create_time desc
    </select>


</mapper>
