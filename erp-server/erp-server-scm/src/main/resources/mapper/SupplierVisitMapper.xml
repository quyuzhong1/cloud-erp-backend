<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.scm.mapper.SupplierVisitMapper">


    <select id="paging" resultType="com.erp.model.scm.dto.SupplierVisitDTO$PagingViewDTO">
        SELECT
            id,
            visit_time,
            people,
            content,
            result,
            type,
            supplier_id
        FROM supplier_visit  WHERE supplier_id=#{supplierId} AND is_deleted=false

    </select>
</mapper>
