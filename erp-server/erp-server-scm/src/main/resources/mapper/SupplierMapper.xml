<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.scm.mapper.SupplierMapper">


    <select id="paging" resultType="com.erp.model.scm.dto.SupplierDTO$PagingViewDTO">
        SELECT
        id,
        code,
        create_user_id AS createUserId,
        create_user_name AS createUserName,
        create_time AS createTime,
        name,
        approve_status AS approveStatus,
        phase,
        grade_id AS gradeId,
        category_id AS categoryId ,
        disabled AS disabled,
        pay_method_id AS payMethodId,
        purchase_user_id AS purchaseUserId,
        purchase_user_name AS purchaseUserName
        FROM supplier

        WHERE is_deleted=FALSE
        <if test="params.name!=null and params.name!=''">
            AND
            name LIKE concat('%', #{params.name} ,'%')
        </if>
        <if test="params.categoryIdList!=null and params.categoryIdList.size>0">
            AND category_id IN
            <foreach collection="params.categoryIdList" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
        <if test="params.phaseList!=null and params.phaseList.size>0">
            AND phase IN
            <foreach collection="params.phaseList" item="phase" open="(" separator="," close=")">
                #{phase}
            </foreach>
        </if>
        <if test="params.purchaseUserIdList!=null and params.purchaseUserIdList.size>0">
            AND purchase_user_id IN
            <foreach collection="params.purchaseUserIdList" item="purchaseUserId" open="(" separator="," close=")">
                #{purchaseUserId}
            </foreach>
        </if>

        <if test="params.payMethodIdList!=null and params.payMethodIdList.size>0">
            AND pay_method_id IN
            <foreach collection="params.payMethodIdList" item="payMethodId" open="(" separator="," close=")">
                #{payMethodId}
            </foreach>
        </if>
        <if test="params.disabled!=null">
            AND disabled=#{params.disabled}
        </if>
        <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
            AND create_user_id IN
            <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                #{createUserId}
            </foreach>
        </if>
        <if test="params.gradeIdList !=null and params.gradeIdList.size>0">
            AND grade_id IN
            <foreach collection="params.gradeIdList" item="gradeId" open="(" separator="," close=")">
                #{gradeId}
            </foreach>
        </if>
        <if test="params.contactPerson!=null and params.contactPerson !=''">
            AND id IN
            (SELECT supplier_id  FROM  supplier_contact  WHERE  is_deleted=FALSE   AND  person LIKE '%${params.contactPerson}%' )
        </if>
        <if test="params.contactTelNumber!=null and params.contactTelNumber !=''">
            AND id IN
            (SELECT supplier_id  FROM  supplier_contact  WHERE  is_deleted=FALSE   AND  tel_number LIKE '%${params.contactTelNumber}%' )
        </if>

        <if test="params.createTimeList != null and params.createTimeList.size > 0">
            and create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > create_time
        </if>

        <!--权限-->
        <if test="params.param!=null and params.param!=''">
            ${params.param}
        </if>

        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        create_time DESC
    </select>

    <select id="getExportSupplier" resultType="com.erp.model.scm.dto.SupplierDTO$PagingViewDTO">
     SELECT
        id,
        code,
        create_user_id AS createUserId,
        create_user_name AS createUserName,
        create_time AS createTime,
        name,
        approve_status AS approveStatus,
        phase,
        grade_id AS gradeId,
        category_id AS categoryId ,
        disabled AS disabled,
        pay_method_id AS payMethodId,
        purchase_user_id AS purchaseUserId,
        purchase_user_name AS purchaseUserName
        FROM supplier
        WHERE is_deleted=FALSE
        <choose>
            <when test="params.ids!=null and params.ids.size>0 ">
                 AND id IN
                <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                <if test="params.name!=null and params.name!=''">
                    AND
                    name LIKE concat('%', #{params.name} ,'%')
                </if>
                <if test="params.categoryIdList!=null and params.categoryIdList.size>0">
                    AND category_id IN
                    <foreach collection="params.categoryIdList" item="categoryId" open="(" separator="," close=")">
                        #{categoryId}
                    </foreach>
                </if>
                <if test="params.phaseList!=null and params.phaseList.size>0">
                    AND phase IN
                    <foreach collection="params.phaseList" item="phase" open="(" separator="," close=")">
                        #{phase}
                    </foreach>
                </if>
                <if test="params.purchaseUserIdList!=null and params.purchaseUserIdList.size>0">
                    AND purchase_user_id IN
                    <foreach collection="params.purchaseUserIdList" item="purchaseUserId" open="(" separator="," close=")">
                        #{purchaseUserId}
                    </foreach>
                </if>

                <if test="params.payMethodIdList!=null and params.payMethodIdList.size>0">
                    AND pay_method_id IN
                    <foreach collection="params.payMethodIdList" item="payMethodId" open="(" separator="," close=")">
                        #{payMethodId}
                    </foreach>
                </if>
                <if test="params.disabled!=null">
                    AND disabled=#{params.disabled}
                </if>
                <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
                    AND create_user_id IN
                    <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                        #{createUserId}
                    </foreach>
                </if>
                <if test="params.gradeIdList !=null and params.gradeIdList.size>0">
                    AND grade_id IN
                    <foreach collection="params.gradeIdList" item="gradeId" open="(" separator="," close=")">
                        #{gradeId}
                    </foreach>
                </if>
                <if test="params.contactPerson!=null and params.contactPerson !=''">
                    AND id IN
                    (SELECT supplier_id  FROM  supplier_contact  WHERE  is_deleted=FALSE   AND  person LIKE '%${params.contactPerson}%' )
                </if>
                <if test="params.contactTelNumber!=null and params.contactTelNumber !=''">
                    AND id IN
                    (SELECT supplier_id  FROM  supplier_contact  WHERE  is_deleted=FALSE   AND  tel_number LIKE '%${params.contactTelNumber}%' )
                </if>
                <if test="params.createTimeList != null and params.createTimeList.size > 0">
                    and create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > create_time
                </if>
            </otherwise>
        </choose>

        <!--权限-->
        <if test="params.param!=null and params.param!=''">
            ${params.param}
        </if>
    </select>
</mapper>
