<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.scm.mapper.SupplierPhaseMapper">


    <select id="paging" resultType="com.erp.model.scm.dto.SupplierPhaseDTO$PagingViewDTO">
         SELECT
           sp.id,
           sp.create_user_name,
           sp.create_time,
           sp.supplier_id,
           sp.type,
           sp.current_phase,
           sp.target_phase,
           sp.approve_status,
           sp.description,
           su.name AS supplierName,
           su.id AS supplierId,
           su.code AS supplierCode,
           su.category_id,
           su.category_name
         FROM supplier_phase sp
         INNER JOIN supplier su
         ON su.id=sp.supplier_id
         WHERE  sp.is_deleted=false
         <if test="params.name!=null and params.name!=''">
            AND su.name LIKE  concat('%', #{params.name} ,'%')
         </if>

        <if test="params.categoryIdList!=null and params.categoryIdList.size>0">
            AND su.category_id IN
            <foreach collection="params.categoryIdList" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
        <if test="params.phaseList!=null and params.phaseList.size>0">
            AND su.phase IN
            <foreach collection="params.phaseList" item="phase" open="(" separator="," close=")">
                #{phase}
            </foreach>
        </if>
        <if test="params.approveStatusList!=null and params.approveStatusList.size>0">
            AND sp.approve_status IN
            <foreach collection="params.approveStatusList" item="approveStatus" open="(" separator="," close=")">
                #{approveStatus}
            </foreach>
        </if>
    </select>
</mapper>
