<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.fms.mapper.AssetStocktakingPlanMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.fms.entity.AssetStocktakingPlanEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="approve_status" property="approveStatus" />
       <result column="approve_user_id" property="approveUserId" />
       <result column="approve_user_name" property="approveUserName" />
       <result column="approve_time" property="approveTime" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="invalid_remark" property="invalidRemark" />
       <result column="invalid_time" property="invalidTime" />
       <result column="code" property="code" />
       <result column="plan_name" property="planName" />
       <result column="asset_org_id" property="assetOrgId" />
       <result column="asset_org_name" property="assetOrgName" />
       <result column="remark" property="remark" />
       <result column="asset_categories" property="assetCategories" />
       <result column="use_dept_ids" property="useDeptIds" />
       <result column="asset_location_ids" property="assetLocationIds" />
       <result column="card_code_start" property="cardCodeStart" />
       <result column="card_code_end" property="cardCodeEnd" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        approve_status, approve_user_id, approve_user_name, approve_time, invalid_status, invalid_remark, invalid_time, code, plan_name, asset_org_id, asset_org_name, remark, asset_categories, use_dept_ids, asset_location_ids, card_code_start, card_code_end
    </sql>

    <select id="paging" resultType="com.erp.model.fms.dto.AssetStocktakingPlanDTO$ListDTO">
        SELECT
            asp.id,
            asp.approve_status,
            asp.approve_user_id,
            asp.approve_user_name,
            asp.approve_time,
            asp.invalid_status,
            asp.invalid_remark,
            asp.invalid_time,
            asp.code,
            asp.plan_name,
            asp.asset_org_id,
            asp.asset_org_name,
            asp.remark,
            asp.asset_categories,
            asp.use_dept_ids,
            asp.asset_location_ids,
            asp.card_code_start,
            asp.card_code_end,
            asp.create_time,
            asp.create_user_name
        FROM asset_stocktaking_plan asp
        WHERE
        ${params.sqlMap.default}
        AND asp.is_deleted = false
        <!--权限-->
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        asp.create_time DESC
    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from asset_stocktaking_plan where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.fms.dto.AssetStocktakingPlanDTO$ListDTO">
        SELECT
            asp.id,
            asp.approve_status,
            asp.approve_user_id,
            asp.approve_user_name,
            asp.approve_time,
            asp.invalid_status,
            asp.invalid_remark,
            asp.invalid_time,
            asp.code,
            asp.plan_name,
            asp.asset_org_id,
            asp.asset_org_name,
            asp.remark,
            asp.asset_categories,
            asp.use_dept_ids,
            asp.asset_location_ids,
            asp.card_code_start,
            asp.card_code_end,
            asp.create_time,
            asp.create_user_name
        FROM asset_stocktaking_plan asp
        WHERE
        ${params.sqlMap.default}
        AND asp.is_deleted = false
        <!--勾选的id集合-->
        <if test="params.ids != null and params.ids.size() > 0">
            AND asp.id IN
            <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <!--权限-->
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        asp.create_time DESC
    </select>
    <select id="tabList" resultType="com.erp.model.fms.dto.AssetStocktakingPlanDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  asset_stocktaking_plan
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
