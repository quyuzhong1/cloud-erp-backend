<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.fms.mapper.AssetCardDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.fms.entity.AssetCardDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="source_detail_id" property="sourceDetailId" />
       <result column="main_id" property="mainId" />
       <result column="asset_code" property="assetCode" />
       <result column="asset_location_id" property="assetLocationId" />
       <result column="qty" property="qty" />
       <result column="supplier_id" property="supplierId" />
       <result column="supplier_name" property="supplierName" />
       <result column="use_dept_name" property="useDeptName" />
       <result column="use_dept_id" property="useDeptId" />
       <result column="cost_type" property="costType" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        source_detail_id, main_id, asset_code, asset_location_id, qty, supplier_id, supplier_name, use_dept_name, use_dept_id, cost_type, remark
    </sql>

    <select id="searchAssetCardDetail"
            resultType="com.erp.model.fms.dto.AssetCardDetailDTO$SearchCardDetailDTO">
        select
        <include refid="Base_Column_List"></include>
        from asset_card_detail
        where
        is_deleted = false
        AND approve_status = 'approve'
        <if test="params.cardIds != null and params.cardIds != ''">
            and main_id in
            <foreach collection="params.cardIds" item="cardId" open="(" separator="," close=")">
                #{cardId}
            </foreach>
        </if>
        <if test="params.searchKeyword != null and params.searchKeyword != ''">
            AND
            (
            code ILIKE concat('%',#{params.searchKeyword}::text,'%')
            OR
            name ILIKE concat('%',#{params.searchKeyword}::text,'%')
            )
            ORDER BY
            case when code ILIKE concat(#{params.searchKeyword}::text,'%') THEN 1
            when code ILIKE concat('%',#{params.searchKeyword}::text) THEN 2
            when code ILIKE concat('%',#{params.searchKeyword}::text,'%') THEN 3
            end , code
        </if>

    </select>


</mapper>
