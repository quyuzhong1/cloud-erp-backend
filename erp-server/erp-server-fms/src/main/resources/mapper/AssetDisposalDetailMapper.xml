<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.fms.mapper.AssetDisposalDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.fms.entity.AssetDisposalDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="source_id" property="sourceId" />
       <result column="source_code" property="sourceCode" />
       <result column="main_id" property="mainId" />
       <result column="asset_name" property="assetName" />
       <result column="unit" property="unit" />
       <result column="qty" property="qty" />
       <result column="disposal_qty" property="disposalQty" />
       <result column="disposal_currency" property="disposalCurrency" />
       <result column="cleanup_cost" property="cleanupCost" />
       <result column="residual_value" property="residualValue" />
       <result column="invoice_type" property="invoiceType" />
       <result column="tax_rate" property="taxRate" />
       <result column="tax_amount" property="taxAmount" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        add.id AS id,
add.create_user_id AS createUserId,
add.create_user_name AS createUserName,
add.create_time AS createTime,
add.update_user_id AS updateUserId,
add.update_user_name AS updateUserName,
add.update_time AS updateTime,
add.version AS version,
add.is_deleted AS isDeleted,
add.source_id AS sourceId,
add.source_code AS sourceCode,
add.main_id AS mainId,
add.asset_name AS assetName,
add.unit AS unit,
add.qty AS qty,
add.disposal_qty AS disposalQty,
add.disposal_currency AS disposalCurrency,
add.cleanup_cost AS cleanupCost,
add.residual_value AS residualValue,
add.invoice_type AS invoiceType,
add.tax_rate AS taxRate,
add.tax_amount AS taxAmount
    </sql>

    <select id="listByMainId" resultType="com.erp.model.fms.dto.AssetDisposalDetailDTO$ViewDTO">
        SELECT
        <include refid="Base_Column_List"></include>
        FROM
        asset_disposal_detail add
        where add.is_deleted = FALSE
        <if test="mainId != null and mainId != ''">
            AND add.main_id = #{mainId}
        </if>
    </select>

</mapper>
