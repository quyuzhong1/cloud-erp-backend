<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.fms.mapper.AssetDisposalPhysicalDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.fms.entity.AssetDisposalPhysicalDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="asset_disposal_detail_id" property="assetDisposalDetailId" />
       <result column="main_id" property="mainId" />
       <result column="asset_code" property="assetCode" />
       <result column="asset_location_id" property="assetLocationId" />
       <result column="asset_location_name" property="assetLocationName" />
       <result column="qty" property="qty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        adpd.id AS id,
adpd.create_user_id AS createUserId,
adpd.create_user_name AS createUserName,
adpd.create_time AS createTime,
adpd.update_user_id AS updateUserId,
adpd.update_user_name AS updateUserName,
adpd.update_time AS updateTime,
adpd.version AS version,
adpd.is_deleted AS isDeleted,
adpd.asset_disposal_detail_id AS assetDisposalDetailId,
adpd.main_id AS mainId,
adpd.asset_code AS assetCode,
adpd.asset_location_id AS assetLocationId,
adpd.asset_location_name AS assetLocationName,
adpd.qty AS qty
    </sql>

    <select id="listByMainId" resultType="com.erp.model.fms.dto.AssetDisposalPhysicalDetailDTO$ViewDTO">
        SELECT
        <include refid="Base_Column_List"></include>
        FROM
        asset_disposal_physical_detail adpd
        where
        AND adpd.is_deleted = FALSE
        <if test="mainId != null and mainId != ''">
            AND adpd.main_id = #{mainId}
        </if>
    </select>


</mapper>
