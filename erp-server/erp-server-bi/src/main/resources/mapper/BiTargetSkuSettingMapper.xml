<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiTargetSkuSettingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.bi.entity.BiTargetSkuSettingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="month" property="month" />
       <result column="value" property="value" />
       <result column="metrics" property="metrics" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, sku_id, sku_no, month, value, metrics
    </sql>

    <select id="paging" resultType="com.erp.model.bi.dto.BiTargetSkuSettingDTO$PagingViewDTO">
        SELECT
        ty.id,
        ty.year,
        ty.dept_id,
        ty.dept_name
        FROM bi_target_year ty
        WHERE ty.is_deleted=false
        <if test="params.yearList !=null and params.yearList.size>0">
            AND ty.year IN
            <foreach collection="params.yearList" item="year" open="(" separator="," close=")">
                #{year}
            </foreach>
        </if>
        <if test="params.metricsList !=null and params.metricsList.size>0">
            AND ty.id IN (
            SELECT main_id FROM bi_target_sku_setting
            WHERE is_deleted=FALSE AND metrics IN
            <foreach collection="params.metricsList" item="metrics" open="(" separator="," close=")">
                #{metrics}
            </foreach>
            )
        </if>
        <if test="params.name !=null and params.name!=''">
            AND ty.id IN (
            SELECT main_id FROM bi_target_sku_setting
            WHERE is_deleted=FALSE AND sku_no
            ILIKE concat('%', #{params.name} ,'%')
            )
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY ty.id DESC
    </select>


</mapper>
