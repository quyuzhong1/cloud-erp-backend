<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiTargetShopSettingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.bi.entity.BiTargetShopSettingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="shop_id" property="shopId" />
       <result column="shop_name" property="shopName" />
       <result column="month" property="month" />
       <result column="value" property="value" />
       <result column="metrics" property="metrics" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, shop_id, shop_name, month, value, metrics
    </sql>
    <select id="paging" resultType="com.erp.model.bi.dto.BiTargetShopSettingDTO$PagingViewDTO">
        SELECT
        ty.id,
        ty.year,
        ty.dept_id,
        ty.dept_name
        FROM bi_target_year ty
        WHERE ty.is_deleted=false
        <if test="params.yearList !=null and params.yearList.size>0">
            AND ty.year IN
            <foreach collection="params.yearList" item="year" open="(" separator="," close=")">
                #{year}
            </foreach>
        </if>
        <if test="params.metricsList !=null and params.metricsList.size>0">
            AND ty.id IN (
            SELECT main_id FROM bi_target_shop_setting
            WHERE is_deleted=FALSE AND metrics IN
            <foreach collection="params.metricsList" item="metrics" open="(" separator="," close=")">
                #{metrics}
            </foreach>
            )
        </if>
        <if test="params.name !=null and params.name!=''">
            AND ty.id IN (
            SELECT main_id FROM bi_target_shop_setting
            WHERE is_deleted=FALSE AND shop_name
            ILIKE concat('%', #{params.name} ,'%')
            )
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY ty.id DESC
    </select>

    <select id="listTargetFinish" resultType="com.erp.model.bi.entity.BiTargetShopSettingEntity">
        select
            btss.main_id,
            btss.shop_id,
            btss.shop_name,
            btss.month,
            btss.value,
            btss.metrics
        from bi_target_year bty
        left join bi_target_shop_setting btss on btss.is_deleted = false and bty.id = btss.main_id
        <where>
            bty.is_deleted = false
            <if test="params.metrics != null and params.metrics != ''">
                and  btss.metrics = #{params.metrics}
            </if>
            <if test="params.date != null ">
                and  bty.year = to_char(#{params.date},'yyyy')  and btss.month between 1 and 12
            </if>
            <if test="params.deptIdList !=null and params.deptIdList.size > 0">
                and bty.dept_id in
                <foreach collection="params.deptIdList" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="params.shopNameList !=null and params.shopNameList.size > 0">
                and btss.shop_name in
                <foreach collection="params.shopNameList" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>


</mapper>
