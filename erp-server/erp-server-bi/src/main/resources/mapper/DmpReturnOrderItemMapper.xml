<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.DmpReturnOrderItemMapper">

    <sql id="Base_Column_List">
        id,return_order_id,sku_no,
        item_name,quantity,product_unit,
        picture_url,sell_price,specifics,
        status
    </sql>

    <select id="sumReturnAmountBySku" resultType="java.math.BigDecimal">
        select
            <if test="settleMethod == 2">
                SUM(droi.sell_price*droi.quantity)
            </if>
            <if test="settleMethod == 0">
                SUM(droi.sell_price*droi.quantity*dro.currency_rate)
            </if>
            <if test="settleMethod == 1">
                SUM(droi.sell_price*droi.quantity*dro.cny_settle_rate)
            </if>
        from dmp_return_order_item as droi
        LEFT JOIN dmp_return_order_info as dro on dro.return_order_id = droi."id"
        where dro.status = 4
        <if test="null != sku and sku.size() > 0">
            and droi.sku_no in
            <foreach collection="sku" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>

    </select>
</mapper>
