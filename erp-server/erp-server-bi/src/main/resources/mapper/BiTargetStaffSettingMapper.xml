<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiTargetStaffSettingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.bi.entity.BiTargetStaffSettingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="staff_id" property="staffId" />
       <result column="staff_name" property="staffName" />
       <result column="month" property="month" />
       <result column="value" property="value" />
       <result column="metrics" property="metrics" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, staff_id, staff_name, month, value, metrics
    </sql>

    <select id="listByYear" resultType="com.erp.model.bi.dto.BiTargetStaffSettingDTO$ListDetailDTO">
        SELECT
            tss.id,
            tss.main_id,
            ty.year,
            tss.staff_id,
            tss.month,
            tss.value,
            tss.metrics
        FROM bi_target_staff_setting tss
        LEFT JOIN bi_target_year ty
        ON tss.main_id=ty.id and ty.is_deleted=false
        WHERE tss.is_deleted=false
        AND ty.year=#{year}
    </select>


</mapper>
