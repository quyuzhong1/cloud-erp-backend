<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiTargetCategorySettingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.bi.entity.BiTargetCategorySettingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="category_id" property="categoryId" />
       <result column="category_name" property="categoryName" />
       <result column="month" property="month" />
       <result column="value" property="value" />
       <result column="metrics" property="metrics" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, category_id, category_name, month, value, metrics
    </sql>

    <select id="paging" resultType="com.erp.model.bi.dto.BiTargetCategorySettingDTO$PagingViewDTO">
        SELECT
        ty.id,
        ty.year,
        ty.dept_id,
        ty.dept_name
        FROM bi_target_year ty
        WHERE ty.is_deleted=false
        <if test="params.yearList !=null and params.yearList.size>0">
            AND ty.year IN
            <foreach collection="params.yearList" item="year" open="(" separator="," close=")">
                #{year}
            </foreach>
        </if>
        <if test="params.metricsList !=null and params.metricsList.size>0">
            AND ty.id IN (
            SELECT main_id FROM bi_target_category_setting
            WHERE is_deleted=FALSE AND metrics IN
            <foreach collection="params.metricsList" item="metrics" open="(" separator="," close=")">
                #{metrics}
            </foreach>
            )
        </if>
        <if test="params.name !=null and params.name!=''">
            AND ty.id IN (
            SELECT main_id FROM bi_target_category_setting
            WHERE is_deleted=FALSE AND category_name
            ILIKE concat('%', #{params.name} ,'%')
            )
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY ty.id DESC
    </select>

    <select id="listTargetFinish" resultType="com.erp.model.bi.dto.TargetFinishDTO$ViewDTO">
        select
            btcs.category_name as typeName,
            btcs.month,
            btcs.value
        from bi_target_year bty
        left join bi_target_category_setting btcs on btcs.is_deleted = false and bty.id = btcs.main_id
        <where>
            bty.is_deleted = false
            <if test="params.metrics != null and params.metrics != ''">
                and  btcs.metrics = #{params.metrics}
            </if>
            <if test="params.startTime != null ">
                and  bty.year = to_char(#{params.startTime},'yyyy')::INTEGER  and btcs.month between 1 and 12
            </if>
            <if test="params.department !=null and params.department.size > 0">
                and bty.dept_id in
                <foreach collection="params.department" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="params.category !=null and params.category.size > 0">
                and btcs.category_id in
                <foreach collection="params.category" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    <select id="listByYearAndDept" resultType="com.erp.model.bi.dto.BiTargetCategorySettingDTO$ListDetailDTO">
        SELECT
            tcs.id,
            tcs.main_id,
            ty.year,
            ty.dept_name,
            tcs.staff_id,
            tcs.staff_name,
            tcs.month,
            tcs.value,
            tcs.metrics
        FROM bi_target_category_setting tcs
        LEFT JOIN bi_target_year ty
        ON tcs.main_id=ty.id and ty.is_deleted=false
        WHERE tcs.is_deleted=false
        AND ty.year=#{year} AND ty.dept_id=#{deptId}
    </select>


</mapper>
