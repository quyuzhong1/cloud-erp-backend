<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiModuleMapper">


    <select id="paging" resultType="com.erp.model.bi.dto.ModulePagingDTO">
        SELECT id,name,remark,pid,image_url,state,view_code
        FROM bi_module
        <where>
            <if test="params.searchKeyword!=null and params.searchKeyword!=''">
                name LIKE concat('%',#{params.searchKeyword},'%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>
