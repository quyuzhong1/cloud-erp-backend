        <if test="params.department!=null and params.department.size>0">
            AND dsc.dept_id IN
            <foreach collection="params.department" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>

        <!-- 部门 -->
        <if test="params.userId!=null and params.userId.size>0">
            AND dsc.charge_id IN
            <foreach collection="params.userId" item="userId" open="(" separator="," close=")">
