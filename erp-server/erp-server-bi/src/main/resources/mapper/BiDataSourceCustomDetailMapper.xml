<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.bi.mapper.BiDataSourceCustomDetailMapper">


    <select id="listByCustomIds" resultType="com.erp.model.bi.entity.BiDataSourceCustomDetailEntity">
        select
            bdscd.date,
            bdscd.week_begin,
            bdscd.week_end,
            bdscd.month,
            bdscd.quarter,
            bdscd.year,
            bdscd.value,
            bdscd.custom_id
        from  bi_data_source_custom_detail bdscd
        <where>
            <if test="customIds != null and customIds.size() > 0">
                and bdscd.custom_id in
                <foreach collection="customIds" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
        order by bdscd.year , bdscd.month , bdscd.date
    </select>
</mapper>
