<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.DictKingdeeMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.sys.entity.DictKingdeeEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="kingdee_id" property="kingdeeId" />
       <result column="type_name" property="typeName" />
       <result column="value" property="value" />
       <result column="name" property="name" />
       <result column="disabled" property="disabled" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        kingdee_id, type_name, value, name, disabled
    </sql>
    <select id="listByParam" resultType="com.erp.model.sys.dto.DictKingdeeDTO$ListDTO">
        select  dk.type_name as typeName,dk.value as code ,dk.name ,dk.disabled
        from dict_kingdee dk
        where dk.is_deleted = false
        <if test="typeName != null and typeName != ''">
            dk.type_name = #{typeName}
        </if>
        <if test="value != null and value != ''">
            dk.value = #{value}
        </if>
        order by dk.disabled
    </select>


</mapper>
