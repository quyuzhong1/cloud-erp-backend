<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.KingdeeUserRefPostMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.sys.entity.KingdeeUserRefPostEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="erp_user_id" property="erpUserId" />
       <result column="kingdee_post_id" property="kingdeePostId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        erp_user_id, kingdee_post_id
    </sql>
    <!--分页员工-->
    <select id="paging" resultType="com.erp.model.sys.dto.KingdeeUserRefPostDTO$PagingUserViewDTO">
         SELECT
             su.uid AS id,
             su.user_name AS userName,
             su.real_name AS realName,
             su.mobile,
             su.code
        FROM sys_user_info  su
        WHERE su.user_state = 1 AND su.delete_state=1
        AND su.user_type='erp'
        AND
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            ${params.sqlMap.default}
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        su.uid desc
    </select>


</mapper>
