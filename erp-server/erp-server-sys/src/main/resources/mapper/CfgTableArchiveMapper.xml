<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.CfgTableArchiveMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.sys.entity.CfgTableArchiveEntity">
        <result column="id" property="id" />
        <result column="create_user_id" property="createUserId" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_time" property="createTime" />
        <result column="update_user_id" property="updateUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_time" property="updateTime" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="biz_name" property="bizName" />
        <result column="system_code" property="systemCode" />
        <result column="table_name" property="tableName" />
        <result column="time_field" property="timeField" />
        <result column="retention_day" property="retentionDay" />
        <result column="limit_count" property="limitCount" />
        <result column="ext_sql" property="extSql" />
    </resultMap>

    <select id="paging" resultType="com.erp.model.sys.dto.CfgTableArchiveDTO$ListDTO">
        SELECT
            id, biz_name, system_code, table_name, time_field,
            retention_day, limit_count, ext_sql,
            create_user_name, create_time, update_user_name, update_time
        FROM cfg_table_archive
        WHERE is_deleted = false
        <if test="params.bizName != null and params.bizName != ''">
            AND biz_name LIKE CONCAT('%', #{params.bizName}, '%')
        </if>
        <if test="params.systemCode != null and params.systemCode != ''">
            AND system_code = #{params.systemCode}
        </if>
        <if test="params.tableName != null and params.tableName != ''">
            AND table_name LIKE CONCAT('%', #{params.tableName}, '%')
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
