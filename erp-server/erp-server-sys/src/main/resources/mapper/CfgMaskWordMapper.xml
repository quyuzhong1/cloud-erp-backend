<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.CfgMaskWordMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.sys.entity.CfgMaskWordEntity">
        <result column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="word_type" property="wordType"/>
        <result column="category" property="category"/>
        <result column="word" property="word"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <resultMap id="ListMap" type="com.erp.model.sys.dto.CfgMaskWordDTO$ListDTO">
        <result column="id" property="id"/>
        <result column="word_type" property="wordType"/>
        <result column="category" property="category"/>
        <result column="word" property="word"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user_name" property="updateUserName"/>
    </resultMap>

    <sql id="BaseColumns">
        id, word_type, category, word, enabled, remark,
        version, create_time, create_user_id, create_user_name,
        update_time, update_user_id, update_user_name, is_deleted
    </sql>

    <select id="paging" resultMap="ListMap">
        SELECT
        id, word_type, category, word, enabled, remark,
        version, create_time, create_user_name, update_time, update_user_name
        FROM cfg_mask_word
        WHERE is_deleted = false
        <if test="params != null">
            <if test="params.wordType != null">
                AND word_type = #{params.wordType}
            </if>
            <if test="params.category != null and params.category != ''">
                AND category LIKE CONCAT('%', #{params.category}, '%')
            </if>
            <if test="params.word != null and params.word != ''">
                AND word LIKE CONCAT('%', #{params.word}, '%')
            </if>
            <if test="params.enabled != null">
                AND enabled = #{params.enabled}
            </if>
        </if>
        ORDER BY update_time DESC
    </select>

    <select id="listAllAlive" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM cfg_mask_word
        WHERE is_deleted = false AND enabled = true
    </select>

</mapper>
