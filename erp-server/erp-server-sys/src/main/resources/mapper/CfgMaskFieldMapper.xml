<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.CfgMaskFieldMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.sys.entity.CfgMaskFieldEntity">
        <result column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="class_path" property="classPath"/>
        <result column="field_name" property="fieldName"/>
        <result column="strategy" property="strategy"/>
        <result column="custom_regex" property="customRegex"/>
        <result column="custom_replace" property="customReplace"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="hide_when_masked" property="hideWhenMasked"/>
        <result column="disabled" property="disabled"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <resultMap id="ListMap" type="com.erp.model.sys.dto.CfgMaskFieldDTO$ListDTO">
        <result column="id" property="id"/>
        <result column="class_path" property="classPath"/>
        <result column="field_name" property="fieldName"/>
        <result column="strategy" property="strategy"/>
        <result column="custom_regex" property="customRegex"/>
        <result column="custom_replace" property="customReplace"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="hide_when_masked" property="hideWhenMasked"/>
        <result column="disabled" property="disabled"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user_name" property="updateUserName"/>
    </resultMap>

    <sql id="BaseColumns">
        id, class_path, field_name, strategy, custom_regex, custom_replace, permission_code,
        hide_when_masked, disabled, sort, remark, version, create_time, create_user_id, create_user_name,
        update_time, update_user_id, update_user_name, is_deleted
    </sql>

    <select id="paging" resultMap="ListMap">
        SELECT
        id, class_path, field_name, strategy, custom_regex, custom_replace, permission_code,
        hide_when_masked, disabled, sort, remark, version, create_time, create_user_name, update_time,
        update_user_name
        FROM cfg_mask_field
        WHERE is_deleted = false
        <if test="params != null">
            <if test="params.classPath != null and params.classPath != ''">
                AND class_path LIKE CONCAT('%', #{params.classPath}, '%')
            </if>
            <if test="params.fieldName != null and params.fieldName != ''">
                AND field_name LIKE CONCAT('%', #{params.fieldName}, '%')
            </if>
            <if test="params.strategy != null and params.strategy != ''">
                AND strategy = #{params.strategy}
            </if>
            <if test="params.permissionCode != null and params.permissionCode != ''">
                AND permission_code = #{params.permissionCode}
            </if>
            <if test="params.hideWhenMasked != null">
                AND hide_when_masked = #{params.hideWhenMasked}
            </if>
            <if test="params.disabled != null">
                AND disabled = #{params.disabled}
            </if>
        </if>
        ORDER BY sort ASC, update_time DESC
    </select>

    <select id="listAllAlive" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM cfg_mask_field
        WHERE is_deleted = false AND COALESCE(disabled, false) = false
        ORDER BY sort ASC, update_time DESC, id ASC
    </select>

</mapper>
