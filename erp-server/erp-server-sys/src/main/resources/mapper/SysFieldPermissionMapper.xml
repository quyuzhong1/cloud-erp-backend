<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.sys.mapper.SysFieldPermissionMapper">

    <resultMap id="ListVOMap" type="com.erp.model.sys.dto.SysFieldPermissionDTO$ListVO">
        <result column="menu_id" property="menuId"/>
        <result column="menu_code" property="menuCode"/>
        <result column="menu_name" property="menuName"/>
        <result column="parent_menu_name" property="parentMenuName"/>
        <result column="system" property="system"/>
        <result column="visible" property="visible"/>
    </resultMap>

    <!--
        列出所有 type=5（字段权限码）菜单 + 当前角色是否拥有
        - parent_menu_name：来自 LEFT JOIN sys_menu pm，方便前端按业务模块分组展示
        - visible：当前角色 sys_role_menu 是否挂了这个 menu_id
        - boundFields 在 ServiceImpl 一次性反查 cfg_mask_field 拼装，避免依赖自定义 typeHandler
    -->
    <select id="listFieldPermissionForRole" resultMap="ListVOMap">
        SELECT
            m.menu_id,
            m.menu_code,
            m.menu_name,
            m.system,
            pm.menu_name AS parent_menu_name,
            EXISTS (
                SELECT 1 FROM sys_role_menu rm
                 WHERE rm.role_id = #{roleId}
                   AND rm.menu_id = m.menu_id
                   AND rm.is_deleted = false
            ) AS visible
        FROM sys_menu m
        LEFT JOIN sys_menu pm
               ON pm.menu_id = m.parent_id
              AND pm.is_deleted = false
        WHERE m.type = 5
          AND m.is_deleted = false
          AND m.disabled = false
        <if test="system != null and system != ''">
            AND m.system = #{system}
        </if>
        ORDER BY m.system, pm.menu_name, m.index, m.menu_code
    </select>

    <select id="findFieldPermissionMenuIds" resultType="String">
        SELECT menu_id
          FROM sys_menu
         WHERE type = 5
           AND is_deleted = false
    </select>

</mapper>
