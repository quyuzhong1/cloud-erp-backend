<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.InitFirstMileAllocationDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.InitFirstMileAllocationDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="source_id" property="sourceId" />
       <result column="source_detail_id" property="sourceDetailId" />
       <result column="source_code" property="sourceCode" />
       <result column="source_type" property="sourceType" />
       <result column="business_code" property="businessCode" />
       <result column="business_type" property="businessType" />
       <result column="shop_id" property="shopId" />
       <result column="shop_name" property="shopName" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="warehouse_name" property="warehouseName" />
       <result column="sku_no" property="skuNo" />
       <result column="sku_id" property="skuId" />
        <result column="platform_sku_no" property="platformSkuNo" />
       <result column="product_name" property="productName" />
       <result column="init_receive_qty" property="initReceiveQty" />
       <result column="init_transit_cost" property="initTransitCost" />
       <result column="init_transit_tariff" property="initTransitTariff" />
       <result column="init_estimated_cost" property="initEstimatedCost" />
       <result column="init_estimated_tariff" property="initEstimatedTariff" />
       <result column="weight_allocation" property="weightAllocation" />
       <result column="product_cost" property="productCost" />
       <result column="exchange_rate" property="exchangeRate" />
       <result column="weight_unit" property="weightUnit" />
       <result column="currency" property="currency" />
       <result column="currency_symbol" property="currencySymbol" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, source_id, source_detail_id, source_code, source_type, business_code, business_type, shop_id, shop_name,
        warehouse_id, warehouse_name, platform_sku_no,sku_no, sku_id, product_name, init_receive_qty, init_transit_cost, init_transit_tariff,
        init_estimated_cost,init_estimated_tariff,
        weight_allocation, product_cost, exchange_rate, weight_unit, currency, currency_symbol
    </sql>
    <select id="listBySourceIds" resultType="com.erp.model.tms.entity.InitFirstMileAllocationDetailEntity">
        select
            ad.*
        from init_first_mile_allocation_detail ad
        left join init_first_mile_allocation a on ad.main_id = a.id and a.is_deleted = false
        where ad.is_deleted = false
        <if test="status != null and status != ''">
            and a.status = #{status}
        </if>
        <if test="sourceIds != null and sourceIds.size > 0">
            and ad.source_id in
            <foreach collection="sourceIds" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
    </select>


</mapper>
