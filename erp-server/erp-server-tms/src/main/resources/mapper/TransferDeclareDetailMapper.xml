<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.TransferDeclareDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.TransferDeclareDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="so_id" property="soId" />
       <result column="so_code" property="soCode" />
       <result column="logistics_channel_id" property="logisticsChannelId" />
       <result column="logistics_channel_name" property="logisticsChannelName" />
       <result column="tracking_no" property="trackingNo" />
       <result column="package_weight" property="packageWeight" />
       <result column="weight_unit" property="weightUnit" />
       <result column="outstock_status" property="outstockStatus" />
       <result column="transfer_staus" property="transferStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, so_id, so_code, logistics_channel_id, logistics_channel_name, track_no, package_weight, weight_unit, outstock_status, transfer_staus
    </sql>

    <!--详情明细高级查询-->
    <select id="viewDetailList" resultType="com.erp.model.tms.dto.TransferDeclareDetailDTO$ViewDTO">
        SELECT
            tdd.id,
            tdd.main_id,
            tdd.so_id,
            tdd.so_code,
            tdd.logistics_channel_id,
            tdd.logistics_channel_name,
            tdd.track_no,
            tdd.package_weight,
            tdd.weight_unit,
            tdd.outstock_status,
            tdd.transfer_status,
            tdd.order_upload_status
        FROM transfer_declare_detail tdd
        INNER JOIN transfer_declare td ON tdd.main_id = td.id AND tdd.is_deleted = FALSE
        WHERE td.is_deleted = FALSE
        <!--主标id-->
        <if test="params.mainId != '' and params.mainId != null">
            and tdd.main_id = #{params.mainId}
        </if>
        <!--物流跟踪号-->
        <if test="params.trackNo != '' and params.trackNo != null">
            and tdd.track_no ILIKE concat('%', #{params.trackNo}::text,'%')
        </if>
        <!--销售单号-->
        <if test="params.soCode != '' and params.soCode != null">
            and tdd.so_code ILIKE concat('%', #{params.soCode}::text,'%')
        </if>
        <!--物流渠道id-->
        <if test="params.logisticsChannelIdList != null and params.logisticsChannelIdList.size > 0">
            and tdd.logistics_channel_id in
            <foreach collection="params.logisticsChannelIdList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>
</mapper>
