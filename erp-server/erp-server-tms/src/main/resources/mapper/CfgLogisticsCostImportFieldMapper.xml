<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.CfgLogisticsCostImportFieldMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.CfgLogisticsCostImportFieldEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="sys_classify" property="sysClassify" />
       <result column="bussiness_type" property="bussinessType" />
       <result column="table_name" property="tableName" />
       <result column="table_cn_name" property="tableCnName" />
       <result column="class_path" property="classPath" />
       <result column="parent_id" property="parentId" />
       <result column="field" property="field" />
       <result column="field_name" property="fieldName" />
       <result column="field_type" property="fieldType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        sys_classify, bussiness_type, table_name, table_cn_name, class_path, parent_id, field, field_name, field_type
    </sql>

    <select id="paging" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportFieldDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_logistics_cost_import_field where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportFieldDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportFieldDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  cfg_logistics_cost_import_field
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
