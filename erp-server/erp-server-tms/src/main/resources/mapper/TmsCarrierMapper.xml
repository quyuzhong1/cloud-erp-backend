<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.TmsCarrierMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.TmsCarrierEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="logistics_track_url" property="logisticsTrackUrl" />
       <result column="name" property="name" />
       <result column="sales_platform" property="salesPlatform" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, logistics_track_url, name, sales_platform
    </sql>
    <select id="pagingSelect" resultType="com.common.business.dto.base.BaseDropDownDTO$CommonDTO">
        select id,code,name as value
        from
        (
            select
            lc.id,
            lc.code,
            lc.name
            from tms_carrier lc
            where
            lc.is_deleted = false
            <if test="params.searchKeyword != null and params.searchKeyword != ''">
                and lc.name ilike concat('%', #{params.searchKeyword}::text ,'%')
            </if>
            <if test="params.salesPlatform != null and params.salesPlatform != ''">
                and lc.sales_platform=#{params.salesPlatform}
            </if>
            order by
            <if test="params.searchKeyword != null and params.searchKeyword != ''">
                case when lc.name ILIKE concat(#{params.searchKeyword}::text,'%') THEN 1
                when lc.name ILIKE concat('%',#{params.searchKeyword}::text) THEN 2
                when lc.name ILIKE concat('%',#{params.searchKeyword}::text,'%') THEN 3
                end , lc.name,
            </if>
            lc.update_time desc
        ) wls
    </select>


</mapper>
