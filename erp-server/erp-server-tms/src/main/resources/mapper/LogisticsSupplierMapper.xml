            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ls.create_time DESC

    </select>

    <!--导出-->
    <select id="listExport" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$PagingViewDTO">
        SELECT
            id,
            create_user_name,
            create_time,
            update_user_name,
            update_time,
            supplier_id,
            supplier_name,
            supplier_name AS name,
            type,
            disabled,
            auth_status,
            auth_time
        FROM logistics_supplier ls
        WHERE is_deleted=FALSE
        <choose>
            <when test="params.ids!=null and params.ids.size>0">
                AND ls.id IN
                <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                <if test="params.name !=null and params.name!='' ">
                    AND ls.supplier_name ILIKE concat('%',#{params.name}::text,'%')
                </if>
                <if test="params.type !=null and params.type!='' ">
                    AND ls.type =#{params.type}
                </if>
                <!--授权状态-->
                <if test="params.authStatusList!=null and params.authStatusList.size>0">
                    AND ls.auth_status IN
                    <foreach collection="params.authStatusList" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <!--启用状态-->
                <if test="params.disabledList!=null and params.disabledList.size>0">
                    AND ls.disabled IN
                    <foreach collection="params.disabledList" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <!--创建时间-->
                <if test="params.createTimeList !=null and params.createTimeList.size>0">
                    AND ls.create_time >= #{params.createTimeList[0]} and
                    (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > ls.create_time
                </if>
                <!--更新时间-->
                <if test="params.updateTimeList !=null and params.updateTimeList.size>0">
                    AND ls.update_time >= #{params.updateTimeList[0]} and
                    (#{params.updateTimeList[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > ls.update_time
                </if>
            </otherwise>
        </choose>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ls.create_time DESC
    </select>
    <select id="getLogisticsSupplierAuthById" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$AuthDTO">
        SELECT
            ls.id,
            ls.create_user_name,
            ls.create_time,
            ls.update_user_name,
            ls.update_time,
            ls.supplier_id,
            ls.supplier_name,
            ls.type,
            ls.disabled,
            ls.auth_status,
            ls.auth_time,
            la.logistics_platform,
            la.id AS authId
        FROM logistics_supplier ls
        LEFT JOIN logistics_auth la
        ON ls.id=la.main_id and la.is_deleted=false
        where la.is_deleted=false AND ls.id=#{id}
    </select>

    <!-- 根据物流商查询渠道 -->
    <select id="listLogisticsChannel" resultMap="listChannelMap">
        select
               ls.id as logisticsSupplierId,
               ls.supplier_name as logisticsSupplierName,
               ls.disabled,
               lc.id as logisticsChannelId,
               lc.name as logisticsChannelName,
               lc.disabled as channelDisabled
        from logistics_supplier ls
        inner join logistics_channel lc on ls.id = lc.main_id and lc.is_deleted = false
        <where>
            ls.is_deleted = false and ls.id in
            <foreach collection="logisticsSupplierIdList" separator="," item="item" open="(" close=")">
                #{item}
            </foreach>
        </where>
        order by lc.disabled
    </select>
    <select id="detail" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$ViewDTO">
        select
            ls.id,
            ls.supplier_id,
            ls.supplier_name,
            ls.short_name,
            ls.type
        from logistics_supplier ls
        where id = #{id}
    </select>


</mapper>
