<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.LogisticsSupplierMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.LogisticsSupplierEntity">
        <result column="id" property="id"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="supplier_name" property="supplierName"/>
        <result column="type" property="type"/>
        <result column="disabled" property="disabled"/>
        <result column="auth_status" property="authStatus"/>
        <result column="auth_time" property="authTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        ,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        supplier_id, supplier_name, type, disabled, auth_status, auth_time
    </sql>
    <!--tab 页数据统计-->
    <select id="tabList" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$TabListDTO">
        SELECT
        COUNT(id) AS count,
        type AS tabFlag
        FROM logistics_supplier
        <if test="permissionSql!=null and permissionSql!=''">
            ${permissionSql}
        </if>
        WHERE is_deleted=FALSE
        GROUP BY type

    </select>
    <!--分页-->
    <select id="paging" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$PagingViewDTO">
        SELECT
        id,
        create_user_name AS createUserName,
        create_time AS createTime ,
        update_user_name AS updateUserName,
        update_time AS updateTime,
        supplier_id AS supplierId ,
        supplier_name AS name,
        type AS type,
        disabled ,
        auth_status AS authStatus ,
        auth_time AS authTime
        FROM logistics_supplier ls
        WHERE is_deleted=FALSE
        <if test="params.name !=null and params.name!='' ">
            AND ls.supplier_name ILIKE concat('%', #{params.name} ,'%')
        </if>
        <if test="params.type !=null and params.type!='' ">
            AND ls.type =#{params.type}
        </if>
        <!--创建人-->
        <if test="params.createUserIdList!=null and params.createUserIdList.size>0">
            AND ls.create_user_id IN
            <foreach collection="params.createUserIdList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <!--授权状态-->
        <if test="params.authStatusList!=null and params.authStatusList.size>0">
            AND ls.auth_status IN
            <foreach collection="params.authStatusList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <!--启用状态-->
        <if test="params.disabledList!=null and params.disabledList.size>0">
            AND ls.disabled IN
            <foreach collection="params.disabledList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <!--创建时间-->
        <if test="params.createTimeList !=null and params.createTimeList.size>0">
            AND ls.create_time >= #{params.createTimeList[0]} and
            (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > ls.create_time
        </if>
        <!--更新时间-->
        <if test="params.updateTimeList !=null and params.updateTimeList.size>0">
            AND ls.update_time >= #{params.updateTimeList[0]} and
            (#{params.updateTimeList[1]}::TIMESTAMP + INTERVAL '1
            DAY' ) > ls.update_time
        </if>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ls.create_time DESC

    </select>

    <!--导出-->
    <select id="listExport" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$PagingViewDTO">
        SELECT
            id,
            create_user_name,
            create_time,
            update_user_name,
            update_time,
            supplier_id,
            supplier_name,
            supplier_name AS name,
            type,
            disabled,
            auth_status,
            auth_time
        FROM logistics_supplier ls
        WHERE is_deleted=FALSE
        <choose>
            <when test="params.ids!=null and params.ids.size>0">
                AND ls.id IN
                <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                <if test="params.name !=null and params.name!='' ">
                    AND ls.supplier_name ILIKE concat('%', #{params.address} ,'%')
                </if>
                <if test="params.type !=null and params.type!='' ">
                    AND ls.type =#{params.type}
                </if>
                <!--授权状态-->
                <if test="params.authStatusList!=null and params.authStatusList.size>0">
                    AND ls.auth_status IN
                    <foreach collection="params.authStatusList" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <!--启用状态-->
                <if test="params.disabledList!=null and params.disabledList.size>0">
                    AND ls.disabled IN
                    <foreach collection="params.disabledList" item="item" open="(" separator="," close=")">
                        #{item}
                    </foreach>
                </if>
                <!--创建时间-->
                <if test="params.createTimeList !=null and params.createTimeList.size>0">
                    AND ls.create_time >= #{params.createTimeList[0]} and
                    (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > ls.create_time
                </if>
                <!--更新时间-->
                <if test="params.updateTimeList !=null and params.updateTimeList.size>0">
                    AND ls.update_time >= #{params.updateTimeList[0]} and
                    (#{params.update_time[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > ls.update_time
                </if>
            </otherwise>
        </choose>
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ls.create_time DESC
    </select>
    <select id="getLogisticsSupplierAuthById" resultType="com.erp.model.tms.dto.LogisticsSupplierDTO$AuthDTO">
        SELECT
            ls.id,
            ls.create_user_name,
            ls.create_time,
            ls.update_user_name,
            ls.update_time,
            ls.supplier_id,
            ls.supplier_name,
            ls.supplier_name,
            ls.type,
            ls.disabled,
            ls.auth_status,
            ls.auth_time,
            la.logistics_platform,
            la.id AS authId
        FROM logistics_supplier ls
        LEFT JOIN logistics_auth la
        INNER JOIN ls.id=la.main_id and la.is_deleted=false
        where ls.id=#{id}
    </select>


</mapper>
