<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.TransferDeclareCostAllocationMainMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.TransferDeclareCostAllocationMainEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="transfer_declare_id" property="transferDeclareId" />
       <result column="declare_reconciliation_detail_id" property="declareReconciliationDetailId" />
       <result column="report_date" property="reportDate" />
       <result column="account_date" property="accountDate" />
       <result column="report_status" property="reportStatus" />
       <result column="big_table_status" property="bigTableStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        transfer_declare_id, declare_reconciliation_detail_id, report_date, account_date, report_status, big_table_status
    </sql>

    <!-- 游标分批查主表ID：直查主表，前置过滤掉会立即失败的记录，减少无效子任务 -->
    <select id="pageMainIdsByReportPeriodStr" resultType="java.lang.String">
        SELECT tdcam.id
        FROM transfer_declare_cost_allocation_main tdcam
        WHERE tdcam.is_deleted = false
          AND tdcam.report_date = #{reportPeriodStr}
        <if test="reportStatus != null and reportStatus != ''">
            AND tdcam.report_status != #{reportStatus}
        </if>
        <if test="excludeBigTableDone">
            AND (tdcam.big_table_status IS NULL OR tdcam.big_table_status != #{bigTableDoneCode})
        </if>
        <if test="lastId != null and lastId != ''">
            AND tdcam.id &gt; #{lastId}
        </if>
        ORDER BY tdcam.id ASC
        LIMIT #{batchSize}
    </select>

    <!-- COUNT 预估总量，与游标查询同过滤条件 -->
    <select id="countMainByReportPeriodStr" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM transfer_declare_cost_allocation_main tdcam
        WHERE tdcam.is_deleted = false
          AND tdcam.report_date = #{reportPeriodStr}
        <if test="reportStatus != null and reportStatus != ''">
            AND tdcam.report_status != #{reportStatus}
        </if>
        <if test="excludeBigTableDone">
            AND (tdcam.big_table_status IS NULL OR tdcam.big_table_status != #{bigTableDoneCode})
        </if>
    </select>

</mapper>
