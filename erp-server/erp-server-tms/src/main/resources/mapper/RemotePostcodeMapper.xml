<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.RemotePostcodeMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.RemotePostcodeEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="approve_status" property="approveStatus" />
       <result column="code" property="code" />
       <result column="name" property="name" />
       <result column="remark" property="remark" />
       <result column="disabled" property="disabled" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        rp.id,
        rp.create_user_id,
        rp.create_user_name,
        rp.create_time,
        rp.update_user_id,
        rp.update_user_name,
        rp.update_time,
        rp.version,
        rp.is_deleted,
        rp.name,
        rp.remark,
        rp.disabled
    </sql>

    <select id="paging" resultType="com.erp.model.tms.dto.RemotePostcodeDTO$ListDTO">
        select
        <include refid="Base_Column_List"></include>
            from  remote_postcode as rp
        WHERE rp.is_deleted=FALSE
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            and ${params.sqlMap.default}
        </if>
        order by rp.create_time desc
    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from remote_postcode where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.tms.dto.RemotePostcodeDTO$ExportListDTO">
        SELECT
            rp.ID,
            rp.update_user_id,
            rp.update_user_name,
            rp.update_time,
            rp.NAME,
            rp.remark,
            rp.disabled,
            rpd.country,
            rpd.city,
            rpd.match_type,
            rpd.post_code
        FROM
            remote_postcode AS rp
            INNER JOIN remote_postcode_detail AS rpd on rp.id = rpd.main_id and rpd.is_deleted =FALSE
        WHERE
            rp.is_deleted = FALSE
            <if test="param.ids != null and param.ids.size != ''">
                and rp.id in
                <foreach collection="param.ids" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
            <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
                and ${params.sqlMap.default}
            </if>
        order by rp.create_time desc
    </select>

    <select id="tabList" resultType="com.erp.model.tms.dto.RemotePostcodeDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  remote_postcode
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
