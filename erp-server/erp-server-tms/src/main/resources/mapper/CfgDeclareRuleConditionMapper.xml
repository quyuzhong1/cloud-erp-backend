<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.CfgDeclareRuleConditionMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.CfgDeclareRuleConditionEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="rule_id" property="ruleId" />
       <result column="left_bracket" property="leftBracket" />
       <result column="field" property="field" />
       <result column="compare" property="compare" />
       <result column="value" property="value" />
       <result column="name" property="name" />
       <result column="right_bracket" property="rightBracket" />
       <result column="logic" property="logic" />
       <result column="index" property="index" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        rule_id, left_bracket, field, compare, value, name, right_bracket, logic, index
    </sql>

    <select id="paging" resultType="com.erp.model.tms.dto.CfgDeclareRuleConditionDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_declare_rule_condition where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.tms.dto.CfgDeclareRuleConditionDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.tms.dto.CfgDeclareRuleConditionDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  cfg_declare_rule_condition
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
