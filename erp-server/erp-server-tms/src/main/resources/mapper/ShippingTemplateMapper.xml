<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.ShippingTemplateMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.ShippingTemplateEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="billing_method" property="billingMethod" />
       <result column="currency" property="currency" />
       <result column="weight_unit" property="weightUnit" />
       <result column="price_binary" property="priceBinary" />
       <result column="volume_setting" property="volumeSetting" />
       <result column="effective_date" property="effectiveDate" />
       <result column="expire_date" property="expireDate" />
       <result column="disabled" property="disabled" />
       <result column="type" property="type" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        st.id,
        st.create_user_id as createUserId,
        st.create_user_name as createUserName,
        st.create_time as createTime,
        st.update_user_id as updateUserId,
        st.update_user_name as updateUserName,
        st.update_time as updateTime,
        st.version,
        st.is_deleted as isDeleted,
        st.name,
        st.billing_method as billingMethod,
        st.currency,
        st.weight_unit as weightUnit,
        st.price_binary as priceBinary,
        st.volume_setting as volumeSetting,
        st.effective_date as effectiveDate,
        st.expire_date as expireDate,
        st.disabled,
        st.type
    </sql>

    <!-- 分页查询 -->
    <select id="paging" resultType="com.erp.model.tms.dto.ShippingTemplateDTO$ListDTO">
        select
               <include refid="Base_Column_List"/>
        from
        shipping_template st
        <where>
            st.is_deleted = false
            <if test="params.name != null and params.name != ''">
                st.name ilike concat('%',#{params.name},'%')
            </if>
            <if test="params.disabled != null">
                st.disabled = #{params.disabled}
            </if>
            <if test="params.effectiveDateList != null and params.effectiveDateList.size != ''">
                and st.effective_date >= #{params.effectiveDateList[0]} and (#{params.effectiveDateList[1]}::TIMESTAMP + INTERVAL '1
                DAY' ) > st.effective_date
            </if>
            <if test="params.expireDateList != null and params.expireDateList.size != ''">
                and st.expire_date >= #{params.expireDateList[0]} and (#{params.expireDateList[1]}::TIMESTAMP + INTERVAL '1
                DAY' ) > st.expire_date
            </if>
            <if test="params.createUserIdList != null and params.createUserIdList.size != ''">
                and st.create_user_id in
                <foreach collection="params.createUserIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createTimeList != null and params.createTimeList.size != ''">
                and st.create_time >= #{params.createTimeList[0]} and (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
                DAY' ) > st.create_time
            </if>
        </where>
    </select>

    <select id="tabList" resultType="com.erp.model.tms.dto.ShippingTemplateDTO$TabListDTO">
        select
            disabled as tabFlag,
            count(id) as count
        from shipping_template st
        where st.is_deleted = false
        <if test="permissionSql!=null and permissionSql!=''">
            ${permissionSql}
        </if>
        group by disabled
    </select>


</mapper>
