<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.CfgLogisticsCostImportMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.CfgLogisticsCostImportEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="bussiness_type" property="bussinessType" />
       <result column="cfg_type" property="cfgType" />
       <result column="dict_platform" property="dictPlatform" />
       <result column="name" property="name" />
       <result column="sheet_name" property="sheetName" />
       <result column="header_row" property="headerRow" />
       <result column="cost_type" property="costType" />
       <result column="import_type" property="importType" />
       <result column="disabled" property="disabled" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, bussiness_type, cfg_type, dict_platform, name, sheet_name, header_row, cost_type, import_type, disabled, remark
    </sql>

    <select id="paging" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_logistics_cost_import where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.tms.dto.CfgLogisticsCostImportDTO$TabListDTO">
        SELECT
        disabled AS tabFlag,
        count(*)  AS count
        FROM  cfg_logistics_cost_import
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY disabled
    </select>

</mapper>
