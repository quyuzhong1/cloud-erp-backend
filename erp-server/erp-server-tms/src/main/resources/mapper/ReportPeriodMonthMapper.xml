<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.ReportPeriodMonthMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.ReportPeriodMonthEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="month" property="month" />
       <result column="org_id" property="orgId" />
       <result column="org_name" property="orgName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        month, org_id, org_name
    </sql>
    <select id="queryList" resultType="com.erp.model.tms.dto.ReportPeriodMonthDTO$SelectDTO">
        select
            rpm.id,
            rpm.org_id,
            rpm.org_name,
            rpm.month as reportPeriodMonth,
            to_char(rpm.month, 'YYYY-MM') AS reportPeriodStr
        FROM report_period_month rpm
        LEFT JOIN first_mile_cost_allocation a on a.report_period_id = rpm.id and a.is_deleted = FALSE
        where rpm.is_deleted = FALSE
          and (a.status is null or a.status != 'confirm')
        <if test="orgIds != null and orgIds.size > 0">
            and rpm.org_id in
            <foreach collection="orgIds" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
    </select>
    <select id="listLocalDate" resultType="com.erp.model.tms.dto.ReportPeriodMonthDTO$ListDTO">
        select
            to_char(month, 'YYYY-MM') AS reportPeriodStr
        FROM report_period_month
        where is_deleted = FALSE
        group by month order by month desc
    </select>


</mapper>
