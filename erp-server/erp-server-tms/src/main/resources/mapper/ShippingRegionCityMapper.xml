<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.ShippingRegionCityMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.ShippingRegionCityEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="shipping_template_rule_id" property="shippingTemplateRuleId" />
       <result column="city" property="city" />
       <result column="region" property="region" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, shipping_template_rule_id, city, region
    </sql>

    <select id="listRegionCity" resultType="java.lang.String">
        select
            src.city
        from shipping_region_city src
        <where>
            src.is_deleted = false
            <if test="params.templateRuleId != null and params.templateRuleId != ''">
              and src.shipping_template_rule_id = #{params.templateRuleId}
            </if>
            <if test="params.region != null and params.region != ''">
              and src.region = #{params.region}
            </if>
        </where>
        where
    </select>

</mapper>
