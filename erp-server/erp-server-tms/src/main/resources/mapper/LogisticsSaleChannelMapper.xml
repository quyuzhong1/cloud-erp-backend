<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.LogisticsSaleChannelMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.LogisticsSaleChannelEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="platform_channel_id" property="platformChannelId" />
       <result column="cn_name" property="cnName" />
       <result column="en_name" property="enName" />
       <result column="code" property="code" />
       <result column="service_platform" property="servicePlatform" />
       <result column="channel_status" property="channelStatus" />
       <result column="supplier_name" property="supplierName" />
       <result column="supplier_code" property="supplierCode" />
       <result column="shipment_method" property="shipmentMethod" />
       <result column="logistics_platform" property="logisticsPlatform" />
       <result column="source_data" property="sourceData" />
       <result column="is_track" property="isTrack" />
       <result column="aging" property="aging" />
       <result column="origin_country" property="originCountry" />
       <result column="destination_country" property="destinationCountry" />
       <result column="overseas_warehouse_id" property="overseasWarehouseId" />
       <result column="platform_warehouse_code" property="platformWarehouseCode" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        platform_channel_id, cn_name, en_name, code,service_platform, channel_status, supplier_name, supplier_code, shipment_method, logistics_platform, source_data, is_track, aging, origin_country, destination_country, overseas_warehouse_id, platform_warehouse_code
    </sql>

    <select id="listByType" resultType="com.erp.model.tms.dto.SaleChannelDTO">
        SELECT
            MAX(id) as id,
            MAX(cn_name) as cnName,
            MAX(platform_channel_id) as platformChannelId,
            code
        FROM
            logistics_sale_channel t
        WHERE
            t.is_deleted = false
            AND t.channel_status = 0
            AND t.logistics_platform = #{platformType}
            AND t.service_platform ILIKE concat('%',#{servicePlatform}::text,'%')
        group by code
    </select>
    <select id="listByLogisticsPlatform" resultType="com.erp.model.tms.entity.LogisticsSaleChannelEntity">
        SELECT
          <include refid="Base_Column_List"/>
        FROM  logistics_sale_channel WHERE logistics_platform=#{logisticsPlatform}
        and service_platform ILIKE concat('%',#{servicePlatform}::text,'%')
    </select>
</mapper>
