<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.CfgConditionMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.CfgConditionEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="condition_field" property="conditionField" />
       <result column="logic" property="logic" />
       <result column="controls" property="controls" />
       <result column="api_url" property="apiUrl" />
       <result column="condition_field_name" property="conditionFieldName" />
       <result column="request_method" property="requestMethod" />
       <result column="param" property="param" />
       <result column="label" property="label" />
       <result column="value" property="value" />
       <result column="index" property="index" />
       <result column="search_key" property="searchKey" />
       <result column="remote_label" property="remoteLabel" />
       <result column="value_type" property="valueType" />
       <result column="rule_type" property="ruleType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        condition_field, logic, controls, api_url, condition_field_name, request_method, param, label, value, index, search_key, remote_label, value_type, rule_type
    </sql>

    <select id="paging" resultType="com.erp.model.tms.dto.CfgConditionDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_condition where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.tms.dto.CfgConditionDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.tms.dto.CfgConditionDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  cfg_condition
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
