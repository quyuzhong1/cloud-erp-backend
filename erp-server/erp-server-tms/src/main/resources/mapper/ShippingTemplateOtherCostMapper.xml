<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.tms.mapper.ShippingTemplateOtherCostMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.tms.entity.ShippingTemplateOtherCostEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="dict_code" property="dictCode" />
       <result column="dict_name" property="dictName" />
       <result column="calculation_method" property="calculationMethod" />
       <result column="calculation_unit" property="calculationUnit" />
       <result column="cost_setting_value" property="costSettingValue" />
       <result column="extend_json" property="extendJson" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, dict_code, dict_name, calculation_method, calculation_unit, cost_setting_value, extend_json, remark
    </sql>
    <!-- 运费计算列表 -->
    <select id="paging" resultType="com.erp.model.tms.dto.ShippingCalculationDTO$ListDTO">
        select
               *
        from logistics_supplier ls
        inner join logistics_channel lc on ls.id = lc.main_id and lc.is_deleted = false
        inner join shipping_template_ref_channel strc on strc.logistics_channel_id = lc.id and strc.is_deleted = false
        inner join shipping_template st on strc.main_id = st.id and st.is_deleted = false
        inner join shipping_template_rule str on str.main_id = st.id on str.is_deleted = false
        <where>
            ls.is_deleted = false

        </where>
    </select>

    <!-- 运费计算导出 -->
    <select id="listByExportExcel" resultType="com.erp.model.tms.dto.ShippingCalculationDTO$ListDTO">

    </select>


</mapper>
