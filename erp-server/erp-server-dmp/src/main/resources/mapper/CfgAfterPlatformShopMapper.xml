<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.mapper.CfgAfterPlatformShopMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.dmp.entity.CfgAfterPlatformShopEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="dict_platform" property="dictPlatform" />
       <result column="platform_name" property="platformName" typeHandler="com.erp.server.dmp.handler.ObjectJsonHandler"/>
       <result column="shop_json" property="shopJson" typeHandler="com.erp.server.dmp.handler.ObjectJsonHandler"/>
       <result column="cs_agent_json" property="csAgentJson" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        dict_platform, platform_name, shop_json, cs_agent_json
    </sql>

    <select id="paging" resultType="com.erp.model.dmp.dto.CfgAfterPlatformShopDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_after_platform_shop where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.dmp.dto.CfgAfterPlatformShopDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.dmp.dto.CfgAfterPlatformShopDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  cfg_after_platform_shop
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
