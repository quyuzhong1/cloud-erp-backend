<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.mapper.DmpCfgInputMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.dmp.entity.DmpCfgInputEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="system_id" property="systemId" />
       <result column="code" property="code" />
       <result column="name" property="name" />
       <result column="type" property="type" />
       <result column="type_id" property="typeId" />
       <result column="disabled" property="disabled" />
       <result column="extend_json" property="extendJson" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        system_id, code, name, type, type_id, disabled, extend_json
    </sql>

    <select id="listDmpCfgInput" resultType="com.erp.model.dmp.dto.DmpCfgInputDTO$ListDmpCfgInputDTO">
        SELECT
            id AS code,
            name
        FROM dmp_cfg_input
        WHERE is_deleted = FALSE
        AND system_id = #{id}
    </select>

    <select id="listBySystemIdAndTaskType" resultType="java.lang.String">
        SELECT
        dci.ID
        FROM
        dmp_cfg_input AS dci
        LEFT JOIN dmp_cfg_input_detail AS dcid ON dci.ID = dcid.main_id
        WHERE
        dci.is_deleted = 'f'
        AND dcid.is_deleted = 'f'
        AND dci.system_id = ''
        AND dicd.task_type IN
        <foreach collection="taskTypeList" item="type" open="(" separator="," close=")">
            #{type}
        </foreach>
        GROUP BY
        dci.ID
    </select>
</mapper>
