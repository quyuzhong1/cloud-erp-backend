<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.mapper.DmpCfgDbMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.dmp.entity.DmpCfgDbEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="system_id" property="systemId" />
       <result column="type" property="type" />
       <result column="db_type" property="dbType" />
       <result column="host" property="host" />
       <result column="port" property="port" />
       <result column="user_name" property="userName" />
       <result column="pass_word" property="passWord" />
       <result column="db_name" property="dbName" />
       <result column="table_name" property="tableName" />
       <result column="disabled" property="disabled" />
       <result column="min_connection_size" property="minConnectionSize" />
       <result column="max_connection_size" property="maxConnectionSize" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        system_id, type, db_type, host, port, user_name, pass_word, db_name, table_name, disabled, min_connection_size, max_connection_size
    </sql>

    <select id="paging" resultType="com.erp.model.dmp.dto.DmpCfgDbDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from dmp_cfg_db where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.dmp.dto.DmpCfgDbDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.dmp.dto.DmpCfgDbDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  dmp_cfg_db
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
