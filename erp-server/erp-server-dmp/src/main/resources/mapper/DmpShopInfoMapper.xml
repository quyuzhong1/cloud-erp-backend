<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.pull.mapper.DmpShopInfoMapper">

    <sql id="Base_Column_List">
        id,platform_shop_no,account_user_name,
        account_store_name,name,site,
        status,platform_name,finance_code,charge_id,charge_name
    </sql>

    <select id="queryShopByPlatformList" resultType="com.erp.model.dmp.dto.ShopDTO">
        SELECT
        <include refid="Base_Column_List"></include>
        FROM dmp_shop_info
    </select>
</mapper>
