<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.mapper.DmpFeishuUserInfoMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.dmp.entity.DmpFeishuUserInfoEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="convert_id" property="convertId" />
       <result column="next_level_id" property="nextLevelId" />
       <result column="unique_encrypt" property="uniqueEncrypt" />
       <result column="data_encrypt" property="dataEncrypt" />
       <result column="input_task_id" property="inputTaskId" />
       <result column="event_id" property="eventId" />
       <result column="event_type" property="eventType" />
       <result column="open_id" property="openId" />
       <result column="union_id" property="unionId" />
       <result column="user_id" property="userId" />
       <result column="name" property="name" />
       <result column="mobile" property="mobile" />
       <result column="gender" property="gender" />
       <result column="email" property="email" />
       <result column="is_resigned" property="isResigned" />
       <result column="data_json" property="dataJson" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        convert_id, next_level_id, unique_encrypt, data_encrypt, input_task_id, event_id, event_type, open_id, union_id, user_id, name, mobile, gender, email, is_resigned, data_json
    </sql>

    <select id="paging" resultType="com.erp.model.dmp.dto.DmpFeishuUserInfoDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from dmp_feishu_user_info where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.dmp.dto.DmpFeishuUserInfoDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.dmp.dto.DmpFeishuUserInfoDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  dmp_feishu_user_info
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
