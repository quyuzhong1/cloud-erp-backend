<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.dmp.mapper.DmpCfgInputDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.dmp.entity.DmpCfgInputDetailEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="next_level_id" property="nextLevelId" />
       <result column="last_time" property="lastTime" />
       <result column="next_time" property="nextTime" />
       <result column="interval_time" property="intervalTime" />
       <result column="override_time" property="overrideTime" />
       <result column="max_retry_count" property="maxRetryCount" />
       <result column="exec_timeout" property="execTimeout" />
       <result column="disabled" property="disabled" />
       <result column="extend_json" property="extendJson" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        main_id, next_level_id, last_time, next_time, interval_time, override_time, max_retry_count, exec_timeout, disabled, extend_json
    </sql>

    <select id="listBySystemCodeAndBillType" resultType="com.erp.model.dmp.dto.DmpInoutDTO$ListDTO">
        SELECT
            dbs.code as systemCode,
            dcid.id as detailId,
            dcid.next_level_id as nextLevelId,
            dcid.main_id as cfgInputId,
            dci.bill_type as billType
        FROM
            "dmp_cfg_input_detail" AS dcid
            INNER JOIN dmp_cfg_input AS dci ON dci.ID = dcid.main_id
            INNER JOIN dmp_basic_system AS dbs ON dbs.ID = dci.system_id
        WHERE
          dcid.is_deleted = FALSE
          AND dci.is_deleted = FALSE
          AND dbs.is_deleted = FALSE
          AND dci.bill_type IN
          <foreach collection="billTypeList" item="t" open="(" close=")">
              #{t}
          </foreach>
          AND dcid.next_level_id IN
          <foreach collection="nextLevelIdList" item="nextLevelId" open="(" close=")">
              #{nextLevelId}
          </foreach>
          AND dbs.code ILIKE ANY ( ARRAY
                <foreach collection="systemCodeList" item="systemCode" open="[" close="]">
                    #{systemCode}
                </foreach>
          )
        GROUP BY
            dbs.code,
            dcid.id,
            dcid.next_level_id,
            dcid.main_id,
            dci.bill_type
    </select>
</mapper>
