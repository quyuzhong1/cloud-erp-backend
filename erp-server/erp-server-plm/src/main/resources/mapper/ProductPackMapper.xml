<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ProductPackMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.ProductPackEntity">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="skuId" column="sku_id" jdbcType="VARCHAR"/>
        <result property="productSize" column="product_size" jdbcType="VARCHAR"/>
        <result property="grossWeight" column="gross_weight" jdbcType="NUMERIC"/>
        <result property="netWeight" column="net_weight" jdbcType="NUMERIC"/>
        <result property="boxSize" column="box_size" jdbcType="VARCHAR"/>
        <result property="boxWeight" column="box_weight" jdbcType="NUMERIC"/>
        <result property="boxQty" column="box_qty" jdbcType="NUMERIC"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="createUserId" column="create_user_id" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="updateUserId" column="update_user_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        product_size,
        gross_weight,net_weight,box_size,
        box_weight,box_qty,create_time,
        create_user_id,update_time,update_user_id
    </sql>

    <select id="list" resultType="com.erp.model.plm.dto.ProductPackShowDTO">
        SELECT
        pp.id
        pd.sku_no,
        pd.id AS sku_id,
        pd.images_url,
        <include refid="Base_Column_List"/>
        FROM product_detail pd
        LEFT JOIN product_pack pp ON pp.sku_id = pd."id"
        WHERE pd.product_id = #{productId}
    </select>
</mapper>
