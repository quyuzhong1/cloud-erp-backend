<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ProductRefLabelMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.ProductRefLabelEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="sku_id" property="skuId" />
       <result column="product_id" property="productId" />
       <result column="label_id" property="labelId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        sku_id, product_id, label_id
    </sql>

    <select id="countByLabelId" resultType="java.lang.Integer">
        select count(1) from product_ref_label where is_deleted = false and label_id = #{labelId}
    </select>

    <select id="getLabelList" resultType="com.erp.model.plm.vo.ProductRefLabelVO">
        SELECT
            prd.id,
            prd.sku_id,
            prd.product_id,
            prd.label_id,
            bl."name",
            bl."level",
            bl.color
        FROM
            product_ref_label prd
                LEFT JOIN basic_label bl ON bl.id = prd.label_id and bl.is_deleted = false
        WHERE prd.is_deleted = false
        <if test="productId != null and productId != ''">
            AND prd.product_id = #{productId}
        </if>
        <if test="skuId != null and skuId != ''">
            AND prd.sku_id = #{skuId}
        </if>
        <if test="labelId != null and labelId != ''">
            AND prd.label_id = #{labelId}
        </if>
    </select>

    <select id="getLabelListByIds" resultType="com.erp.model.plm.vo.ProductRefLabelVO">
        SELECT
        prd.id,
        prd.sku_id,
        prd.product_id,
        prd.label_id,
        bl."name",
        bl."level",
        bl.color
        FROM
        product_ref_label prd
        LEFT JOIN basic_label bl ON bl.id = prd.label_id and bl.is_deleted = false
        WHERE prd.is_deleted = false
        <if test="productIds != null and productIds.size>0">
            AND prd.product_id IN
            <foreach collection="productIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="skuIds != null and skuIds.size>0">
            AND prd.sku_id IN
            <foreach collection="skuIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="labelIds != null and labelIds.size>0">
            AND prd.label_id IN
            <foreach collection="labelIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>

</mapper>
