<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ProductPurchaseMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.ProductPurchaseEntity">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="skuId" column="sku_id" jdbcType="VARCHAR"/>
        <result property="ean" column="ean" jdbcType="INTEGER"/>
        <result property="planOrderQty" column="plan_order_qty" jdbcType="INTEGER"/>
        <result property="placeOrderTime" column="place_order_time" jdbcType="DATE"/>
        <result property="planArrivalTime" column="plan_arrival_time" jdbcType="DATE"/>
        <result property="moq" column="moq" jdbcType="INTEGER"/>
        <result property="deliveryCycle" column="delivery_cycle" jdbcType="NUMERIC"/>
        <result property="actualArrivalTime" column="actual_arrival_time" jdbcType="DATE"/>
        <result property="arrivalState" column="arrival_state" jdbcType="INTEGER"/>
        <result property="purchaseUserId" column="purchase_user_id" jdbcType="VARCHAR"/>
        <result property="mainSupplier" column="main_supplier" jdbcType="VARCHAR"/>
        <result property="secondSupplier" column="second_supplier" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="createUserId" column="create_user_id" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="updateUserId" column="update_user_id" jdbcType="VARCHAR"/>
        <result property="actualArrivalQty" column="actual_arrival_qty" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,sku_id,ean,
        plan_order_qty,place_order_time,plan_arrival_time,
        moq,delivery_cycle,actual_arrival_time,
        arrival_state,purchase_user_id,main_supplier_id,
        second_supplier_id,create_time,create_user_id,
        update_time,update_user_id,actual_arrival_qty
    </sql>

    <select id="list" resultType="com.erp.model.plm.dto.ProductPurchaseShowDTO">
        SELECT
        pd.sku,
        pd.images_url,
        <include refid="Base_Column_List"/>
        FROM product_detail pd
        LEFT JOIN product_purchase pp ON pp.sku_id = pd."id"
        WHERE pd.product_id = #{productId}
    </select>
</mapper>
