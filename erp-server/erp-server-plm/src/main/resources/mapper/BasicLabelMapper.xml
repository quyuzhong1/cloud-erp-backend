<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.BasicLabelMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.BasicLabelEntity">
        <result column="id" property="id"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="level" property="level"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, type, color, level
    </sql>

    <select id="listByCondition" resultType="com.erp.model.plm.vo.LabelBasicVO">
        SELECT id,name,color,level,index FROM basic_label
        WHERE is_deleted=false
        <if test="params.searchKeyword != null and params.searchKeyword != ''">
            AND name ILIKE concat('%',#{params.searchKeyword}::text,'%')
        </if>
        <if test="params.level != null and params.level == 'private'">
            AND level = #{params.level} AND create_user_id = #{params.createUserId}
        </if>
        <if test="params.level != null and params.level == 'company'">
            AND level = #{params.level}
        </if>
        <if test="params.level == null or params.level == ''">
            AND (level = 'company' OR (level = 'private' AND create_user_id = #{params.createUserId}))
        </if>
        ORDER BY index ASC
    </select>
</mapper>
