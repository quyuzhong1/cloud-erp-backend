<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ProductCostMapper">

    <sql id="Base_Column_List">
        tax_rate,
        target_tax_cost,
        target_no_tax_cost,actual_tax_cost,actual_no_tax_cost,
        retail_price,target_gpm,actual_gpm_cny,
        actual_gpm_usd,pd.create_time,pd.create_user_id,
        pd.create_user_name,pd.update_time,pd.update_user_id,
        pd.update_user_name,project_approval_cost,mass_cost,project_cost
    </sql>

    <select id="list" resultType="com.erp.model.plm.dto.ProductCostShowDTO">
        SELECT
        pc.id,
        pd.sku_no,
        pd.id AS sku_id,
        pd.images_url,
        <include refid="Base_Column_List"/>
        FROM product_detail pd
        LEFT JOIN product_cost pc ON pc.sku_id = pd."id"
        WHERE pd.product_id = #{productId} AND pd.is_deleted = FALSE
        ORDER BY pd.id desc
    </select>
</mapper>
