<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.OperateLogMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.OperateLogEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="module_type" property="moduleType" />
       <result column="field_name" property="fieldName" />
       <result column="business_id" property="businessId" />
       <result column="old_value" property="oldValue" />
       <result column="new_value" property="newValue" />
       <result column="content" property="content" />
       <result column="operation" property="operation" />
       <result column="pid" property="pid" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        module_type, field_name, business_id, old_value, new_value, content, operation, pid
    </sql>
    <select id="paging" resultType="com.erp.model.plm.dto.OperateLogDTO$ListDTO">
        select
        ol.module_type,
        ol.business_id,
        ol.create_time,
        max(ol.create_user_name) as create_user_name,
        array_to_string(array_agg(DISTINCT ol.operation),',') as operation,
        array_to_string(array_agg(DISTINCT ol.content),',') as content
        from operate_log ol
        <where>
            <if test="params.businessId !=null and params.businessId!=''">
                AND ol.business_id = #{params.businessId}
            </if>
            <if test="params.pid !=null and params.pid!=''">
                AND ol.pid = #{params.pid}
            </if>
        </where>
        group by ol.module_type,ol.business_id,ol.create_time
        order by ol.create_time desc
    </select>

</mapper>
