<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ProductLogisticsMapper">

    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.ProductLogisticsEntity">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="skuId" column="sku_id" jdbcType="VARCHAR"/>
        <result property="productProperty" column="product_property" jdbcType="VARCHAR"/>
        <result property="productPropertyId" column="product_property_id" jdbcType="VARCHAR"/>
        <result property="declareChineseName" column="declare_chinese_name" jdbcType="VARCHAR"/>
        <result property="declareEnglishName" column="declare_english_name" jdbcType="VARCHAR"/>
        <result property="declarePrice" column="declare_price" jdbcType="NUMERIC"/>
        <result property="customsCode" column="customs_code" jdbcType="VARCHAR"/>
        <result property="declareElement" column="declare_element" jdbcType="VARCHAR"/>
        <result property="englishMaterial" column="english_material" jdbcType="VARCHAR"/>
        <result property="englishUsage" column="english_usage" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="createUserId" column="create_user_id" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="updateUserId" column="update_user_id" jdbcType="VARCHAR"/>
        <result property="createUserName" column="create_user_name" jdbcType="VARCHAR"/>
        <result property="updateUserName" column="update_user_name" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        product_property,
        product_property_id,declare_chinese_name,declare_english_name,
        declare_price,customs_code,declare_element,
        english_material,english_usage,pl.create_time,
        pl.create_user_id,pl.update_time,pl.update_user_id
    </sql>

    <select id="list" resultType="com.erp.model.plm.dto.ProductLogisticsShowDTO">
        SELECT
        pl.id,
        pd.sku_no,
        pd.id AS sku_id,
        pd.images_url,
        <include refid="Base_Column_List"/>
        FROM product_detail pd
        LEFT JOIN product_logistics pl ON pl.sku_id = pd."id"
        WHERE pd.product_id = #{productId}
        ORDER BY pd.id desc
    </select>
</mapper>
