<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.ApplicationCategoryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.ApplicationCategoryEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="code" property="code" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, code
    </sql>
    <select id="list" resultType="com.erp.model.plm.dto.ApplicationCategoryDTO$ViewDTO">
        select id, name, code from application_category ac
        where
        ac.is_deleted = false
        <if test="searchKeyword != null and searchKeyword != ''">
            and ((ac.code = #{searchKeyword}) or ac.name ilike concat('%', #{searchKeyword}::text ,'%'))
        </if>
        order by
        <if test="searchKeyword != null and searchKeyword != ''">
            case when ac.name ILIKE concat(#{searchKeyword}::text,'%') THEN 1
            when ac.name ILIKE concat('%',#{searchKeyword}::text) THEN 2
            when ac.name ILIKE concat('%',#{searchKeyword}::text,'%') THEN 3
            end , ac.name,
        </if>
        ac.code
    </select>


</mapper>
