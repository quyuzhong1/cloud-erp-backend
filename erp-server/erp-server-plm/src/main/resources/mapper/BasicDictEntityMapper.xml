<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.BasicDictMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.BasicDictEntity">
        <id column="id" property="id" />
        <result column="value" property="value" />
        <result column="type" property="type" />
        <result column="name" property="name" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="order_index" property="orderIndex" />
    </resultMap>

<select id="paging" resultType="com.erp.model.sys.dto.DictBasicAllDTO$ViewDTO">
        select id,
		create_user_id,
		create_user_name,
		create_time,
		update_user_id,
		update_user_name,
		update_time,
		version,
		is_deleted,
		remark,
		value,
		type,
		name,
		status,
		order_index sort,
		type_name
		from basic_dict t
        WHERE ${params.sqlMap.default}
        AND t.is_deleted = false
        <!--权限-->
        <if test="params.permissionSql!=null and params.permissionSql!=''">
            ${params.permissionSql}
        </if>
        ORDER BY
	    <if test="params.sortList != null and params.sortList.size > 0">
	       <foreach collection="params.sortList" item="item" separator="," close=",">
	           ${item.field} ${item.sort}
	       </foreach>
	    </if>
	    t.create_time desc
    </select>
</mapper>
