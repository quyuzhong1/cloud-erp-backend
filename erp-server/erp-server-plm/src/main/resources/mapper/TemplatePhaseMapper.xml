<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.TemplatePhaseMapper">


    <select id="getTemplatePhaseByTemplateId" resultType="com.erp.model.plm.dto.TemplatePhaseDTO">
        SELECT ID,NAME FROM  template_phase WHERE template_id = #{templateId} AND is_deleted = FALSE
          ORDER BY seq asc ,update_time asc ,id asc
    </select>

</mapper>
