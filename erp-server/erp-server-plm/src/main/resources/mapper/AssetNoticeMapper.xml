<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.AssetNoticeMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.AssetNoticeEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="approve_user_id" property="approveUserId" />
       <result column="approve_user_name" property="approveUserName" />
       <result column="approve_time" property="approveTime" />
       <result column="approve_status" property="approveStatus" />
       <result column="apply_user_id" property="applyUserId" />
       <result column="apply_user_name" property="applyUserName" />
       <result column="apply_dept_id" property="applyDeptId" />
       <result column="apply_dept_name" property="applyDeptName" />
       <result column="invalid_reason" property="invalidReason" />
       <result column="remark" property="remark" />
       <result column="invalid_date" property="invalidDate" />
       <result column="apply_date" property="applyDate" />
       <result column="invalid_status" property="invalidStatus" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, approve_user_id, approve_user_name, approve_time, approve_status, apply_user_id, apply_user_name, apply_dept_id, apply_dept_name, invalid_reason, remark, invalid_date, apply_date, invalid_status
    </sql>

    <select id="paging" resultType="com.erp.model.plm.dto.AssetNoticeDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from asset_notice where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.plm.dto.AssetNoticeDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.plm.dto.AssetNoticeDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  asset_notice
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
