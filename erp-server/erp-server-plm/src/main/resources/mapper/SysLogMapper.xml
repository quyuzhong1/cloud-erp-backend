<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.SysLogMapper">


    <select id="paging" resultType="com.erp.model.plm.dto.SysLogShowDTO">
        select
               sl.id,
               sl.business_id,
               sl.field_name,
               sl.old_value,
               sl.new_value,
               sl.content
        from sys_log sl
        <where>
            <if test="params.className !=null and params.className!=''">
                AND sl.class_path LIKE concat('%',#{className},'%')
            </if>
            <if test="params.businessId !=null and params.businessId!=''">
                AND sl.business_id = #{params.businessId}
            </if>
            <if test="params.content !=null and params.content!=''">
                AND sl.content LIKE concat('%',#{params.content},'%')
            </if>
        </where>
        order by sl.create_time desc
    </select>

</mapper>
