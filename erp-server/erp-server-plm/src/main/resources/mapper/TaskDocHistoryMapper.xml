<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.TaskDocHistoryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.TaskDocHistoryEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="task_id" property="taskId" />
       <result column="finish_doc_id" property="finishDocId" />
       <result column="file_name" property="fileName" />
       <result column="file_url" property="fileUrl" />
       <result column="require_doc_id" property="requireDocId" />
       <result column="file_type" property="fileType" />
       <result column="file_size" property="fileSize" />
       <result column="file_suffix" property="fileSuffix" />
       <result column="product_id" property="productId" />
       <result column="upload_type" property="uploadType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        task_id, finish_doc_id, file_name, file_url, require_doc_id, file_type, file_size, file_suffix, product_id, upload_type
    </sql>
    <select id="historyList" resultType="com.erp.model.plm.dto.DocHistoryDTO$InfoDTO">
         SELECT
           dh.require_doc_id,
           dh.file_name,
           dh.file_url,
           dh.create_user_name,
           dh.create_time,
           dh.change_version,
           tdd.docs_name AS requireDocName
         FROM task_doc_history dh
         LEFT JOIN task_delivery_docs tdd
         ON dh.require_doc_id=tdd.id
         WHERE dh.is_deleted=FALSE
         AND dh.is_change_success=TRUE
         AND dh.finish_doc_id=#{finishDocsId}
         ORDER BY dh.change_version ASC
    </select>


</mapper>
