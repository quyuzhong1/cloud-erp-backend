<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.AssetNoticeDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.AssetNoticeDetailEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="asset_id" property="assetId" />
       <result column="asset_code" property="assetCode" />
       <result column="asset_name" property="assetName" />
       <result column="tag" property="tag" />
       <result column="is_urgent" property="isUrgent" />
       <result column="plan_delivery_date" property="planDeliveryDate" />
       <result column="apply_qty" property="applyQty" />
       <result column="purchase_org_id" property="purchaseOrgId" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        main_id, asset_id, asset_code, asset_name, tag, is_urgent, plan_deliver_date, apply_qty, purchase_org_id, remark
    </sql>

    <select id="searchMoldRefSkuByAssetId" resultType="com.erp.model.plm.dto.AssetNoticeDetailDTO$AssetDetailRefSkuDTO">
        SELECT
            mi.id as assetId,
            mi.code as assetCode,
            mi.name as assetName,
            mi.project_code AS projectCode,
            mi.project_name AS projectName,
            mrs.sku_id as skuId,
            mrs.sku_no as skuNo,
            mrs.product_name as productName,
            mrs.sku_qty as skuQty
        FROM
            mold_ref_sku mrs
            LEFT JOIN mold_info mi ON mi.ID = mrs.mold_id
            AND mi.is_deleted = FALSE
        WHERE
            mrs.is_deleted = FALSE
            and mi.id = #{assetId}
    </select>
</mapper>
