<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.TemplateTaskMapper">


    <sql id="Base_Column_List">
        tt.id,tt.name,tt.pid,tt.type,tt.charge_name,tt.priority,tt.is_fixed,tt.create_user_name,tt.create_user_id,tt.create_time,tpt.id as preTaskId,tpt.name as preTaskName
    </sql>

    <select id="paging" resultType="com.erp.model.plm.dto.TemplateTaskShowDTO">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        template_task tt
        LEFT JOIN (SELECT a.task_id,b.id,b.name FROM template_pre_task a INNER JOIN template_task b ON a.pre_task_id = b.id and a.template_id = b.template_id) tpt on tt.id = tpt.task_id
        <where>
            <if test="params.searchKeyword != '' and params.searchKeyword != null">
                AND tt.name LIKE concat('%', #{searchKeyword} ,'%')
            </if>
        </where>
        ORDER BY tt.create_time DESC
    </select>


</mapper>
