<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.plm.mapper.MouldRefCalcQtyMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.plm.entity.MouldRefCalcQtyEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="mould_detail_id" property="mouldDetailId" />
        <result column="purchase_qty" property="purchaseQty" />
        <result column="receive_qty" property="receiveQty" />
        <result column="stock_in_qty" property="stockInQty" />
        <result column="calc_qty" property="calcQty" />
    </resultMap>
    <select id="getNeedCalcData" resultType="com.erp.model.plm.dto.MouldRefCalcQtyDTO">
        select md.id as detailId, md.enable_date, mra.refund_standard
        from mould_detail md
                 inner join public.mould_refund_agreement mra on md.id = mra.mould_detail_id
        where is_need_refund = true

    </select>

</mapper>
