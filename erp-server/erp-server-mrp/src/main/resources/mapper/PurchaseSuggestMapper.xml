<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.PurchaseSuggestMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.PurchaseSuggestEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="create_type" property="createType" />
       <result column="suggest_purchase_qty" property="suggestPurchaseQty" />
       <result column="suggest_purchase_date" property="suggestPurchaseDate" />
       <result column="logistics_method" property="logisticsMethod" />
       <result column="logistics_days" property="logisticsDays" />
       <result column="estimate_instock_date" property="estimateInstockDate" />
       <result column="estimate_sales_date" property="estimateSalesDate" />
       <result column="purchase_cost" property="purchaseCost" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="invalid_remark" property="invalidRemark" />
       <result column="source_id" property="sourceId" />
       <result column="source_type" property="sourceType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        ps.id,
        ps.create_user_id,
        ps.create_user_name,
        ps.create_time,
        ps.update_user_id,
        ps.update_user_name,
        ps.update_time,
        ps.version,
        ps.is_deleted,
        ps.code, ps.create_type, ps.suggest_purchase_qty, ps.suggest_purchase_date, ps.logistics_method, ps.logistics_days, ps.estimate_instock_date, ps.estimate_sales_date, ps.purchase_cost, ps.invalid_status, ps.invalid_remark, ps.source_id, ps.source_type

    </sql>

    <!-- 采购建议导出分页 -->
    <select id="pagingExportPurchaseSuggestion"
            resultType="com.erp.model.mrp.dto.ReplenishmentSuggestionDTO$PurchaseSuggestionDTO">
        select
            <include refid="Base_Column_List"/>
            ,rs.platform_type,rs.sku_id,rs.sku_id,rs.sku_no,rs.platform,rs.shop_id
        from purchase_suggest ps
        left join replenishment_suggestion rs on ps.source_id = rs.id and rs.is_deleted = false
        <where>
            ${params.sqlMap.default}
            and ps.is_deleted = false
        </where>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        rs.id asc
    </select>

    <!-- 列表查询 -->
    <select id="list" resultType="com.erp.model.mrp.dto.PurchaseSuggestDTO$ListDTO">
        select
            <include refid="Base_Column_List"/>
        from purchase_suggest ps
        <where>
            ps.is_deleted = false and source_id = #{params.sourceId}
        </where>
    </select>


</mapper>
