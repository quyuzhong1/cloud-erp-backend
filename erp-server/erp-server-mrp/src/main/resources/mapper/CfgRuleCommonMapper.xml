<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.CfgRuleCommonMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.CfgRuleCommonEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="index" property="index" />
       <result column="parent_id" property="parentId" />
       <result column="name" property="name" />
       <result column="value" property="value" />
       <result column="remark" property="remark" />
       <result column="disable" property="disable" />
       <result column="type" property="type" />
       <result column="platform_type" property="platformType" />
       <result column="is_default" property="isDefault" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        index, parent_id, name, value, remark, disable, type,code,platform_type,is_default,field_type,category_name,is_required,is_change
    </sql>


    <!-- 查询数据 -->
    <select id="listRuleCommon" resultType="com.erp.model.mrp.dto.CfgRuleCommonDTO$ViewDTO">
        select
            <include refid="Base_Column_List"></include>
        from cfg_rule_common crc
        <where>
            crc.is_deleted = false and is_default = false
            <if test="platformType != null and platformType != ''">
                and crc.platform_type = #{platformType}
            </if>
            <if test="type != null and type != ''">
                and crc.type = #{type}
            </if>
            <if test="isEnableOverseas != null and isEnableOverseas == false">
                and  crc.remark != 'isEnableOverseas'
            </if>
        </where>
        order by crc.index asc
    </select>

    <!-- 查询默认配置 -->
    <select id="listDefaultRuleCommon" resultType="com.erp.model.mrp.dto.CfgRuleCommonDTO$ViewDTO">
        select
        <include refid="Base_Column_List"></include>
        from cfg_rule_common crc
        <where>
            crc.is_deleted = false and is_default = true
            <if test="platformType != null and platformType != ''">
                and  crc.platform_type = #{platformType}
            </if>
            <if test="type != null and type != ''">
                and crc.type = #{type}
            </if>
            <if test="isEnableOverseas != null and isEnableOverseas == false">
                and  crc.remark != 'isEnableOverseas'
            </if>
        </where>
        order by crc.index asc
    </select>


</mapper>
