<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.FbaInTransitDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.FbaInTransitDetailEntity">
        <result column="id" property="id"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_time" property="updateTime"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="replenishment_detail_id" property="replenishmentDetailId"/>
        <result column="source_id" property="sourceId"/>
        <result column="source_code" property="sourceCode"/>
        <result column="source_type" property="sourceType"/>
        <result column="status" property="status"/>
        <result column="delivery_date" property="deliveryDate"/>
        <result column="declare_qty" property="declareQty"/>
        <result column="delivery_qty" property="deliveryQty"/>
        <result column="receive_qty" property="receiveQty"/>
        <result column="in_transit_qty" property="inTransitQty"/>
        <result column="estimate_sales_date" property="estimateSalesDate"/>
        <result column="calc_version" property="calcVersion"/>
    </resultMap>

    <select id="fbaInTransitDetail" resultType="com.erp.model.mrp.vo.FbaInTransitDetailVO">
        select source_id,
               source_code,
               source_type,
               status,
               delivery_date,
               declare_qty,
               delivery_qty,
               receive_qty,
               in_transit_qty,
               estimate_sales_date
        from fba_in_transit_detail
        where replenishment_detail_id = #{params.detailId} and is_deleted = false
        <if test="params.estimateSalesDate != null" >
            and estimate_sales_date = #{params.estimateSalesDate}
        </if>
    </select>

</mapper>
