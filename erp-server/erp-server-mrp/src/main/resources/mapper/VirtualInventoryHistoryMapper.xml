<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.VirtualInventoryHistoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.VirtualInventoryHistoryEntity">
        <result column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="virtual_warehouse_id" property="virtualWarehouseId"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_no" property="skuNo"/>
        <result column="dict_inventory_status" property="dictInventoryStatus"/>
        <result column="qty" property="qty"/>
        <result column="bill_date" property="billDate"/>
    </resultMap>
    <select id="listVirtualWarehouseIdListAndSkuIdList"
            resultType="com.erp.model.mrp.dto.VirtualInventoryHistoryDTO$ListInventoryDTO">
        select
        vi.id,
        vi.warehouse_id,
        vi.sku_id,
        vi.dict_inventory_status,
        COALESCE(vi.qty,0) as virtualQty,
        vi.virtual_warehouse_id,
        COALESCE(lhi.usable_qty,0) as usableQty,
        COALESCE(lhi.frozen_qty,0) as frozenQty
        from virtual_inventory_history vi
        left join local_history_inventory lhi on lhi.is_deleted = false and lhi.sku_id = vi.sku_id and lhi.warehouse_id
        = vi.warehouse_id and lhi.bill_date = vi.bill_date
        <where>
            vi.is_deleted = false
            <if test="billDate != null" >
                AND vi.bill_date = #{billDate}
            </if>
            and vi.sku_id in
            <foreach collection="skuIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
            and vi.virtual_warehouse_id in
            <foreach collection="virtualWarehouseIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </where>
    </select>
    <select id="paging" resultType="com.erp.model.mrp.dto.VirtualInventoryHistoryDTO$ListDTO">
        select
        string_agg(id, ',') as indexId,
        sku_id as skuId,
        warehouse_id as warehouseId,
        virtual_warehouse_id as virtualWarehouseId,
        bill_date as billDate,
        max(update_time) as updateTime
        from virtual_inventory_history
        <where>
            ${params.sqlMap.default}
            and is_deleted = false
            <if test="params.hideZeroInventory">
                and qty != 0
            </if>
            <if test="params.permissionSql != null and params.permissionSql != ''">
                ${params.permissionSql}
            </if>
            <if test="params.billDate != null" >
                AND bill_date = #{params.billDate}
            </if>
        </where>
        group by sku_id,warehouse_id,virtual_warehouse_id,bill_date
        order by
        sku_id
    </select>

</mapper>
