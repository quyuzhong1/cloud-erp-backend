<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.HistoryImportRecordMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.HistoryImportRecordEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="type" property="type" />
       <result column="module" property="module" />
       <result column="file_url" property="fileUrl" />
       <result column="business_id" property="businessId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        name, type, module, file_url,business_id,platform_type
    </sql>

    <!-- 分页查询 -->
    <select id="paging" resultType="com.erp.model.mrp.dto.HistoryImportRecordDTO$ListDTO">
        select
            <include refid="Base_Column_List" />
        from history_import_record hir
        <where>
            hir.is_deleted = false
            <if test="params.businessId != null and params.businessId != ''">
                and hir.business_id = #{params.businessId}
            </if>
            <if test="params.type != null and params.type != ''">
                and hir.type = #{params.type}
            </if>
            <if test="params.module != null and params.module != ''">
                and hir.module = #{params.module}
            </if>
            <if test="params.platformType != null and params.platformType != ''">
                and hir.platform_type = #{params.platformType}
            </if>
        </where>
        order by id desc
    </select>


</mapper>
