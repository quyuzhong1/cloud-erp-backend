<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.CfgRuleLogisticsMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.CfgRuleLogisticsEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="index" property="index" />
       <result column="logistics_method" property="logisticsMethod" />
       <result column="logistics_days" property="logisticsDays" />
       <result column="logistics_cycle_days" property="logisticsCycleDays" />
       <result column="stock_up_id" property="stockUpId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        index, logistics_method, logistics_days, logistics_cycle_days, stock_up_id
    </sql>

    <!-- 物流下拉 -->
    <select id="selectLogistics" resultType="com.erp.model.mrp.dto.CfgRuleLogisticsDTO$SelectLogisticsDTO">
        select
            distinct
            crl.logistics_method as logisticsMethod,
            crl.logistics_days as logisticsDays
        from cfg_rule_logistics crl
        left join cfg_rule_stock_up crsu on crl.stock_up_id = crsu.id and crsu.is_deleted = false
        <where>
            crl.is_deleted = false and crsu.platform_type = #{params.platformType} and (crsu.ref_id = #{params.replenishmentSuggestionId} or crsu.ref_id = '')
        </where>
    </select>


</mapper>
