<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.mrp.mapper.CfgPlatformMappingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.mrp.entity.CfgPlatformMappingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="platform" property="platform" />
       <result column="type" property="type" />
       <result column="disabled" property="disabled" />
       <result column="effective_date" property="effectiveDate" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        platform, type, disabled, effective_date
    </sql>

    <!-- 下拉 -->
    <select id="selectPlatformMapping" resultType="com.erp.model.mrp.dto.CfgPlatformMappingDTO$ListDTO">
        select
            <include refid="Base_Column_List" />
        from cfg_platform_mapping cpm
        <where>
            cpm.is_deleted = false and cpm.disabled = false  and now() > effective_date
            <if test="params.searchKeyword != null and params.searchKeyword != ''">
                and cpm.platform ilike concat('%', #{params.searchKeyword}::text ,'%')
            </if>
            <if test="params.type != null and params.type != ''">
                and cpm.type = #{params.type}
            </if>
        </where>
    </select>


</mapper>
