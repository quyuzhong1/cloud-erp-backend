<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.QcBillMapper">


    <select id="listQcBillGroupQcStatus"
            resultType="com.erp.model.wms.dto.QcEffectivenessDTO$ViewQcOverviewDetailDTO">
            select
                qb.qc_status as type,
                count(0) as count
            from
            qc_bill qb
            <where>
                qb.is_deleted = false
            </where>
            group by qb.qc_status
    </select>

</mapper>
