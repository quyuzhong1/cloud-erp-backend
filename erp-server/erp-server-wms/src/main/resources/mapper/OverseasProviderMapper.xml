<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.OverseasProviderMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.OverseasProviderEntity">
        <result column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_user_name" property="createUserName"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_name" property="updateUserName"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="version" property="version"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="auth_status" property="authStatus"/>
        <result column="auth_time" property="authTime"/>
        <result column="auth_json" property="authJson"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, name, auth_status, auth_time, auth_json
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.OverseasProviderDTO$ListDTO">
        SELECT
            id,
            code,
            name,
            auth_status,
            auth_time,
            update_time,
            update_user_name,
            update_user_id
        FROM overseas_provider
        WHERE is_deleted = FALSE
        <if test="params.name != null and params.name != '' ">
            AND name ILIKE concat('%', #{params.name}::text ,'%')
        </if>
        <if test="params.authStatus != null and params.authStatus != '' ">
            AND auth_status ILIKE concat('%', #{params.authStatus}::text ,'%')
        </if>
        <if test="params.updateUserIdList != null and params.updateUserIdList != '' ">
            AND update_user_id in
            <foreach collection="params.updateUserIdList" item="updateUserId" open="(" close=")" separator=",">
                #{updateUserId}
            </foreach>
        </if>
        <if test="params.updateTimeList != null and params.updateTimeList != '' ">
            and update_time >= #{params.updateTimeList[0]}
            and  (#{params.updateTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > update_time
        </if>
    </select>


</mapper>
