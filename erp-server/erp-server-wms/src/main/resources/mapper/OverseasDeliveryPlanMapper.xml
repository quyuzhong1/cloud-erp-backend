<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.OverseasDeliveryPlanMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.OverseasDeliveryPlanEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="approve_status" property="approveStatus" />
       <result column="approve_user_id" property="approveUserId" />
       <result column="approve_user_name" property="approveUserName" />
       <result column="approve_time" property="approveTime" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="invalid_remark" property="invalidRemark" />
       <result column="invalid_time" property="invalidTime" />
       <result column="delivery_status" property="deliveryStatus" />
       <result column="to_warehouse_id" property="toWarehouseId" />
       <result column="to_warehouse_name" property="toWarehouseName" />
       <result column="country" property="country" />
       <result column="country_name" property="countryName" />
       <result column="plan_delivery_date" property="planDeliveryDate" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, approve_status, approve_user_id, approve_user_name, approve_time, invalid_status, invalid_remark, invalid_time, delivery_status, to_warehouse_id, to_warehouse_name, country, country_name, plan_delivery_date, remark
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.OverseasDeliveryPlanDTO$ListDTO">
        SELECT
            odp.id,
            odpd.id AS detailId,
            odp.code,
            odp.approve_status,
            odp.invalid_status,
            odp.delivery_status,
            odp.to_warehouse_id,
            odp.to_warehouse_name,
            odp.country,
            odp.country_name,
            odpd.sku_id,
            odpd.sku_no,
            odpd.is_combination,
            odpd.qty AS planQty,
            odp.create_user_id,
            odp.create_user_name,
            odp.approve_user_id,
            odp.approve_user_name,
            odp.create_time,
            odp.approve_time
        FROM overseas_delivery_plan_detail odpd
        INNER JOIN overseas_delivery_plan odp ON odp.id = odpd.main_id AND odpd.is_deleted = FALSE
        WHERE odp.is_deleted = FALSE
        <!--状态-->
        <if test="params.tabFlag != null and params.tabFlag != ''">
            AND odp.approve_status = #{params.tabFlag}
        </if>
        <!--单号-->
        <if test="params.code != null and params.code != ''">
            AND odp.code ILIKE concat('%',#{params.code}::text,'%')
        </if>
        <!--sku编号-->
        <if test="params.skuNoList != null and params.skuNoList.size > 0">
            AND odpd.sku_no in
            <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        <!--审核状态-->
        <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
            AND odp.approve_status in
            <foreach collection="params.approveStatusList" item="approveStatus" open="(" close=")" separator=",">
                #{approveStatus}
            </foreach>
        </if>
        <!--发货状态-->
        <if test="params.deliveryStatusList != null and params.deliveryStatusList.size > 0">
            AND odp.delivery_status in
            <foreach collection="params.deliveryStatusList" item="deliveryStatus" open="(" close=")" separator=",">
                #{deliveryStatus}
            </foreach>
        </if>
        <!--发货单号-->
        <if test="params.deliveryCode != null and params.deliveryCode != ''">
            AND odp.delivery_code ILIKE concat('%',#{params.deliveryCode},'%')
        </if>
        <!--目的仓库-->
        <if test="params.toWarehouseIdList != null and params.toWarehouseIdList.size > 0">
            AND odp.to_warehouse_id in
            <foreach collection="params.toWarehouseIdList" item="toWarehouseId" open="(" close=")" separator=",">
                #{toWarehouseId}
            </foreach>
        </if>
        <!--国家-->
        <if test="params.countryList != null and params.countryList.size > 0">
            AND odp.country in
            <foreach collection="params.countryList" item="country" open="(" close=")" separator=",">
                #{country}
            </foreach>
        </if>
        <!--是否组合品-->
        <if test="params.isCombination != null">
            and odpd.is_combination = #{params.isCombination}
        </if>
        <!--操作人-->
        <if test="params.updateUserIdList != null and params.updateUserIdList.size > 0">
            AND odp.update_user_id in
            <foreach collection="params.updateUserIdList" item="updateUserId" open="(" close=")" separator=",">
                #{updateUserId}
            </foreach>
        </if>
        <!--创建时间-->
        <if test="params.createTimeList !=null and params.createTimeList.size>0">
            AND odp.create_time >= #{params.createTimeList[0]} and
            (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > odp.create_time
        </if>
        <!--审核时间-->
        <if test="params.approveTimeList !=null and params.approveTimeList.size>0">
            AND odp.approve_time >= #{params.approveTimeList[0]} and
            (#{params.approveTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > odp.approve_time
        </if>
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        odp.create_time desc
    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from overseas_delivery_plan where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.OverseasDeliveryPlanDTO$ListDTO">
        SELECT
        odp.id,
        odp.code,
        odp.approve_status,
        odp.invalid_status,
        odp.delivery_status,
        odp.to_warehouse_id,
        odp.to_warehouse_name,
        odp.country,
        odp.country_name,
        odpd.sku_id,
        odpd.sku_no,
        odpd.is_combination,
        odpd.qty AS planQty,
        odp.create_user_id,
        odp.create_user_name,
        odp.approve_user_id,
        odp.approve_user_name,
        odp.create_time,
        odp.approve_time
        FROM overseas_delivery_plan_detail odpd
        INNER JOIN overseas_delivery_plan odp ON odp.id = odpd.main_id AND odpd.is_deleted = FALSE
        WHERE odp.is_deleted = FALSE
        <choose>
            <when test="params.ids!=null and params.ids.size>0 ">
                AND odp.id IN
                <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                <!--状态-->
                <if test="params.tabFlag != null and params.tabFlag != ''">
                    AND odp.approve_status = #{params.tabFlag}
                </if>
                <!--单号-->
                <if test="params.code != null and params.code != ''">
                    AND odp.code ILIKE concat('%',#{params.code}::text,'%')
                </if>
                <!--sku编号-->
                <if test="params.skuNoList != null and params.skuNoList.size > 0">
                    AND odpd.sku_no in
                    <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <!--审核状态-->
                <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                    AND odp.approve_status in
                    <foreach collection="params.approveStatusList" item="approveStatus" open="(" close=")" separator=",">
                        #{approveStatus}
                    </foreach>
                </if>
                <!--发货状态-->
                <if test="params.deliveryStatusList != null and params.deliveryStatusList.size > 0">
                    AND odp.delivery_status in
                    <foreach collection="params.deliveryStatusList" item="deliveryStatus" open="(" close=")" separator=",">
                        #{deliveryStatus}
                    </foreach>
                </if>
                <!--发货单号-->
                <if test="params.deliveryCode != null and params.deliveryCode != ''">
                    AND odp.delivery_code ILIKE concat('%',#{params.deliveryCode},'%')
                </if>
                <!--目的仓库-->
                <if test="params.toWarehouseIdList != null and params.toWarehouseIdList.size > 0">
                    AND odp.to_warehouse_id in
                    <foreach collection="params.toWarehouseIdList" item="toWarehouseId" open="(" close=")" separator=",">
                        #{toWarehouseId}
                    </foreach>
                </if>
                <!--国家-->
                <if test="params.countryList != null and params.countryList.size > 0">
                    AND odp.country in
                    <foreach collection="params.countryList" item="country" open="(" close=")" separator=",">
                        #{country}
                    </foreach>
                </if>
                <!--是否组合品-->
                <if test="params.isCombination != null">
                    and odpd.is_combination = #{params.isCombination}
                </if>
                <!--操作人-->
                <if test="params.updateUserIdList != null and params.updateUserIdList.size > 0">
                    AND odp.update_user_id in
                    <foreach collection="params.updateUserIdList" item="updateUserId" open="(" close=")" separator=",">
                        #{updateUserId}
                    </foreach>
                </if>
                <!--创建时间-->
                <if test="params.createTimeList !=null and params.createTimeList.size>0">
                    AND odp.create_time >= #{params.createTimeList[0]} and
                    (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > odp.create_time
                </if>
                <!--审核时间-->
                <if test="params.approveTimeList !=null and params.approveTimeList.size>0">
                    AND odp.approve_time >= #{params.approveTimeList[0]} and
                    (#{params.approveTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > odp.approve_time
                </if>
            </otherwise>
        </choose>
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        odp.create_time desc
    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.OverseasDeliveryPlanDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  overseas_delivery_plan
        WHERE is_deleted=FALSE
        GROUP BY approve_status
    </select>

    <!--下推要货申请列表查询-->
    <select id="generateRequisitionApplicationView" resultType="com.erp.model.wms.dto.OverseasDeliveryPlanDTO$GenerateRequisitionApplicationViewDTO">
        SELECT
            odp.id AS sourceId,
            odpd.id AS sourceDetailId,
            odp.code AS sourceCode,
            odp.to_warehouse_id AS channelId,
            odp.to_warehouse_name AS channelName,
            odpd.sku_id,
            odpd.sku_no,
            odpd.is_combination,
            odpd.qty AS planQty,
            odpd.qty AS requisitionQty
        FROM overseas_delivery_plan_detail odpd
        INNER JOIN overseas_delivery_plan odp ON odp.id = odpd.main_id AND odpd.is_deleted = FALSE
        WHERE odp.is_deleted = FALSE
        <if test="ids!=null and ids.size>0 ">
            AND odp.id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>

    <!--下推发货单列表查询-->
    <select id="generateDeliverView" resultType="com.erp.model.wms.dto.OverseasDeliveryPlanDTO$GenerateDeliverViewDTO">
        SELECT
        odp.id AS sourceId,
        odpd.id AS sourceDetailId,
        odp.code AS sourceCode,
        odp.country,
        odp.country_name,
        odp.to_warehouse_id,
        odp.to_warehouse_name,
        odpd.sku_id,
        odpd.sku_no,
        odpd.is_combination,
        odpd.qty AS planQty,
        odpd.qty AS deliveryQty
        FROM overseas_delivery_plan_detail odpd
        INNER JOIN overseas_delivery_plan odp ON odp.id = odpd.main_id AND odpd.is_deleted = FALSE
        WHERE odp.is_deleted = FALSE
        <if test="ids!=null and ids.size>0 ">
            AND odp.id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>
</mapper>
