<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.FbaShipmentPackingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.FbaShipmentPackingEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="box_no" property="boxNo" />
       <result column="asin" property="asin" />
       <result column="msku" property="msku" />
       <result column="fn_sku" property="fnSku" />
       <result column="sku_no" property="skuNo" />
       <result column="sku_id" property="skuId" />
       <result column="qty" property="qty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        main_id, box_no, asin, msku, fn_sku, sku_no, sku_id, qty
    </sql>
    <select id="getPacking" resultType="com.erp.model.wms.dto.FbaShipmentPackingDTO$ViewDTO">
        SELECT fsp.box_no as boxNo,
               concat(fsp.msku,'*',fsp.qty) as packingPlatformSku,
               concat(fsp.fn_sku,'*',fsp.qty) as packingFnSku
        FROM fba_shipment_packing fsp
        where fsp.is_deleted = false and fsp.main_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <select id="exportFbaShipmentPacking" resultType="com.erp.model.wms.dto.FbaShipmentPackingDTO$ViewDTO">
        SELECT
            distinct
            fs.code,
            fsp.box_no as boxNo,
        concat(fsp.msku,'*',fsp.qty) as packingPlatformSku,
        concat(fsp.fn_sku,'*',fsp.qty) as packingFnSku
        FROM fba_shipment_packing fsp
        INNER JOIN fba_shipment fs ON fs.id = fsp.main_id AND fs.is_deleted = FALSE
        INNER JOIN fba_shipment_detail fsd on fsd.main_id = fs.id and fsd.is_deleted = false
        WHERE
        ${params.sqlMap.default}
        and fsp.is_deleted = FALSE
        <!--数据权限-->
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
    </select>


</mapper>
