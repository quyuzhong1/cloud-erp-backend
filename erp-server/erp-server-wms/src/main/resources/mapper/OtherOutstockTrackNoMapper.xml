<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.OtherOutstockTrackNoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.OtherOutstockTrackNoEntity">
        <id column="id" property="id" />
        <result column="other_outstock_id" property="otherOutstockId" />
        <result column="other_outstock_code" property="otherOutstockCode" />
        <result column="track_no" property="trackNo" />
        <result column="create_user_id" property="createUserId" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_time" property="createTime" />
        <result column="update_user_id" property="updateUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_time" property="updateTime" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <!-- 根据出库单ID查询跟踪号列表 -->
    <select id="listByOutstockId" resultMap="BaseResultMap">
        SELECT *
        FROM other_outstock_track_no
        WHERE other_outstock_id = #{otherOutstockId}
          AND is_deleted = false
        ORDER BY id
    </select>

    <!-- 批量查询出库单的跟踪号 -->
    <select id="listByOutstockIds" resultMap="BaseResultMap">
        SELECT *
        FROM other_outstock_track_no
        WHERE other_outstock_id IN
        <foreach collection="otherOutstockIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_deleted = false
    </select>

</mapper>
