    <select id="paging" resultType="com.erp.model.wms.entity.WarehouseLocationReplenishEntity">
        select id,
               sku_id,
               sku_no as skuNo,
               source_id,
               source_code,
               source_type,
               warehouse_id,
               qty,
               status,
               from_warehouse_area,
               from_warehouse_location,
               to_warehouse_area,
               to_warehouse_location,
               suggest_qty,
               create_user_name as createUserName,
               create_time as createTime,
               update_user_name,
               update_time,
               handle_user_id,
               handle_user_name,
               handle_time
        from warehouse_location_replenish
        where is_deleted = false
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            and ${params.sqlMap.default}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        create_time desc
    </select>
    <select id="listByParam" resultType="com.erp.model.wms.entity.WarehouseLocationReplenishEntity">
        select id,
               sku_id,
               sku_no,
               source_id,
               source_code,
               source_type,
               warehouse_id,
               qty,
               status,
               from_warehouse_area,
               from_warehouse_location,
               to_warehouse_area,
               to_warehouse_location,
               suggest_qty,
               create_user_name,
               create_time,
               update_user_name,
               update_time
        from warehouse_location_replenish
        where is_deleted = false
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            and ${params.sqlMap.default}
        </if>
    </select>
    <select id="listTabInfo" resultType="com.erp.model.wms.dto.WarehouseLocationReplenishDTO$TabDTO">
        select status as tabFlag,
               count(1) as count
        from warehouse_location_replenish
        where is_deleted = false
        group by status
    </select>
