<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.CfgThirdWarehouseOperationDescriptionMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.CfgThirdWarehouseOperationDescriptionEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="third_warehouse_code" property="thirdWarehouseCode" />
       <result column="third_warehouse_name" property="thirdWarehouseName" />
       <result column="operation_type" property="operationType" />
       <result column="input_type" property="inputType" />
       <result column="remark" property="remark" />
       <result column="operation_type_name" property="operationTypeName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        third_warehouse_code, third_warehouse_name, operation_type, input_type, remark, operation_type_name
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.CfgThirdWarehouseOperationDescriptionDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from cfg_third_warehouse_operation_description where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.CfgThirdWarehouseOperationDescriptionDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.CfgThirdWarehouseOperationDescriptionDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  cfg_third_warehouse_operation_description
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
