<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.WarehouseMappingMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.WarehouseMappingEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="name" property="name" />
       <result column="dict_platform" property="dictPlatform" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        warehouse_id, name, dict_platform, remark
    </sql>

    <!--根据仓库id查询映射信息-->
    <select id="listMappingViewByWarehouseIds" resultType="com.erp.model.wms.dto.WarehouseMappingDTO$MappingViewDTO">
        SELECT
        w.id AS warehouseId,
        w.name AS warehouseName,
        wm.name AS  thirdWarehouseName,
        wm.dict_Platform AS dictPlatform
        FROM warehouse w
        LEFT JOIN warehouse_mapping wm ON w.id = wm.warehouse_id AND wm.is_deleted = FALSE
        WHERE w.is_deleted = FALSE
        <if test="warehouseIdList != null and warehouseIdList.size > 0">
            and w.id in
            <foreach collection="warehouseIdList" item="warehouseId" open="(" close=")" separator=",">
                #{warehouseId}
            </foreach>
        </if>
    </select>

</mapper>
