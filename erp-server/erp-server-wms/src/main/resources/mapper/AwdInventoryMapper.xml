<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.AwdInventoryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.AwdInventoryEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="warehouse_name " property="warehouseName " />
       <result column="asin" property="asin" />
       <result column="msku" property="msku" />
       <result column="fnsku" property="fnsku" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="product_name" property="productName" />
       <result column="total_onhand_qty" property="totalOnhandQty" />
       <result column="available_distributable_qty" property="availableDistributableQty" />
       <result column="replenishment_qty" property="replenishmentQty" />
       <result column="reserved_distributable_qty" property="reservedDistributableQty" />
       <result column="total_inbound_qty" property="totalInboundQty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        warehouse_id, warehouse_name , asin, msku, fnsku, sku_id, sku_no, product_name, total_onhand_qty, available_distributable_qty, replenishment_qty, reserved_distributable_qty, total_inbound_qty
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.AwdInventoryDTO$ListDTO">
        SELECT
            *
        FROM
            awd_inventory
    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from awd_inventory where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.AwdInventoryDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.AwdInventoryDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  awd_inventory
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
