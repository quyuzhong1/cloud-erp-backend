    <!--根据来源详情id查询发货详情-->
    <select id="listBySourceDetailIds" resultType="com.erp.model.wms.entity.FirstMileDeliveryDetailEntity">
        SELECT
            fdd.id,
            fdd.create_time,
            fdd.update_time,
            fdd.create_user_name,
            fdd.create_user_id,
            fdd.update_user_name,
            fdd.update_user_id,
            fdd.version,
            fdd.is_deleted,
            fdd.main_id,
            fdd.platform_spu_no,
            fdd.platform_sku_no,
            fdd.fn_sku,
            fdd.sku_id,
            fdd.sku_no,
            fdd.product_name,
            fdd.stock_sku,
            fdd.declare_qty,
            fdd.plan_qty,
            fdd.delivery_qty,
            fdd.is_combination,
            fdd.net_weight,
            fdd.product_size_length,
            fdd.product_size_width,
            fdd.product_size_height,
            fdd.source_detail_id,
            fdd.warehouse_location,
            fdd.receive_date,
            fd.approve_status
        FROM first_mile_delivery fd
        INNER JOIN first_mile_delivery_detail fdd ON fd.id = fdd.main_id AND fdd.is_deleted = FALSE
        WHERE fd.is_deleted = FALSE
        <if test="sourceDetailIds != null and sourceDetailIds.size > 0">
            AND fdd.source_detail_id IN
            <foreach collection="sourceDetailIds" item="sourceDetailId" open="(" separator="," close=")">
                #{sourceDetailId}
            </foreach>
        </if>
    </select>

    <!-- 根据明细id查询来源 -->
    <select id="listFirstMileSource"
            resultType="com.erp.model.wms.dto.FirstMileDeliveryDetailDTO$listFirstMileDTO">
        select
            fd.id,
            fdd.id as detailId,
            fdd.sku_id,
            fdd.platform_sku_no,
            fd.source_type,
            fd.source_id,
            fdd.source_detail_id,
            fd.demand_type
        from first_mile_delivery fd
        inner join first_mile_delivery_detail fdd ON fd.id = fdd.main_id AND fdd.is_deleted = FALSE
        where fd.is_deleted = false  and fdd.id in
        <foreach collection="firstMileDetailIdList" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

