<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.WaveListPdaMapper">

    <select id="paging" resultType="com.erp.model.wms.entity.WaveListEntity">
        select id,
                create_time,
                code,
                name,
                type,
                status,
                picking_cart_type,
                picking_cart_code,
                picking_type
        from wave_list
        where is_deleted = false
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            and ${params.sqlMap.default}
        </if>
        order by create_time desc
    </select>
</mapper>