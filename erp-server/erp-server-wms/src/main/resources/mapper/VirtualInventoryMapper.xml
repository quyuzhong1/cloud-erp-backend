<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.VirtualInventoryMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.VirtualInventoryEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="virtual_warehouse_id" property="virtualWarehouseId" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="dict_inventory_status" property="dictInventoryStatus" />
       <result column="qty" property="qty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        warehouse_id, virtual_warehouse_id, sku_id, sku_no, dict_inventory_status, qty
    </sql>

    <!-- 虚拟库存分页查询 -->
    <select id="paging" resultType="com.erp.model.wms.dto.VirtualInventoryDTO$ListDTO">
        select
            vi.sku_id as skuId,
            vi.sku_no as skuNo,
            vi.warehouse_id as warehouseId,
            vi.virtual_warehouse_id as virtualWarehouseId
        from virtual_inventory vi
        <where>
            ${params.sqlMap.default}
            and vi.is_deleted = false
            <if test="params.permissionSql != null and params.permissionSql != ''">
                ${params.permissionSql}
            </if>
        </where>
        group by vi.sku_id,vi.sku_no,vi.warehouse_id,i.virtual_warehouse_id
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        vi.sku_id
    </select>

    <!-- 根据SKU和虚拟仓库查询 -->
    <select id="listVirtualWarehouseIdListAndSkuIdList"
            resultType="com.erp.model.wms.dto.VirtualInventoryDTO$ListInventoryDTO">
        select
            inv.warehouse_id,
            inv.sku_id,
            inv.dict_inventory_status,
            COALESCE(inv.qty,0),
            COALESCE(vi.qty,0) as virtualQty,
            vi.virtual_warehouse_id
        from inventory inv
        left join virtual_inventory vi on vi.sku_id = inv.sku_id and vi.warehouse_id = inv.warehouse_id
        and vi.dict_inventory_status = inv.dict_inventory_status and vi.is_deleted = false
        <where>
            inv.is_deleted = false
            and inv.sku_id in
            <foreach collection="skuIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
            and vi.virtual_warehouse_id in
            <foreach collection="virtualWarehouseIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </where>
    </select>

    <!-- 库存差异分页查询 -->
    <select id="diffPaging" resultType="com.erp.model.wms.dto.VirtualInventoryDiffDTO$ListDTO">

    </select>

    <!-- 库存差异明细分页查询 -->
    <select id="diffDetailPaging" resultType="com.erp.model.wms.dto.VirtualInventoryDiffDTO$ListDetailDTO">

    </select>


</mapper>
