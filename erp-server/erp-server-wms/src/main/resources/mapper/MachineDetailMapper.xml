<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.MachineDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.MachineDetailEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="main_id" property="mainId" />
        <result column="sku_id" property="skuId" />
        <result column="sku_no" property="skuNo" />
        <result column="qty" property="qty" />
        <result column="unit" property="unit" />
        <result column="warehouse_id" property="warehouseId" />
        <result column="warehouse_name" property="warehouseName" />
        <result column="warehouse_location" property="warehouseLocation" />
        <result column="cur_inventory_qty" property="curInventoryQty" />
        <result column="reference_version" property="referenceVersion" />
        <result column="remark" property="remark" />
    </resultMap>

    <!-- 根据来源id查询数据 -->
    <select id="listMachineBySourceDetailIdList"
            resultType="com.erp.model.wms.dto.SoB2bProcessingDTO$ResponseDTO">
        select
            mi.id,
            mi.code,
            mi.approve_status,
            mi.approve_time,
            mi.source_id,
            md.id as detailId,
            md.sku_id,
            md.qty,
            md.reference_version as bomVersion,
            md.source_detail_id
        from machine_info mi
        inner join machine_detail md on md.main_id = mi.id and md.is_deleted = false
        where mi.is_deleted = false and mi.invalid_status = false
        and md.source_detail_id in
        <foreach collection="sourceDetailIdList" open="(" close=")" separator="," item="item" >
            #{item}
        </foreach>
    </select>

</mapper>
