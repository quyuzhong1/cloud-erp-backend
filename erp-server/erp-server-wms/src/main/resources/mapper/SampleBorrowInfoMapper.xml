<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.SampleBorrowInfoMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.SampleBorrowInfoEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="approve_status" property="approveStatus" />
       <result column="approve_time" property="approveTime" />
       <result column="approve_user_id" property="approveUserId" />
       <result column="approve_user_name" property="approveUserName" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="borrow_user_id" property="borrowUserId" />
       <result column="borrow_user_name" property="borrowUserName" />
       <result column="borrow_dept_id" property="borrowDeptId" />
       <result column="borrow_dept_name" property="borrowDeptName" />
       <result column="lend_user_id" property="lendUserId" />
       <result column="lend_user_name" property="lendUserName" />
       <result column="lend_dept_id" property="lendDeptId" />
       <result column="lend_dept_name" property="lendDeptName" />
       <result column="borrow_date" property="borrowDate" />
       <result column="estimated_return_date" property="estimatedReturnDate" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        code, approve_status, approve_time, approve_user_id, approve_user_name, invalid_status, borrow_user_id, borrow_user_name, borrow_dept_id, borrow_dept_name, lend_user_id, lend_user_name, lend_dept_id, lend_dept_name, borrow_date, estimated_return_date, remark
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.SampleBorrowInfoDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from sample_borrow_info where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.SampleBorrowInfoDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.SampleBorrowInfoDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  sample_borrow_info
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
