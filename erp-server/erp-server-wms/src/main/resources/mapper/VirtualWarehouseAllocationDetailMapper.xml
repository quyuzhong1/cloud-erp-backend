<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.VirtualWarehouseAllocationDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.VirtualWarehouseAllocationDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="disabled" property="disabled" />
       <result column="main_id" property="mainId" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="warehouse_name" property="warehouseName" />
       <result column="from_virtual_warehouse_id" property="fromVirtualWarehouseId" />
       <result column="from_virtual_warehouse_code" property="fromVirtualWarehouseCode" />
       <result column="from_virtual_warehouse_name" property="fromVirtualWarehouseName" />
       <result column="qty" property="qty" />
       <result column="to_virtual_warehouse_id" property="toVirtualWarehouseId" />
       <result column="to_virtual_warehouse_code" property="toVirtualWarehouseCode" />
       <result column="to_virtual_warehouse_name" property="toVirtualWarehouseName" />
       <result column="finish_description" property="finishDescription" />
       <result column="third_code" property="thirdCode" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        disabled, main_id, sku_id, sku_no, warehouse_id, warehouse_name, from_virtual_warehouse_id, from_virtual_warehouse_code, from_virtual_warehouse_name, qty, to_virtual_warehouse_id, to_virtual_warehouse_code, to_virtual_warehouse_name, finish_description, third_code
    </sql>
    <update id="batchManualFinish">
        update virtual_warehouse_allocation_detail
        set sync_status=#{code} , third_code=#{params.thirdCode} , sys_type=#{params.sysType}, sys_type_name=#{params.sysTypeName}
        <if test="params.finishDescription!=null and params.finishDescription!=''">
            , finish_description=#{params.finishDescription}
        </if>
        where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>
    <update id="batchSync">
        update virtual_warehouse_allocation_detail
        set sync_status=#{code}
        where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>
    <update id="updateSyncStatus">
        update virtual_warehouse_allocation_detail
        set sync_status=#{params.syncStatus}
          <if test="params.thirdCode!=null and params.thirdCode!=''">
              , third_code=#{params.thirdCode}
          </if>
        <if test="params.sysType!=null and params.sysType!=''">
            , sys_type=#{params.sysType}
        </if>
        <if test="params.sysTypeName!=null and params.sysTypeName!=''">
            , sys_type_name=#{params.sysTypeName}
        </if>
        <if test="params.finishDescription!=null">
            , finish_description=#{params.finishDescription}
        </if>
        where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </update>

    <!-- 查询分货信息 -->
    <select id="listAllocationData"
            resultType="com.erp.model.wms.dto.VirtualWarehouseAllocationDetailDTO$AllocationDataDTO">
        select
            vwa.type,
            vwad.sku_id,
            vwad.warehouse_id,
            vwad.to_virtual_warehouse_id,
            vwad.from_virtual_warehouse_id,
            vwad.qty,
            vwa.handle_date
        from virtual_warehouse_allocation vwa
        left join virtual_warehouse_allocation_detail vwad on vwad.is_deleted = false and vwa.id = vwad.main_id
        <where>
            vwa.is_deleted = false and vwa.status = 'handle' and vwa.disabled = false
            <if test="skuIdList != null and skuIdList.size > 0">
                and vwad.sku_id in
                <foreach collection="skuIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="warehouseIdList != null and warehouseIdList.size > 0">
                and vwad.warehouse_id in
                <foreach collection="warehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="virtualWarehouseIdList != null and virtualWarehouseIdList.size > 0">
                and (
                vwad.from_virtual_warehouse_id in
                <foreach collection="virtualWarehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
                or
                vwad.to_virtual_warehouse_id in
                <foreach collection="virtualWarehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
                )
            </if>
        </where>
    </select>
</mapper>
