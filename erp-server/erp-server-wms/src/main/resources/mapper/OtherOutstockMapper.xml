<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.OtherOutstockMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.OtherOutstockEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="code" property="code" />
        <result column="approve_status" property="approveStatus" />
        <result column="bill_date" property="billDate" />
        <result column="warehouse_keeper_id" property="warehouseKeeperId" />
        <result column="warehouse_keeper_name" property="warehouseKeeperName" />
        <result column="receiver_id" property="receiverId" />
        <result column="receiver_name" property="receiverName" />
        <result column="inventory_org_id" property="inventoryOrgId" />
        <result column="inventory_org_name" property="inventoryOrgName" />
        <result column="receive_org_id" property="receiveOrgId" />
        <result column="receive_org_name" property="receiveOrgName" />
        <result column="inventory_direction" property="inventoryDirection" />
        <result column="invalid_status" property="invalidStatus" />
        <result column="invalid_remark" property="invalidRemark" />
        <result column="approve_time" property="approveTime" />
        <result column="approve_user_name" property="approveUserName" />
        <result column="approve_user_id" property="approveUserId" />
    </resultMap>
    
    <select id="paging" resultType="com.erp.model.wms.dto.OtherOutstockDTO$ListDTO">
        select
            oo.id,
            oo.code,
            oo.inventory_direction as inventoryDirection,
            oo.approve_status as approveStatus,
            oo.invalid_status as invalidStatus,
            ood.sku_id as skuId,
            ood.sku_no as skuNo,
            oo.bill_date as billDate,
            ood.actual_qty as actualQty,
            ood.unit,
            oo.warehouse_name as warehouseName,
            ood.warehouse_location as warehouseLocation,
            oo.approve_user_name as approveUserName,
            oo.create_user_name as createUserName,
            oo.create_time as createTime
        from other_outstock oo 
        inner join other_outstock_detail ood on oo.id = ood.main_id and ood.is_deleted = false 
        <where>
            oo.is_deleted = false
            <if test="params.searchType != null and params.searchType != ''">
                AND oo.approve_status = #{params.searchType}
            </if>
            <if test="params.code != null and params.code != ''">
                and oo.code like concat('%',#{params.code},'%')
            </if>
            <if test="params.invalidStatus != null ">
                and oo.invalid_status = #{params.invalidStatus}
            </if>
            <if test="params.inventoryDirection != null ">
                and oo.inventory_direction = #{params.inventoryDirection}
            </if>
            <if test="params.skuNoList != null and params.skuNoList.size > 0">
                and ood.sku_no in
                <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and oo.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.warehouseIdList != null and params.warehouseIdList.size > 0">
                and oo.warehouse_id in
                <foreach collection="params.warehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createUserIdList != null and params.createUserIdList.size > 0">
                and oo.create_user_id in
                <foreach collection="params.createUserIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createTimeList != null and params.createTimeList.size > 0">
                and oo.create_time >= #{params.createTimeList[0]} and  (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > oo.create_time
            </if>
            <if test="params.billDateList != null and params.billDateList.size > 0">
                and oo.bill_date >= #{params.billDateList[0]} and  (#{params.billDateList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > oo.bill_date
            </if>
            <if test="params.permissionSql != null and params.permissionSql != ''">
                ${params.permissionSql }
            </if>
        </where>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        oo.id desc,ood.id desc
    </select>

    <select id="listCount" resultType="java.lang.Integer">
        select
        count(distinct oo.id)
        from other_outstock oo
        left join other_outstock_detail ood on oo.id = ood.main_id and ood.is_deleted = false
        <where>
            oo.is_deleted = false
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and oo.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.permissionSql != null and params.permissionSql != ''">
                ${params.permissionSql }
            </if>
        </where>
    </select>
    
