<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.TransferInMapper">


    <select id="listApproveCount" resultType="com.erp.model.wms.dto.TransferInDTO$ApproveCountDTO">
          SELECT
            approve_status,
	        count(*)
	     FROM   transfer_in
	     WHERE is_deleted=FALSE
         GROUP BY approve_status
    </select>
</mapper>
