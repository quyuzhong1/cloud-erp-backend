<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.B2bThirdDeliveryDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.B2bThirdDeliveryDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="sale_qty" property="saleQty" />
       <result column="delivery_qty" property="deliveryQty" />
       <result column="per_box_qty" property="perBoxQty" />
       <result column="delivery_sku_no" property="deliverySkuNo" />
       <result column="delivery_sku_id" property="deliverySkuId" />
       <result column="warehouse_platform_sku" property="warehousePlatformSku" />
       <result column="box_qty" property="boxQty" />
       <result column="box_spec_no" property="boxSpecNo" />
       <result column="sort" property="sort" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        main_id, sku_id, sku_no, sale_qty, delivery_qty, per_box_qty, delivery_sku_no, delivery_sku_id, warehouse_platform_sku, box_qty, box_spec_no, sort
    </sql>
    <select id="listBySoDetailIds" resultType="com.erp.model.wms.entity.B2bThirdDeliveryDetailEntity">
        select b2b_third_delivery_detail.* ,b2b_third_delivery.status
        from b2b_third_delivery_detail
        inner join b2b_third_delivery on b2b_third_delivery_detail.main_id = b2b_third_delivery.id
        where so_detail_id in
        <foreach collection="soDetailIds" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>


</mapper>
