<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.QcSamplingPlanSkuRefMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.QcSamplingPlanSkuRefEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="product_name" property="productName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        main_id, sku_id, sku_no, product_name
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.SamplingPlanSkuRefDTO$ListDTO">

    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from qc_sampling_plan_sku_ref where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.SamplingPlanSkuRefDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.SamplingPlanSkuRefDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  qc_sampling_plan_sku_ref
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>
    <select id="listSkuByMainIds" resultType="com.erp.model.wms.dto.SamplingPlanSkuRefDTO$SkuDTO">
        SELECT
            qspsr.main_id AS id,
            COALESCE(STRING_AGG(DISTINCT qspsr.sku_no, ',' ORDER BY qspsr.sku_no),'all') AS skuNos
        FROM qc_sampling_plan_sku_ref qspsr
        WHERE qspsr.is_deleted = FALSE
            and qspsr.main_id in
            <foreach collection="ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        GROUP BY qspsr.main_id
    </select>

</mapper>
