<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.VirtualInventoryHisMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.VirtualInventoryHisEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="virtual_inventory_id" property="virtualInventoryId" />
       <result column="date" property="date" />
       <result column="qty" property="qty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        virtual_inventory_id, date, qty
    </sql>

    <!--查询结余库存 -->
    <select id="listVirtualInventoryHis" resultType="com.erp.model.wms.dto.VirtualInventoryHisDTO$AddDTO">
        WITH virtualTransFlow as (
            select
                   virtual_inventory_id,
                   sum(qty) as totalQty
            from virtual_trans_flow
            where is_deleted = false and #{localDate} > trade_time
            group by virtual_inventory_id
        )
        select
            vtf.totalQty as qty,
            vi.id as virtualInventoryId
        from virtual_inventory vi
        left join virtualTransFlow vtf on vi.id = vtf.virtual_inventory_id
        where vi.is_deleted = false
    </select>

    <!-- 根据关联id和日期查询 -->
    <select id="listByVirtualInventoryIdList" resultType="com.erp.model.wms.entity.VirtualInventoryHisEntity">
        select
            <include refid="Base_Column_List" />
        from virtual_inventory_his
        where is_deleted = false
        and virtual_inventory_id in
        <foreach collection="virtualInventoryIdList" open="(" close=")" separator="," item="item" >
            #{item}
        </foreach>
        and date in
        <foreach collection="dateList" open="(" close=")" separator="," item="item" >
            #{item}
        </foreach>
    </select>

    <!-- 查询快照历史库存合计 -->
    <select id="listInventoryQty" resultType="com.erp.model.wms.dto.VirtualInventoryHisDTO$VirtualQtyDTO">
        select
            vi.sku_id,
            vi.warehosue_id,
            vi.virtual_warehouse_id,
            sum(vih.qty) as virtualQty,
            vih.date
        from virtual_inventory_his vih
        inner join virtual_inventory vi on vih.virtual_inventory_id = vi.id and vi.is_deleted = false
        where vih.is_deleted = false and vih.date = #{localDate}
            and vi.sku_id in
            <foreach collection="skuIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
            and vi.warehosue_id in
            <foreach collection="warehouseIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
            and vi.virtual_warehouse_id in
            <foreach collection="virtualWarehouseIdList" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
        group by vi.sku_id,vi.warehosue_id,vi.virtual_warehouse_id
    </select>


</mapper>
