<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.VirtualInventoryHisMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.VirtualInventoryHisEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="sku_id" property="skuId" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="virtual_warehouse_id" property="virtualWarehouseId" />
       <result column="date" property="date" />
       <result column="qty" property="qty" />
       <result column="dict_inventory_status" property="dictInventoryStatus" />
       <result column="virtual_trans_flow_id" property="virtualTransFlowId" />
       <result column="batch_no" property="batchNo" />
       <result column="bill_date" property="billDate" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        sku_id, warehouse_id, virtual_warehouse_id, date, qty, dict_inventory_status, virtual_trans_flow_id, batch_no, bill_date
    </sql>

    <!-- 根据sku、仓库、虚拟仓查询 -->
    <select id="listByParam" resultType="com.erp.model.wms.entity.VirtualInventoryHisEntity">
        select
            <include refid="Base_Column_List" />
        from virtual_inventory_his vih
        <where>
            vih.is_deleted = false
            <if test="params.endDate != null">
                and vih.date > #{params.endDate}
            </if>
            <if test="params.skuIdList != null and params.skuIdList.size > 0">
                and vih.sku_id in
                <foreach collection="params.skuIdList" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="params.warehouseIdList != null and params.warehouseIdList.size > 0">
                and vih.warehouse_id in
                <foreach collection="params.warehouseIdList" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="params.virtualWarehouseIdList != null and params.virtualWarehouseIdList.size > 0">
                and vih.virtual_warehouse_id in
                <foreach collection="params.virtualWarehouseIdList" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>


</mapper>
