<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.PickingDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.PickingDetailEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="sku_id" property="skuId" />
        <result column="sku_no" property="skuNo" />
        <result column="qty" property="qty" />
        <result column="unit" property="unit" />
        <result column="warehouse_location" property="warehouseLocation" />
        <result column="source_detail_id" property="sourceDetailId" />
    </resultMap>

    <update id="deleteByWaveIds" parameterType="java.lang.String">
        UPDATE picking_detail
        SET is_deleted = TRUE
        WHERE main_id IN ( SELECT ID FROM picking_lists WHERE source_code IN ( SELECT delivery_code FROM wave_list_detail WHERE
        main_id IN
        <foreach collection="waveIds" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>))
    </update>

</mapper>
