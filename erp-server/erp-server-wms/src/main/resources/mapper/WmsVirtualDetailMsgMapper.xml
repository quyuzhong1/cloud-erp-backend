<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.WmsVirtualDetailMsgMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.WmsVirtualDetailMsgEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="remark" property="remark" />
       <result column="trade_time" property="tradeTime" />
       <result column="status" property="status" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        wvdm.id,
        wvdm.create_user_id,
        wvdm.create_user_name,
        wvdm.create_time,
        wvdm.update_user_id,
        wvdm.update_user_name,
        wvdm.update_time,
        wvdm.version,
        wvdm.is_deleted,
        wvdm.remark, wvdm.trade_time, wvdm.status,wvdm.business_id
    </sql>

    <!-- 查询任务表数据 -->
    <select id="listFirstVirtualDetailMsg" resultType="com.erp.model.wms.dto.WmsVirtualDetailMsgDTO$ListDTO">
        select
            <include refid="Base_Column_List" />
            ,vtf.sku_id,vtf.warehouse_id,vtf.virtual_warehouse_id
        from wms_virtual_detail_msg wvdm
        inner join virtual_trans_flow vtf on wvdm.business_id = vtf.id and vtf.is_deleted = false
        where wvdm.is_deleted = false and wvdm.status in ('waitHandle', 'fail', 'doing')
        order by wvdm.trade_time asc;
    </select>


</mapper>
