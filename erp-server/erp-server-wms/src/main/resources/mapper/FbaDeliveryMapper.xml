                    <foreach collection="params.demandTypeList" item="demandType" open="(" close=")" separator=",">
                        #{demandType}
                    </foreach>
                </if>
                <!--店铺id-->
                <if test="params.shopIdList != null and params.shopIdList.size > 0">
                    AND fd.shop_id in
                    <foreach collection="params.shopIdList" item="shopId" open="(" close=")" separator=",">
