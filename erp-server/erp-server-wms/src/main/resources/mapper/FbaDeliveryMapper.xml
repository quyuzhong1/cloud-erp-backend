                    AND fd.approve_time >= #{params.approveTimeList[0]} and
                    (#{params.approveTimeList[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > fd.approve_time
                </if>
                <!--创建时间-->
                <if test="params.createTimeList !=null and params.createTimeList.size>0">
                    AND fd.create_time >= #{params.createTimeList[0]} and
                    (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1
                    DAY' ) > fd.create_time
