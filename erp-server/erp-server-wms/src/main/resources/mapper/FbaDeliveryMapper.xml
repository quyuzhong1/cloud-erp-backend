    <select id="tabList" resultType="com.erp.model.wms.dto.FbaDeliveryDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  fba_delivery
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${permissionSql}
        </if>

        GROUP BY approve_status
    </select>

    <select id="listDeliveryRecordBySourceIds" resultType="com.erp.model.wms.dto.FbaDeliveryDTO$DeliverRecordView">
        SELECT
        fd.code AS deliveryCode,
        CASE WHEN approve_status = 'approve' THEN '已发货' ELSE '未发货' END AS deliveryStatus,
        CASE WHEN approve_status = 'approve' THEN '已发货' ELSE '未发货' END AS deliveryStatusName,
        SUM(fdd.delivery_qty) AS deliveryQty,
        fdl.delivery_time AS deliveryTime
        FROM  fba_delivery fd
        INNER JOIN fba_delivery_detail fdd ON fd.id = fdd.main_id AND fdd.is_deleted = FALSE
        LEFT JOIN fba_delivery_logistics fdl ON fd.id = fdl.main_id AND fdl.is_deleted = FALSE
        WHERE fd.is_deleted = FALSE
        <if test="sourceIds != null and sourceIds.size > 0">
            AND fd.source_id IN
            <foreach collection="sourceIds" item="sourceId" open="(" close=")" separator=",">
                #{sourceId}
            </foreach>
        </if>
        GROUP BY fd.code,
        deliveryStatus,
        fdl.delivery_time
        ORDER BY fd.code DESC
    </select>

    <select id="generateMachineView" resultType="com.erp.model.wms.dto.FbaDeliveryDTO$GenerateMachineView">
        SELECT
        fd.code,
        fdd.id,
        fdd.main_id,
        fdd.sku_id,
        fdd.sku_no,
        fd.delivery_warehouse_id AS warehouseId,
        fd.delivery_warehouse_name AS warehouseName,
        fdd.warehouse_location,
        fdd.delivery_qty AS assembleQty
        FROM  fba_delivery fd
        INNER JOIN fba_delivery_detail fdd ON fd.id = fdd.main_id AND fdd.is_deleted = FALSE
        LEFT JOIN fba_delivery_logistics fdl ON fd.id = fdl.main_id AND fdl.is_deleted = FALSE
        WHERE fd.is_deleted = FALSE
        <if test="ids != null and ids.size > 0">
            AND fd.id IN
            <foreach collection="ids" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
        </if>
        ORDER BY fd.code DESC
    </select>

</mapper>
