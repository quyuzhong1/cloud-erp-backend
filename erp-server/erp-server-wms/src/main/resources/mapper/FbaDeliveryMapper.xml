        fd.code,
        fd.source_code,
        fd.demand_type,
        fd.approve_status,
        fd.invalid_status,
        fd.shop_id,
        fd.shop_name,
        fd.country_id,
        fd.country_name,
        fd.delivery_warehouse_id,
        fd.delivery_warehouse_name,
        fd.dest_warehouse_id,
        fd.dest_warehouse_name,
        fdl.logistics_method,
        fdd.asin,
        fdd.msku,
        fdd.fn_sku,
        fdd.sku_no,
        fdd.stock_sku,
        fdd.plan_qty,
        fdd.delivery_qty,
        fd.remark,
        fd.create_user_name,
        fd.create_time,
        fd.approve_user_name,
        fd.approve_time
        FROM fba_delivery fd
        INNER JOIN fba_delivery_logistics fdl ON fd.id = fdl.main_id AND fdl.is_deleted = FALSE
        INNER JOIN fba_delivery_detail fdd ON fd.id = fdd.main_id AND fdd.is_deleted = FALSE
