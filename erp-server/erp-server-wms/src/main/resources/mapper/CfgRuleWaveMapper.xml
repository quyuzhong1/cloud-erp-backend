<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.CfgRuleWaveMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.CfgRuleWaveEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="name" property="name" />
       <result column="wave_type" property="waveType" />
       <result column="priority" property="priority" />
       <result column="picking_cart_type_id" property="pickingCartTypeId" />
       <result column="min_order_qty" property="minOrderQty" />
       <result column="max_order_qty" property="maxOrderQty" />
       <result column="min_qty" property="minQty" />
       <result column="max_qty" property="maxQty" />
       <result column="disabled" property="disabled" />
       <result column="execution_time_json" property="executionTimeJson" />
       <result column="execution_type" property="executionType" />
       <result column="picking_type" property="pickingType" />
       <result column="remark" property="remark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        crw.id,
        crw.create_time as createTime,
        crw.update_time as updateTime ,
        crw.create_user_name as createUserName,
        crw.create_user_id as createUserId,
        crw.update_user_name as updateUserName,
        crw.update_user_id as updateUserId,
        crw.version,
        crw.is_deleted,
        crw.name, crw.wave_type as waveType, crw.priority, crw.picking_cart_type_id as pickingCartTypeId, crw.min_order_qty as minOrderQty, crw.max_order_qty as maxOrderQty, crw.min_qty as minQty, crw.max_qty as maxQty, crw.disabled, crw.execution_time_json, crw.execution_type as executionType, crw.picking_type as pickingType, crw.remark,
        pct.name as pickingCartTypeName
    </sql>

    <!-- 分页查询 -->
    <select id="paging" resultType="com.erp.model.wms.dto.CfgRuleWaveDTO$ListDTO">
        select
            <include refid="Base_Column_List" />
        from cfg_rule_wave crw
        left join picking_cart_type pct on crw.picking_cart_type_id = pct.id and pct.is_deleted = false
        <where>
            ${params.sqlMap.default}
            and crw.is_deleted = false
            <!--权限-->
            <if test="params.permissionSql!=null and params.permissionSql!=''">
                ${params.permissionSql}
            </if>
            ORDER BY
            <if test="params.sortList != null and params.sortList.size > 0">
                <foreach collection="params.sortList" item="item" separator="," close=",">
                    ${item.field} ${item.sort}
                </foreach>
            </if>
            crw.id desc
        </where>
    </select>

</mapper>
