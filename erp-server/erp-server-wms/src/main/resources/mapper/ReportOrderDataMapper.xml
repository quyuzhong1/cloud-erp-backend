<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.ReportOrderDataMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.ReportOrderDataEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="virtual_warehouse_id" property="virtualWarehouseId" />
       <result column="sku_id" property="skuId" />
       <result column="qty" property="qty" />
       <result column="approve_status" property="approveStatus" />
       <result column="status" property="status" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="source_id" property="sourceId" />
       <result column="source_detail_id" property="sourceDetailId" />
       <result column="source_code" property="sourceCode" />
       <result column="source_type" property="sourceType" />
       <result column="date" property="date" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        warehouse_id, virtual_warehouse_id, sku_id, qty, approve_status, status, invalid_status, source_id, source_detail_id, source_code, source_type, date,delivery_notice_qty,frozen_qty,order_qty
    </sql>

    <!-- 订单报表 -->
    <select id="listReportOrderData" resultType="com.erp.model.wms.entity.ReportOrderDataEntity">
            select
                <include refid="Base_Column_List" />
            from report_order_data rod
            <where>
                rod.is_deleted = false
            </where>
    </select>


</mapper>
