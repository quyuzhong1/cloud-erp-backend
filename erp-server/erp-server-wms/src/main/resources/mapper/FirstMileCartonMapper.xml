<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.FirstMileCartonMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.FirstMileCartonEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="main_id" property="mainId" />
       <result column="box_spec_no" property="boxSpecNo" />
       <result column="package_weight" property="packageWeight" />
       <result column="box_length" property="boxLength" />
       <result column="box_width" property="boxWidth" />
       <result column="box_height" property="boxHeight" />
       <result column="box_qty" property="boxQty" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        main_id, box_spec_no, package_weight, box_length, box_width, box_height, box_qty
    </sql>

    <!--查询已装箱数量-->
    <select id="listPackingQtyByMainIds" resultType="com.erp.model.wms.dto.FirstMileCartonDTO$PackingQtyDTO">
        SELECT
            fmc.main_id,
            SUM(fmc.box_qty) AS boxQty,
            fmcd.sku_id,
            fmcd.sku_no,
            SUM(fmcd.pack_qty) AS packQty
            SUM(fmc.box_qty) * SUM(fmcd.pack_qty) AS usePackQty
        FROM first_mile_carton fmc
        INNER JOIN first_mile_carton_detail fmcd ON fmc.id = fmcd.carton_id AND fmcd.is_deleted = FALSE
        WHERE fmc.is_deleted = FALSE
        <if test="mainIds != null and mainIds.size > 0">
            AND fmc.main_id IN
            <foreach collection="mainIds" item="mainId" open="(" separator="," close=")">
                #{mainId}
            </foreach>
        </if>
        GROUP BY fmc.main_id,
        fmcd.sku_id,
        fmcd.sku_no
    </select>
</mapper>
