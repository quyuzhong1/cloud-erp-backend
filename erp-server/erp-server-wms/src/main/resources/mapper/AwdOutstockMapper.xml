<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.AwdOutstockMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.AwdOutstockEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="shop_id" property="shopId" />
       <result column="shop_name" property="shopName" />
       <result column="bill_date" property="billDate" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, shop_id, shop_name, bill_date
    </sql>

    <select id="paging" resultType="com.erp.model.wms.dto.AwdOutstockDTO$ListDTO">
        SELECT
            ao.code as code,
            ao.shop_id as shopId,
            ao.shop_name as shopName,
            ao.fba_shipment_id as fbaShipmentId,
            ao.fba_shipment_code as fbaShipmentCode,
            aod.asin as asin,
            aod.msku as msku,
            aod.fnsku as fnsku,
            aod.sku_id as skuId,
            aod.sku_no as skuNo,
            aod.product_name as productName,
            aod.qty as qty,
            ao.update_user_id as updateUserId,
            ao.update_user_name as updateUserName,
            ao.update_time as updateTime,
            ao.bill_date as billDate
        FROM
            awd_outstock ao
            LEFT JOIN awd_outstock_detail aod ON aod.main_id = ao.ID
        WHERE 1 = 1
        <if test="params.sqlMap != null and params.sqlMap.default != null and params.sqlMap.default != ''">
            AND ${params.sqlMap.default}
        </if>
        <!--数据权限-->
        <if test="params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        fs.create_time DESC
    </select>

    <select id="listCount" resultType="com.common.business.dto.base.ApproveStatusQtyDTO">
        select approve_status, count(id) from awd_outstock where is_deleted = false group by approve_status
    </select>

    <select id="listExport" resultType="com.erp.model.wms.dto.AwdOutstockDTO$ListDTO">

    </select>
    <select id="tabList" resultType="com.erp.model.wms.dto.AwdOutstockDTO$TabListDTO">
        SELECT
        approve_status AS tabFlag,
        count(*)  AS count
        FROM  awd_outstock
        WHERE is_deleted=FALSE
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        GROUP BY approve_status
    </select>

</mapper>
