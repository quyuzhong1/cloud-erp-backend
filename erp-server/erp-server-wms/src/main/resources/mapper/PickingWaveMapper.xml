<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.erp.server.wms.mapper.PickingWaveMapper">
    <select id="listDeliveryIdByStatus" resultType="java.lang.String">
        select delivery_id
        from picking_wave as pw
                 left join picking_wave_detail as pwd on pw.id = pwd.main_id and is_delete = false
        where pw.status = #{status}
    </select>
    <select id="listDetailByMainId"
            resultType="com.erp.model.wms.dto.renovation.PickingWaveDTO$PickingWaveDetailDTO">



    </select>
</mapper>