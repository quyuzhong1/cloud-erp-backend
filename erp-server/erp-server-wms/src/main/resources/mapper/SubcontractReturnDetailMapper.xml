<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.SubcontractReturnDetailMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.SubcontractReturnDetailEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="parent_sku_id" property="parentSkuId" />
       <result column="parent_sku_no" property="parentSkuNo" />
       <result column="sku_id" property="skuId" />
       <result column="sku_no" property="skuNo" />
       <result column="bom_version" property="bomVersion" />
       <result column="quantity" property="quantity" />
       <result column="parent_sku_use_qty" property="parentSkuUseQty" />
       <result column="return_qty" property="returnQty" />
       <result column="warehouse_id" property="warehouseId" />
       <result column="warehouse_name" property="warehouseName" />
       <result column="remark" property="remark" />
       <result column="source_detail_id" property="sourceDetailId" />
       <result column="warehouse_location" property="warehouseLocation" />
       <result column="main_id" property="mainId" />
       <result column="kingdee_detail_id" property="kingdeeDetailId" />
       <result column="subcontract_order_detail_id" property="subcontractOrderDetailId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        parent_sku_id, parent_sku_no, sku_id, sku_no, bom_version, quantity, parent_sku_use_qty, return_qty, warehouse_id,
        warehouse_name, remark, source_detail_id, warehouse_location, main_id, kingdee_detail_id, subcontract_order_detail_id
    </sql>
    <select id="listBySubcontractOrderDetailIdList"
            resultType="com.erp.model.wms.entity.SubcontractReturnDetailEntity">
        select
        <include refid="Base_Column_List" />
        from subcontract_return_detail srd
        inner join subcontract_issue sr on sr.is_deleted = false and sr.id = srd.main_id
        <where>
            srd.is_deleted = false and sr.invalid_status = false
            <if test="subcontractOrderDetailIdList != null and subcontractOrderDetailIdList.size > 0">
                and srd.subcontract_order_detail_id in
                <foreach collection="subcontractOrderDetailIdList" open="(" close=")" separator="," item="item">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
    <!-- 根据来源明细id查询 -->
    <select id="listBySourceDetailIdList" resultType="com.erp.model.wms.entity.SubcontractReturnDetailEntity">
        select
        <include refid="Base_Column_List" />
        from subcontract_return_detail srd
        inner join subcontract_issue sr on sr.is_deleted = false and sr.id = srd.main_id
        <where>
            srd.is_deleted = false and sr.invalid_status = false
            <if test="sourceDetailIdList != null and sourceDetailIdList.size > 0">
                and srd.source_detail_id in
                <foreach collection="sourceDetailIdList" open="(" close=")" separator="," item="item">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
