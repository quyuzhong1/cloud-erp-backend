<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.OtherInstockMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.OtherInstockEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="code" property="code" />
        <result column="approve_status" property="approveStatus" />
        <result column="bill_date" property="billDate" />
        <result column="inventory_direction" property="inventoryDirection" />
        <result column="warehouse_keeper_id" property="warehouseKeeperId" />
        <result column="warehouse_keeper_name" property="warehouseKeeperName" />
        <result column="receiver_id" property="receiverId" />
        <result column="receiver_name" property="receiverName" />
        <result column="org_id" property="orgId" />
        <result column="org_name" property="orgName" />
        <result column="type" property="type" />
        <result column="invalid_status" property="invalidStatus" />
        <result column="invalid_remark" property="invalidRemark" />
        <result column="approve_time" property="approveTime" />
        <result column="approve_user_name" property="approveUserName" />
        <result column="approve_user_id" property="approveUserId" />
    </resultMap>

    <select id="paging" resultType="com.erp.model.wms.dto.OtherInstockDTO$ListDTO">
        select
            oi.id,
            oi.code,
            oi.inventory_direction as inventoryDirection,
            oi.approve_status as approveStatus,
            oi.invalid_status as invalidStatus,
            oid.sku_id as skuId,
            oid.sku_no as skuNo,
            oi.bill_date as billDate,
            oid.actual_qty as actualQty,
            oid.unit,
            oi.warehouse_name as warehouseName,
            oi.approve_user_name as approveUserName,
            oi.create_user_name as createUserName,
            oi.create_time as createTime
        from other_instock oi
        inner join other_instock_detail oid on oi.id = oid.main_id and oi.is_deleted = false
        <where>
            oi.is_deleted = false
            <if test="params.searchType != null and params.searchType != ''">
                AND oi.approve_status = #{params.searchType}
            </if>
            <if test="params.code != null and params.code != ''">
                and oi.code like concat('%',#{params.code},'%')
            </if>
            <if test="params.invalidStatus != null ">
                and oi.invalid_status = #{params.invalidStatus}
            </if>
            <if test="params.inventoryDirection != null ">
                and oi.inventory_direction = #{params.inventoryDirection}
            </if>
            <if test="params.skuNoList != null and params.skuNoList.size > 0">
                and oid.sku_no in
                <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and oi.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.warehouseIdList != null and params.warehouseIdList.size > 0">
                and oi.warehouse_id in
                <foreach collection="params.warehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createUserIdList != null and params.createUserIdList.size > 0">
                and oi.create_user_id in
                <foreach collection="params.createUserIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createTimeList != null and params.createTimeList.size > 0">
                and oi.create_time >= #{params.createTimeList[0]} and  (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > oi.create_time
            </if>
            <if test="params.billDateList != null and params.billDateList.size > 0">
                and oi.bill_date >= #{params.billDateList[0]} and  (#{params.billDateList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > oi.bill_date
            </if>
            <if test="params.param != null and params.param != ''">
                ${params.param}
            </if>
        </where>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        oi.create_time desc
    </select>

    <select id="listCount" resultType="java.lang.Integer">
        select
        count(distinct oi.id)
        from other_instock oi
        left join other_instock_detail oid on oi.id = oid.main_id and oid.is_deleted = false
        <where>
            oi.is_deleted = false
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and oi.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.param != null and params.param != ''">
                ${params.param}
            </if>
        </where>
    </select>

