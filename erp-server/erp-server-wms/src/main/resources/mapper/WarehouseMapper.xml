<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.WarehouseMapper">


    <select id="paging" resultType="com.erp.model.wms.dto.WarehouseDTO$PagingViewDTO">
      SELECT
         id,
         create_user_name AS createUserName,
         create_time AS createTime,
         name,
         type_id AS typeId ,
         charge_id AS chargeId,
         contacts,
         contact_tel_number AS contactTelNumber,
         disabled,
         address,
         org_id AS orgId,
         kingdee_warehouse_code AS kingdeeWarehouseCode,
         is_virtual AS isVirtual,
         approve_status AS approveStatus
      FROM  warehouse  WHERE is_deleted=false

        <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
            AND create_user_id IN
            <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                #{createUserId}
            </foreach>
        </if>
        <if test="params.address !=null  and params.address!=''">
           AND  address LIKE concat('%', #{params.address} ,'%')
        </if>
        <if test="params.name !=null  and params.name!=''">
            AND  name LIKE concat('%', #{params.name} ,'%')
        </if>
        <if test="params.contacts !=null  and params.contacts!=''">
            AND  contacts LIKE concat('%', #{params.contacts} ,'%')
        </if>
        <if test="params.typeIdList !=null and params.typeIdList.size>0">
            AND type_id IN
            <foreach collection="params.typeIdList" item="typeId" open="(" separator="," close=")">
                #{typeId}
            </foreach>
        </if>
        <if test="params.approveStatusList !=null and params.approveStatusList.size>0">
            AND approve_status IN
            <foreach collection="params.approveStatusList" item="approveStatus" open="(" separator="," close=")">
                #{approveStatus}
            </foreach>
        </if>
        <!--权限-->
        <if test="params.param!=null and params.param!=''">
            #{params.param}
        </if>

        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        create_time desc
    </select>

    <select id="getExport" resultType="com.erp.model.wms.dto.WarehouseDTO$PagingViewDTO">
         SELECT
         id,
         create_user_name,
         create_time,
         name,
         type_id,
         charge_id,
         contacts,
         contact_tel_number,
         disabled,
         address,
         org_id,
         kingdee_warehouse_code,
         is_virtual,
         approve_status
      FROM  warehouse  WHERE is_deleted=false
      <choose>
          <when test="params.ids!=null and params.ids.size>0">
              AND id IN
              <foreach collection="params.ids" item="id" open="(" separator="," close=")">
                  #{id}
              </foreach>
          </when>
          <otherwise>
              <if test="params.createUserIdList !=null and params.createUserIdList.size>0">
                  AND create_user_id IN
                  <foreach collection="params.createUserIdList" item="createUserId" open="(" separator="," close=")">
                      #{createUserId}
                  </foreach>
              </if>
              <if test="params.address !=null  and params.address!=''">
                  AND  address LIKE concat('%', #{params.address} ,'%')
              </if>
              <if test="params.name !=null  and params.name!=''">
                  AND  name LIKE concat('%', #{params.name} ,'%')
              </if>
              <if test="params.contacts !=null  and params.contacts!=''">
                  AND  contacts LIKE concat('%', #{params.contacts} ,'%')
              </if>
              <if test="params.typeIdList !=null and params.typeIdList.size>0">
                  AND type_id IN
                  <foreach collection="params.typeIdList" item="typeId" open="(" separator="," close=")">
                      #{typeId}
                  </foreach>
              </if>
              <if test="params.approveStatusList !=null and params.approveStatusList.size>0">
                  AND approve_status IN
                  <foreach collection="params.approveStatusList" item="approveStatus" open="(" separator="," close=")">
                      #{approveStatus}
                  </foreach>
              </if>
          </otherwise>
      </choose>

        <!--权限-->
        <if test="params.param!=null and params.param!=''">
            #{params.param}
        </if>



    </select>
</mapper>
