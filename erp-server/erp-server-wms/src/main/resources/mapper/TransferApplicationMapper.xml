<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.TransferApplicationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.TransferApplicationEntity">
        <result column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="create_user_name" property="createUserName" />
        <result column="create_user_id" property="createUserId" />
        <result column="update_user_name" property="updateUserName" />
        <result column="update_user_id" property="updateUserId" />
        <result column="version" property="version" />
        <result column="is_deleted" property="isDeleted" />
        <result column="code" property="code" />
        <result column="approve_status" property="approveStatus" />
        <result column="bill_date" property="billDate" />
        <result column="type" property="type" />
        <result column="in_warehouse_id" property="inWarehouseId" />
        <result column="in_warehouse_name" property="inWarehouseName" />
        <result column="out_warehouse_id" property="outWarehouseId" />
        <result column="out_warehouse_name" property="outWarehouseName" />
        <result column="in_org_id" property="inOrgId" />
        <result column="in_org_name" property="inOrgName" />
        <result column="out_org_id" property="outOrgId" />
        <result column="out_org_name" property="outOrgName" />
        <result column="apply_user_id" property="applyUserId" />
        <result column="apply_user_name" property="applyUserName" />
        <result column="apply_date" property="applyDate" />
        <result column="transfer_direction" property="transferDirection" />
        <result column="invalid_status" property="invalidStatus" />
        <result column="invalid_remark" property="invalidRemark" />
        <result column="approve_time" property="approveTime" />
        <result column="approve_user_name" property="approveUserName" />
        <result column="approve_user_id" property="approveUserId" />
        <result column="remark" property="remark" />
    </resultMap>

    <select id="paging" resultType="com.erp.model.wms.dto.TransferApplicationDTO$ListDTO">
        select
            ta.id,
            ta.code,
            ta.transfer_direction as transferDirection,
            ta.approve_status as approveStatus,
            ta.invalid_status as invalidStatus,
            tad.sku_id as skuId,
            tad.sku_no as skuNo,
            ta.bill_date as billDate,
            tad.qty,
            tad.unit,
            ta.in_warehouse_name as inWarehouseName,
            ta.out_warehouse_name as outWarehouseName,
            tad.remark,
            ta.apply_user_name as applyUserName,
            ta.approve_user_name as approveUserName,
            ta.create_user_name as createUserName,
            ta.create_time as createTime
        from transfer_application ta
        inner join transfer_application_detail tad on ta.id = tad.main_id and tad.is_deleted = false
        <where>
            ta.is_deleted = false
            <if test="params.code != null and params.code != ''">
                and ta.code like concat('%',#{params.code},'%')
            </if>
            <if test="params.invalidStatus != null ">
                and ta.invalid_status = #{params.invalidStatus}
            </if>
            <if test="params.transferDirection != null ">
                and ta.transfer_direction = #{params.transferDirection}
            </if>
            <if test="params.skuNoList != null and params.skuNoList.size > 0">
                and tad.sku_no in
                <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and ta.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.inWarehouseIdList != null and params.inWarehouseIdList.size > 0">
                and ta.in_warehouse_id in
                <foreach collection="params.inWarehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.outWarehouseIdList != null and params.outWarehouseIdList.size > 0">
                and ta.out_warehouse_id in
                <foreach collection="params.outWarehouseIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createUserIdList != null and params.createUserIdList.size > 0">
                and ta.create_user_id in
                <foreach collection="params.createUserIdList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.createTimeList != null and params.createTimeList.size > 0">
                and ta.create_time >= #{params.createTimeList[0]} and  (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > ta.create_time
            </if>
            <if test="params.billDateList != null and params.billDateList.size > 0">
                and ta.bill_date >= #{params.billDateList[0]} and  (#{params.billDateList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > ta.bill_date
            </if>
            <if test="params.param != null and params.param != ''">
                ${params.param}
            </if>
        </where>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ta.create_time desc
    </select>

    <select id="listCount" resultType="java.lang.Integer">
        select
        count(distinct ta.id)
        from transfer_application ta
        left join transfer_application_detail tad on ta.id = tad.main_id and tad.is_deleted = false
        <where>
            ta.is_deleted = false
            <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                and ta.approve_status in
                <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.param != null and params.param != ''">
                ${params.param}
            </if>
        </where>
    </select>

    <select id="listExportExcel" resultType="com.erp.model.wms.dto.TransferApplicationDTO$ListDTO">
        select
            ta.id,
            ta.code,
            ta.transfer_direction as transferDirection,
            ta.approve_status as approveStatus,
            ta.invalid_status as invalidStatus,
            tad.sku_id as skuId,
            tad.sku_no as skuNo,
            ta.bill_date as billDate,
            tad.qty,
            tad.unit,
            ta.in_warehouse_name as inWarehouseName,
            ta.out_warehouse_name as outWarehouseName,
            tad.remark,
            ta.apply_user_name as applyUserName,
            ta.approve_user_name as approveUserName,
            ta.create_user_name as createUserName,
            ta.create_time as createTime
        from transfer_application ta
        left join transfer_application_detail tad on ta.id = tad.main_id and tad.is_deleted = false
        <where>
            ta.is_deleted = false
            <if test="params.ids != null and params.ids.size > 0">
                and ta.id in
                <foreach collection="params.ids" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
            <if test="params.ids == null or params.ids.size == 0">
                <if test="params.code != null and params.code != ''">
                    and ta.code like concat('%',#{params.code},'%')
                </if>
                <if test="params.invalidStatus != null ">
                    and ta.invalid_status = #{params.invalidStatus}
                </if>
                <if test="params.transferDirection != null ">
                    and ta.transfer_direction = #{params.transferDirection}
                </if>
                <if test="params.skuNoList != null and params.skuNoList.size > 0">
                    and tad.sku_no in
                    <foreach collection="params.skuNoList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <if test="params.approveStatusList != null and params.approveStatusList.size > 0">
                    and ta.approve_status in
                    <foreach collection="params.approveStatusList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <if test="params.inWarehouseIdList != null and params.inWarehouseIdList.size > 0">
                    and ta.in_warehouse_id in
                    <foreach collection="params.inWarehouseIdList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <if test="params.outWarehouseIdList != null and params.outWarehouseIdList.size > 0">
                    and ta.out_warehouse_id in
                    <foreach collection="params.outWarehouseIdList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <if test="params.createUserIdList != null and params.createUserIdList.size > 0">
                    and ta.create_user_id in
                    <foreach collection="params.createUserIdList" item="item" open="(" close=")" separator=",">
                        #{item}
                    </foreach>
                </if>
                <if test="params.createTimeList != null and params.createTimeList.size > 0">
                    and ta.create_time >= #{params.createTimeList[0]} and  (#{params.createTimeList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > ta.create_time
                </if>
                <if test="params.billDateList != null and params.billDateList.size > 0">
                    and ta.bill_date >= #{params.billDateList[0]} and  (#{params.billDateList[1]}::TIMESTAMP + INTERVAL '1 DAY' ) > ta.bill_date
                </if>
                <if test="params.param != null and params.param != ''">
                    ${params.param}
                </if>
            </if>
        </where>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator="," close=",">
                ${item.field} ${item.sort}
            </foreach>
        </if>
        ta.create_time desc
    </select>

    <select id="viewGenerateTransferInfo"
            resultType="com.erp.model.wms.dto.TransferApplicationDTO$ViewGenerateTransferInfoDTO">
        select
            ta.code as sourceCode,
            pd.id as sourceId,
            pd.id as sourceDetailId,
            ta.transfer_direction as transferDirection,
            pd.sku_id as skuId,
            pd.sku_no as skuNo,
            pd.qty as qty,
            ta.bill_date as billDate,
            ta.out_warehouse_id as outWarehouseId,
            ta.out_warehouse_name as outWarehouseName,
            ta.in_warehouse_id as inWarehouseId,
            ta.in_warehouse_name as inWarehouseName,
            pd.warehouse_location as outWarehouseLocation
        from transfer_application ta
        inner join picking_detail pd on ta.id = pd.source_id and pd.is_deleted = false
        <where>
            ta.is_deleted = false and ta.id in
            <foreach collection="ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </where>
    </select>

    <select id="listTransferApplicationDrop" resultType="com.erp.model.wms.dto.TransferApplicationDTO$DropDTO">
        select
           ta.id,
           ta.code
        from transfer_application ta
        left join  transfer_application_detail tad on  ta.id = tad.main_id and tad.is_deleted = false
        left join transfer_info_detail tid on tad.id = tid.source_detail_id and  tid.is_deleted = false
        <where>
            ta.is_deleted = false and tid.id is null
            <if test="params.param != null and params.param != ''">
                ${params.param}
            </if>
        </where>
        group by ta.id ,ta.code
    </select>

</mapper>
