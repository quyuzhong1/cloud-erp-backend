<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.QcSamplingAqlRuleMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.QcSamplingAqlRuleEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="sample_qty_code" property="sampleQtyCode" />
       <result column="sample_qty" property="sampleQty" />
       <result column="aql_value" property="aqlValue" />
       <result column="accept_qty" property="acceptQty" />
       <result column="reject_qty" property="rejectQty" />
       <result column="disabled" property="disabled" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        sample_qty_code, sample_qty, aql_value, accept_qty, reject_qty, disabled
    </sql>

    <select id="selectByCodeAndAql" resultType="com.erp.model.wms.entity.QcSamplingAqlRuleEntity">
        SELECT * FROM qc_sampling_aql_rule WHERE is_deleted = false AND disabled =false  AND sample_qty_code = #{sampleCode} AND aql_value = #{aqlValue} LIMIT 1
    </select>

</mapper>
