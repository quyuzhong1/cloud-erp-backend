<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.RequisitionApplicationMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.RequisitionApplicationEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="source_id" property="sourceId" />
       <result column="source_code" property="sourceCode" />
       <result column="source_type" property="sourceType" />
       <result column="status" property="status" />
       <result column="invalid_status" property="invalidStatus" />
       <result column="invalid_remark" property="invalidRemark" />
       <result column="invalid_time" property="invalidTime" />
       <result column="type" property="type" />
       <result column="channel_id" property="channelId" />
       <result column="channel_name" property="channelName" />
       <result column="requisition_warehouse_id" property="requisitionWarehouseId" />
       <result column="requisition_warehouse_name" property="requisitionWarehouseName" />
       <result column="to_warehouse_id" property="toWarehouseId" />
       <result column="to_warehouse_name" property="toWarehouseName" />
       <result column="from_warehouse_id" property="fromWarehouseId" />
       <result column="from_warehouse_name" property="fromWarehouseName" />
       <result column="handle_user_id" property="handleUserId" />
       <result column="handle_user_name" property="handleUserName" />
       <result column="handle_time" property="handleTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, source_id, source_code, source_type, status, invalid_status, invalid_remark, invalid_time, type, channel_id, channel_name, requisition_warehouse_id, requisition_warehouse_name, to_warehouse_id, to_warehouse_name, from_warehouse_id, from_warehouse_name, handle_user_id, handle_user_name, handle_time
    </sql>

    <!--获取状态统计-->
    <select id="tabList" resultType="com.erp.model.wms.dto.RequisitionApplicationDTO$TabListDTO">
        SELECT
        status AS tabFlag,
        count(*)  AS count
        FROM  requisition_application
        WHERE is_deleted=FALSE
        GROUP BY status
    </select>
</mapper>
