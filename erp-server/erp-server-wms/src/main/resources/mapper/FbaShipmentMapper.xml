<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.FbaShipmentMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.FbaShipmentEntity">
       <result column="id" property="id" />
       <result column="create_time" property="createTime" />
       <result column="update_time" property="updateTime" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_user_id" property="createUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_user_id" property="updateUserId" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="code" property="code" />
       <result column="name" property="name" />
       <result column="shop_id" property="shopId" />
       <result column="shop_name" property="shopName" />
       <result column="country_id" property="countryId" />
       <result column="country_name" property="countryName" />
       <result column="fulfillment_center" property="fulfillmentCenter" />
       <result column="delivery_status" property="deliveryStatus" />
       <result column="platform_shipment_status" property="platformShipmentStatus" />
       <result column="shipment_create_time" property="shipmentCreateTime" />
       <result column="shipment_receive_time" property="shipmentReceiveTime" />
       <result column="label_type" property="labelType" />
       <result column="pack_type" property="packType" />
       <result column="delivery_from_address" property="deliveryFromAddress" />
       <result column="delivery_to_address" property="deliveryToAddress" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_time,
        update_time,
        create_user_name,
        create_user_id,
        update_user_name,
        update_user_id,
        version,
        is_deleted,
        code, name, shop_id, shop_name, country_id, country_name, fulfillment_center, delivery_status, platform_shipment_status, shipment_create_time, shipment_receive_time, label_type, pack_type, delivery_from_address, delivery_to_address
    </sql>


    <select id="paging" resultType="com.erp.model.wms.dto.FbaShipmentDTO$ListDTO">
        SELECT
            fs.id,
            fs.code,
            fs.shop_id,
            fs.shop_name,
            fs.country_id,
            fs.country_name,
            fs.fulfillment_center,
            fs.delivery_status,
            fs.platform_shipment_status,
            fs.shipment_create_time,
            fs.shipment_receive_time,
            fsd.asin,
            fsd.fn_sku,
            fsd.m_sku,
            fsd.sku_no,
            fsd.product_name,
            fsd.declare_qty,
            fsd.delivery_qty,
            fsd.diff_qty,
            fsd.is_combo
        FROM fba_shipment fs
        INNER JOIN fba_shipment_detail fsd ON fs.id = fsd.main_id AND fsd.is_deleted = FALSE
        WHERE fs.is_deleted = FALSE
    </select>
</mapper>
