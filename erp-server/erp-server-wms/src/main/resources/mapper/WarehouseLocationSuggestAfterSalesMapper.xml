    <select id="paging" resultType="com.erp.model.wms.entity.WarehouseLocationSuggestAfterSalesEntity">
        SELECT
        id,
        sku_id AS skuId,
        sku_no AS skuNo,
        warehouse_id AS warehouseId,
        warehouse_area_code AS warehouseAreaCode,
        suggest_warehouse_location_code AS suggestWarehouseLocationCode,
        priority,
        disabled,
        version,
        is_deleted AS isDeleted,
        create_user_id AS createUserId,
        create_user_name AS createUserName,
        create_time AS createTime,
        update_user_id AS updateUserId,
        update_user_name AS updateUserName,
        update_time AS updateTime
        FROM warehouse_location_suggest_aftersales
        WHERE is_deleted = false
        <if test="params.skuNo != null and params.skuNo != ''">
            AND sku_no LIKE CONCAT('%', #{params.skuNo}, '%')
        </if>
        <if test="params.warehouseId != null and params.warehouseId != ''">
            AND warehouse_id = #{params.warehouseId}
        </if>
        <if test="params.sqlMap.default != null and params.sqlMap.default != ''">
            AND ${params.sqlMap.default}
        </if>
        <if test="params != null and params.permissionSql != null and params.permissionSql != ''">
            ${params.permissionSql}
        </if>
        ORDER BY
        <if test="params.sortList != null and params.sortList.size > 0">
            <foreach collection="params.sortList" item="item" separator=",">
                ${item.field} ${item.sort}
            </foreach>
            ,
        </if>
        create_time DESC
    </select>


