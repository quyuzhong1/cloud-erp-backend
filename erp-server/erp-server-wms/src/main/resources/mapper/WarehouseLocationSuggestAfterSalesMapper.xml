    <insert id="upsertBatch">
        INSERT INTO warehouse_location_suggest_aftersales (
        id, sku_id, sku_no, warehouse_id, warehouse_area_code,
        suggest_warehouse_location_code, priority, disabled,
        version, is_deleted,
        create_user_id, create_user_name, create_time,
        update_user_id, update_user_name, update_time
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id}, #{item.skuId}, #{item.skuNo}, #{item.warehouseId}, #{item.warehouseAreaCode},
            #{item.suggestWarehouseLocationCode}, #{item.priority}, #{item.disabled},
            0, false,
            #{item.createUserId}, #{item.createUserName}, #{item.createTime},
            #{item.updateUserId}, #{item.updateUserName}, #{item.updateTime}
            )
        </foreach>
        ON CONFLICT (sku_no, warehouse_id, suggest_warehouse_location_code)
        WHERE is_deleted = false
        DO UPDATE SET
        priority = EXCLUDED.priority,
        disabled = EXCLUDED.disabled,
        warehouse_area_code = EXCLUDED.warehouse_area_code,
        version = warehouse_location_suggest_aftersales.version + 1,
        update_user_id = EXCLUDED.update_user_id,
        update_user_name = EXCLUDED.update_user_name,
        update_time = EXCLUDED.update_time -- 这里使用传入的最新时间
    </insert>


