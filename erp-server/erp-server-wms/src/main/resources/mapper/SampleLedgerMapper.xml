<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.SampleLedgerMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.erp.model.wms.entity.SampleLedgerEntity">
       <result column="id" property="id" />
       <result column="create_user_id" property="createUserId" />
       <result column="create_user_name" property="createUserName" />
       <result column="create_time" property="createTime" />
       <result column="update_user_id" property="updateUserId" />
       <result column="update_user_name" property="updateUserName" />
       <result column="update_time" property="updateTime" />
       <result column="version" property="version" />
       <result column="is_deleted" property="isDeleted" />
       <result column="user_id" property="userId" />
       <result column="user_name" property="userName" />
       <result column="dept_id" property="deptId" />
       <result column="dept_name" property="deptName" />
       <result column="sku_no" property="skuNo" />
       <result column="product_name" property="productName" />
       <result column="use_user_id" property="useUserId" />
       <result column="use_user_name" property="useUserName" />
       <result column="qty" property="qty" />
       <result column="sku_id" property="skuId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        create_user_id,
        create_user_name,
        create_time,
        update_user_id,
        update_user_name,
        update_time,
        version,
        is_deleted,
        user_id, user_name, dept_id, dept_name, sku_no, product_name, use_user_id, use_user_name, qty
    </sql>

    <sql id="listSku">
        SELECT
        sl.id as sampleLedgerId,
        sl.user_id AS userId,
        sl.user_name AS userName,
        sl.dept_id AS deptId,
        sl.dept_name AS deptName,
        sl.sku_id AS skuId,
        sl.sku_no AS skuNo,
        sl.product_name AS productName,
        sl.use_user_id AS useUserId,
        sl.use_user_name AS useUserName,
        <if test="params.type != null and params.type == 'scrap'">
            COALESCE(sl.qty, 0) - COALESCE(dd.freezeQty, 0) AS qty
        </if>
        <if test="params.type == null || params.type == ''">
            sl.qty  AS qty
        </if>
        FROM
        sample_ledger sl
        <if test="params.type != null and params.type == 'scrap'">
            left join (
            select
                ssd.sku_id , sum(ssd.scrap_qty) as freezeQty  from  sample_scrap_info ssi
            inner join sample_scrap_detail ssd on ssi.id = ssd.main_id and ssd.is_deleted = false
                where ssi.is_deleted = false
                  and ssi.approve_status !='approve'
            <if test="params.childId != null and params.childId != ''">
                and ssi.id != #{params.childId}
            </if>
                GROUP BY ssd.sku_id                                                                                                                                                                                                                                  ) as dd on dd.sku_id = sl.sku_id
        </if>
        WHERE
        sl.is_deleted = FALSE
        AND sl.user_id = #{ params.userId}
        <if test="params.skuNos != null and params.skuNos.size() > 1">
            and sl.sku_no in
            <foreach collection="params.skuNos" open="(" separator="," close=")" item="item">
                #{item}
            </foreach>
        </if>
        <if test="params.skuNo != null and params.skuNo != ''">
            and sl.sku_no ILIKE concat('%',#{params.skuNo}::text,'%')
        </if>
        order by sl.sku_no desc
    </sql>

    <select id="listSkuAvailableQtyByUserId" resultType="com.erp.model.wms.dto.SampleLedgerDTO$SkuAvailableQtyDTO">
        <include refid="listSku"/>
    </select>

    <select id="listSku" resultType="com.erp.model.wms.dto.SampleLedgerDTO$SkuAvailableQtyDTO">
        <include refid="listSku"/>
    </select>
</mapper>
