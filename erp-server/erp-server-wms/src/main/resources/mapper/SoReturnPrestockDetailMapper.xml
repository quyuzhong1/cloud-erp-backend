<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.server.wms.mapper.SoReturnPrestockDetailMapper">

    <!-- 根据主表 ID 列表查询详情行（含未软删除数据） -->
    <select id="listByMainIds"
            resultType="com.erp.model.wms.entity.SoReturnPrestockDetailEntity">
        SELECT *
        FROM so_return_prestock_detail
        WHERE is_deleted = FALSE
          AND main_id IN
        <foreach collection="mainIds" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
        ORDER BY create_time ASC
    </select>

</mapper>
